<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <!-- Relative to this file: packages restore into .packages\ next to the solution. -->
    <add key="globalPackagesFolder" value=".packages" />
  </config>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
