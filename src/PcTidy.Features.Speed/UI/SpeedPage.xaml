<UserControl
    x:Class="PcTidy.Features.Speed.UI.SpeedPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:PcTidy.UI.Controls;assembly=PcTidy.UI"
    AutomationProperties.Name="Speed"
    FontFamily="{StaticResource TidyText}">

    <Grid Margin="{StaticResource TidyPageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource PageTitle}" Text="Speed" />
                <c:BadgePill x:Name="RiskPill" Margin="12,6,0,0" />
            </StackPanel>
            <TextBlock
                Style="{StaticResource PageSubtitle}"
                Text="What starts with Windows, what's running, a few settings that really matter, and your drives. No RAM boosters, no registry cleaners: every change is shown first and can be undone." />
        </StackPanel>

        <c:Segmented
            x:Name="Tabs"
            Grid.Row="1"
            Margin="0,14,0,14"
            HorizontalAlignment="Left"
            Items="Startup|Running now|Settings|Drives|Right-click menu|What's locking"
            Label="Speed sections" />

        <ContentControl x:Name="TabHost" Grid.Row="2" Focusable="False" />
    </Grid>
</UserControl>
