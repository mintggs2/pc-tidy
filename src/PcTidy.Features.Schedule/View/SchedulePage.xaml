<UserControl
    x:Class="PcTidy.Features.Schedule.View.SchedulePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:PcTidy.UI.Controls;assembly=PcTidy.UI"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:v="clr-namespace:PcTidy.Features.Schedule.View"
    AutomationProperties.Name="Schedule and reports"
    FontFamily="{DynamicResource TidyText}">

    <ScrollViewer Focusable="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{DynamicResource TidyPageMargin}">

            <!--  Header  -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{DynamicResource PageTitle}" Text="Schedule &amp; reports" />
                        <c:BadgePill Margin="12,6,0,0" Text="Report only" Tone="Success" />
                    </StackPanel>
                    <TextBlock
                        Style="{DynamicResource PageSubtitle}"
                        Text="Regular scans that only look, a report after every run, and proof of what changed."
                        TextWrapping="Wrap" />
                </StackPanel>
                <WrapPanel Grid.Column="1" Margin="16,6,0,0" VerticalAlignment="Top">
                    <ui:Button
                        x:Name="ScanNowButton"
                        Margin="0,0,8,0"
                        Appearance="Secondary"
                        AutomationProperties.Name="Scan now and write a report. Nothing is changed."
                        Click="OnScanNow"
                        Content="Scan now"
                        Icon="{ui:SymbolIcon ScanDash24}"
                        ToolTip="Runs the same report-only scan as the schedule. Nothing is changed." />
                    <ui:Button
                        x:Name="CheckupNowButton"
                        Appearance="Secondary"
                        AutomationProperties.Name="Run a checkup now: scan, tweak check and disk health. Nothing is changed."
                        Click="OnCheckupNow"
                        Content="Checkup now"
                        Icon="{ui:SymbolIcon CalendarClock24}"
                        ToolTip="Scan, tweak check and disk health. Nothing is changed." />
                </WrapPanel>
            </Grid>

            <ui:InfoBar
                x:Name="Notice"
                Margin="0,16,0,0"
                IsClosable="True"
                IsOpen="False"
                Severity="Informational" />
            <StackPanel x:Name="NoticeActions" Margin="0,6,0,0" Orientation="Horizontal" Visibility="Collapsed" />

            <!--  Scanning  -->
            <Border x:Name="ScanningCard" Margin="0,16,0,0" Style="{DynamicResource TidyCard}" Visibility="Collapsed">
                <DockPanel>
                    <ui:ProgressRing Width="32" Height="32" Margin="0,0,16,0" IsIndeterminate="True" />
                    <ui:Button
                        VerticalAlignment="Center"
                        Appearance="Secondary"
                        AutomationProperties.Name="Stop the scan"
                        Click="OnStopScan"
                        Content="Stop"
                        DockPanel.Dock="Right"
                        Icon="{ui:SymbolIcon Dismiss24}" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="ScanningTitle" Style="{DynamicResource SectionTitle}" Text="Scanning…" />
                        <TextBlock Style="{DynamicResource Caption}" Text="Every section looks in Quick mode. Nothing is changed." TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!--  Schedules  -->
            <Border Margin="0,16,0,0" Style="{DynamicResource TidyCard}">
                <StackPanel>
                    <TextBlock Style="{DynamicResource CardTitle}" Text="Schedules" />
                    <TextBlock
                        Margin="0,2,0,12"
                        Style="{DynamicResource Secondary}"
                        Text="They only look and write a report, then let you know if there's something worth a look. They never change anything."
                        TextWrapping="Wrap" />
                    <Grid x:Name="ScheduleRows">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ui:ToggleSwitch
                            x:Name="WeeklyToggle"
                            MinWidth="190"
                            Margin="0,0,16,10"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Weekly scan"
                            Checked="OnScheduleEdited"
                            Content="Weekly scan"
                            Unchecked="OnScheduleEdited" />
                        <ComboBox
                            x:Name="WeeklyDay"
                            Grid.Column="1"
                            MinWidth="140"
                            Margin="0,0,8,10"
                            AutomationProperties.Name="Day of the weekly scan"
                            SelectionChanged="OnScheduleSelection" />
                        <ComboBox
                            x:Name="WeeklyTime"
                            Grid.Column="2"
                            MinWidth="110"
                            Margin="0,0,16,10"
                            AutomationProperties.Name="Time of the weekly scan"
                            SelectionChanged="OnScheduleSelection" />
                        <TextBlock
                            x:Name="WeeklyState"
                            Grid.Column="3"
                            Margin="0,0,0,10"
                            VerticalAlignment="Center"
                            Style="{DynamicResource Caption}"
                            TextWrapping="Wrap" />

                        <ui:ToggleSwitch
                            x:Name="MonthlyToggle"
                            Grid.Row="1"
                            MinWidth="190"
                            Margin="0,0,16,0"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Monthly checkup"
                            Checked="OnScheduleEdited"
                            Content="Monthly checkup"
                            Unchecked="OnScheduleEdited" />
                        <ComboBox
                            x:Name="MonthlyDay"
                            Grid.Row="1"
                            Grid.Column="1"
                            MinWidth="140"
                            Margin="0,0,8,0"
                            AutomationProperties.Name="Day of the month for the checkup"
                            SelectionChanged="OnScheduleSelection" />
                        <ComboBox
                            x:Name="MonthlyTime"
                            Grid.Row="1"
                            Grid.Column="2"
                            MinWidth="110"
                            Margin="0,0,16,0"
                            AutomationProperties.Name="Time of the monthly checkup"
                            SelectionChanged="OnScheduleSelection" />
                        <TextBlock
                            x:Name="MonthlyState"
                            Grid.Row="1"
                            Grid.Column="3"
                            VerticalAlignment="Center"
                            Style="{DynamicResource Caption}"
                            TextWrapping="Wrap" />
                    </Grid>
                    <TextBlock
                        Margin="0,10,0,0"
                        Style="{DynamicResource Caption}"
                        Text="The checkup is a Quick scan plus a tweak check and a disk health reading, so you can see what built up over the month."
                        TextWrapping="Wrap" />
                    <StackPanel Margin="0,14,0,0" Orientation="Horizontal">
                        <ui:Button
                            x:Name="ApplyScheduleButton"
                            Appearance="Primary"
                            AutomationProperties.Name="Save the schedule in Windows"
                            Click="OnApplySchedule"
                            Content="Save schedule"
                            IsEnabled="False"
                            Icon="{ui:SymbolIcon Checkmark24}" />
                        <TextBlock
                            x:Name="ScheduleHint"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Style="{DynamicResource Caption}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  Last scan + tweak check  -->
            <Border Margin="0,16,0,0" Style="{DynamicResource TidyCard}">
                <StackPanel>
                    <TextBlock Style="{DynamicResource CardTitle}" Text="Last scan and tweak check" />
                    <TextBlock x:Name="LastScanText" Margin="0,2,0,0" Style="{DynamicResource Secondary}" TextWrapping="Wrap" />
                    <TextBlock x:Name="DriftText" Margin="0,10,0,0" Style="{DynamicResource Body}" TextWrapping="Wrap" />
                    <StackPanel x:Name="DriftList" Margin="0,6,0,0" />
                    <WrapPanel Margin="0,12,0,0">
                        <ui:Button
                            x:Name="CheckDriftButton"
                            Margin="0,0,8,0"
                            Appearance="Secondary"
                            AutomationProperties.Name="Check whether your tweaks are still in place"
                            Click="OnCheckDrift"
                            Content="Check tweaks now"
                            Icon="{ui:SymbolIcon ArrowSync24}" />
                        <ui:Button
                            x:Name="OpenTweaksButton"
                            Appearance="Secondary"
                            AutomationProperties.Name="Re-apply: open the Tweaks section"
                            Click="OnOpenTweaks"
                            Content="Re-apply in Tweaks"
                            Icon="{ui:SymbolIcon Wrench24}"
                            Visibility="Collapsed" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <c:ResponsiveGrid Margin="0,16,0,0" MaxColumns="2" MinItemWidth="420">
                <!--  Before / after history  -->
                <Border Style="{DynamicResource TidyCard}">
                    <StackPanel>
                        <DockPanel>
                            <ComboBox
                                x:Name="MetricPicker"
                                MinWidth="170"
                                AutomationProperties.Name="Which number the graph shows"
                                DockPanel.Dock="Right"
                                SelectionChanged="OnMetricChanged" />
                            <TextBlock VerticalAlignment="Center" Style="{DynamicResource CardTitle}" Text="Before and after" />
                        </DockPanel>
                        <v:HistoryGraph
                            x:Name="Graph"
                            Height="180"
                            Margin="0,12,0,0"
                            AxisBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BackgroundBrush="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            LineBrush="{DynamicResource TidyAccentBrush}"
                            TextBrush="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock
                            x:Name="GraphNote"
                            Margin="0,12,0,0"
                            Style="{DynamicResource Body}"
                            TextWrapping="Wrap"
                            Visibility="Collapsed" />
                        <TextBlock
                            x:Name="GraphLegend"
                            Margin="0,8,0,0"
                            Style="{DynamicResource Caption}"
                            Text="○ before a run   ● after a run   · daily reading"
                            TextWrapping="Wrap" />
                        <TextBlock x:Name="LastChangeText" Margin="0,6,0,0" Style="{DynamicResource Secondary}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!--  Disk health  -->
                <Border Style="{DynamicResource TidyCard}">
                    <StackPanel>
                        <DockPanel>
                            <ui:Button
                                x:Name="ReadDisksButton"
                                Appearance="Secondary"
                                AutomationProperties.Name="Read disk health now"
                                Click="OnReadDisks"
                                Content="Read now"
                                DockPanel.Dock="Right"
                                Icon="{ui:SymbolIcon ArrowClockwise24}" />
                            <TextBlock VerticalAlignment="Center" Style="{DynamicResource CardTitle}" Text="Disk health" />
                        </DockPanel>
                        <StackPanel x:Name="DiskWarnings" Margin="0,8,0,0" />
                        <StackPanel x:Name="DiskList" Margin="0,8,0,0" />
                        <TextBlock
                            x:Name="DiskNote"
                            Margin="0,8,0,0"
                            Style="{DynamicResource Caption}"
                            Text="One reading a day from Windows' own disk status. Temperature and wear show only where Windows can read them."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </c:ResponsiveGrid>

            <!--  Reports  -->
            <Border Margin="0,16,0,0" Style="{DynamicResource TidyCard}">
                <StackPanel>
                    <DockPanel>
                        <ui:Button
                            x:Name="OpenReportsFolderButton"
                            Appearance="Secondary"
                            AutomationProperties.Name="Show the reports folder in Explorer"
                            Click="OnOpenReportsFolder"
                            Content="Show folder"
                            DockPanel.Dock="Right"
                            Icon="{ui:SymbolIcon FolderOpen24}" />
                        <TextBlock VerticalAlignment="Center" Style="{DynamicResource CardTitle}" Text="Reports" />
                    </DockPanel>
                    <TextBlock
                        Margin="0,2,0,8"
                        Style="{DynamicResource Secondary}"
                        Text="A summary is saved after every run and every scheduled scan, in PC Tidy's own data folder."
                        TextWrapping="Wrap" />
                    <StackPanel x:Name="ReportList" />
                    <TextBlock x:Name="NoReportsText" Style="{DynamicResource Caption}" Text="No reports yet." Visibility="Collapsed" />

                    <Separator Margin="0,14,0,10" />
                    <CheckBox
                        x:Name="HtmlToggle"
                        Margin="0,0,0,6"
                        AutomationProperties.Name="Also save an HTML copy of each report"
                        Checked="OnReportOptionChanged"
                        Content="Also save an HTML copy of each report"
                        Unchecked="OnReportOptionChanged" />
                    <CheckBox
                        x:Name="CopyToggle"
                        AutomationProperties.Name="Also copy each run report into a folder I pick"
                        Checked="OnReportOptionChanged"
                        Content="Also copy each run report into a folder I pick (for example a notes vault)"
                        Unchecked="OnReportOptionChanged" />
                    <WrapPanel Margin="28,6,0,0">
                        <ui:Button
                            x:Name="PickFolderButton"
                            Margin="0,0,8,6"
                            Appearance="Secondary"
                            AutomationProperties.Name="Pick the folder for report copies"
                            Click="OnPickFolder"
                            Content="Pick folder…"
                            Icon="{ui:SymbolIcon Folder24}" />
                        <ui:Button
                            x:Name="CopyLatestButton"
                            Margin="0,0,12,6"
                            Appearance="Secondary"
                            AutomationProperties.Name="Copy the latest report into the folder now"
                            Click="OnCopyLatest"
                            Content="Copy latest now"
                            Icon="{ui:SymbolIcon DocumentCopy24}" />
                        <TextBlock x:Name="CopyFolderText" VerticalAlignment="Center" Style="{DynamicResource Caption}" TextWrapping="Wrap" />
                    </WrapPanel>
                    <TextBlock
                        Margin="28,0,0,0"
                        Style="{DynamicResource Caption}"
                        Text="Copies are new files only. PC Tidy never overwrites a file it didn't write, and each copy can be undone from History."
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
