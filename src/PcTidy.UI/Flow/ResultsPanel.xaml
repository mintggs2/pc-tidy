<UserControl
    x:Class="PcTidy.UI.Flow.ResultsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:PcTidy.UI.Controls"
    xmlns:flow="clr-namespace:PcTidy.UI.Flow"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis" />

        <DataTemplate DataType="{x:Type flow:SectionRow}">
            <DockPanel Margin="2,14,6,8">
                <Border Width="30" Height="30" Margin="0,0,10,0" CornerRadius="7" Background="{DynamicResource TidyAccentSoftBrush}">
                    <ui:SymbolIcon FontSize="16" Foreground="{DynamicResource TidyAccentBrush}" Symbol="{Binding Icon}" />
                </Border>
                <TextBlock VerticalAlignment="Center" DockPanel.Dock="Right" Style="{StaticResource Caption}" Text="{Binding Summary}" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="16" Style="{StaticResource SectionTitle}" Text="{Binding Title}" />
                    <TextBlock Style="{StaticResource Caption}" Text="{Binding Note}" Visibility="{Binding HasNote, Converter={StaticResource BoolVis}}" />
                </StackPanel>
            </DockPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type flow:GroupRow}">
            <Border
                Margin="{Binding BottomMargin}"
                Padding="16,10,8,10"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="{Binding CardBorder}"
                CornerRadius="{Binding CardRadius}"
                MouseLeftButtonUp="OnGroupHeaderClick">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="124" />
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="84" />
                        <ColumnDefinition Width="36" />
                    </Grid.ColumnDefinitions>
                    <CheckBox
                        x:Name="GroupCheck"
                        MinWidth="0"
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{Binding Title, StringFormat='Tick all in {0}'}"
                        Focusable="False"
                        IsChecked="{Binding IsChecked, Mode=TwoWay}"
                        IsEnabled="{Binding HasSelectable}" />
                    <Border Grid.Column="1" Width="34" Height="34" VerticalAlignment="Center" Style="{StaticResource IconTile}">
                        <ui:SymbolIcon FontSize="18" Foreground="{DynamicResource TidyAccentBrush}" Symbol="{Binding Icon}" />
                    </Border>
                    <StackPanel Grid.Column="2" Margin="12,0,12,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource CardTitle}" Text="{Binding Title}" />
                            <TextBlock Margin="8,1,0,0" VerticalAlignment="Center" Style="{StaticResource Caption}" Text="{Binding CountText}" />
                        </StackPanel>
                        <TextBlock Margin="0,1,0,0" Style="{StaticResource SecondaryTrim}" Text="{Binding Description}" />
                    </StackPanel>
                    <c:BadgePill x:Name="GroupPill" Grid.Column="3" Badge="{Binding Badge}" />
                    <ui:SymbolIcon
                        Grid.Column="4"
                        AutomationProperties.Name="Needs admin: Windows asks once for the whole run"
                        FontSize="16"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Symbol="Shield24"
                        ToolTip="Needs admin. Windows asks once for the whole run."
                        Visibility="{Binding NeedsAdmin, Converter={StaticResource BoolVis}}" />
                    <c:SizeText Grid.Column="5" Bytes="{Binding TotalBytes}" ZeroText="" />
                    <ui:Button
                        Grid.Column="6"
                        Width="30"
                        Height="30"
                        Padding="0"
                        HorizontalAlignment="Right"
                        Appearance="Transparent"
                        AutomationProperties.Name="Show or hide items"
                        Click="OnToggleGroup"
                        Focusable="False">
                        <ui:SymbolIcon x:Name="Chevron" FontSize="14" Symbol="ChevronDown24" />
                    </ui:Button>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                    <Setter TargetName="Chevron" Property="Symbol" Value="ChevronUp24" />
                </DataTrigger>
                <!--  Nothing pickable: a safety badge would contradict the greyed rows inside  -->
                <DataTrigger Binding="{Binding IsInfoOnly}" Value="True">
                    <Setter TargetName="GroupPill" Property="Badge" Value="{x:Null}" />
                    <Setter TargetName="GroupPill" Property="Text" Value="Info only" />
                    <Setter TargetName="GroupPill" Property="Tone" Value="Neutral" />
                    <!--  …and no tick box that looks like it could be ticked  -->
                    <Setter TargetName="GroupCheck" Property="Visibility" Value="Hidden" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate DataType="{x:Type flow:ItemRow}">
            <Border
                Margin="{Binding BottomMargin}"
                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="{Binding CardBorder}"
                CornerRadius="{Binding CardRadius}">
                <Grid x:Name="RowGrid" Margin="16,9,8,9">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="124" />
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="84" />
                        <ColumnDefinition Width="36" />
                    </Grid.ColumnDefinitions>
                    <CheckBox
                        MinWidth="0"
                        Margin="44,0,6,0"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{Binding Item.Title}"
                        Focusable="False"
                        IsChecked="{Binding IsChecked, Mode=TwoWay}"
                        IsEnabled="{Binding IsSelectable}" />
                    <StackPanel Grid.Column="1" Margin="4,0,12,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontWeight="Normal" Style="{StaticResource CardTitle}" Text="{Binding Item.Title}" />
                            <!--  A plain fact ("Never played") is secondary text; only "Close X first" is amber (trigger below)  -->
                            <TextBlock
                                x:Name="NoteText"
                                Margin="10,1,0,0"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{Binding Note}" />
                        </StackPanel>
                        <!--  Up to two lines (v3 reasons are longer and the second half matters); the whole text is in the tooltip.  -->
                        <TextBlock
                            x:Name="Why"
                            MaxHeight="36"
                            Margin="0,1,0,0"
                            AutomationProperties.HelpText="{Binding SecondLine}"
                            Style="{StaticResource SecondaryTrim}"
                            Text="{Binding SecondLine}"
                            TextWrapping="Wrap"
                            ToolTip="{Binding SecondLine}" />
                    </StackPanel>
                    <c:BadgePill x:Name="ItemPill" Grid.Column="2" Badge="{Binding Item.Badge}" />
                    <ui:SymbolIcon
                        Grid.Column="3"
                        AutomationProperties.Name="Needs admin: Windows asks once for the whole run"
                        FontSize="16"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Symbol="Shield24"
                        ToolTip="Needs admin. Windows asks once for the whole run."
                        Visibility="{Binding Item.NeedsAdmin, Converter={StaticResource BoolVis}}" />
                    <c:SizeText Grid.Column="4" FontWeight="Normal" Bytes="{Binding Item.SizeBytes}" ZeroText="" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding NoteIsBlocker}" Value="True">
                    <Setter TargetName="NoteText" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
                <!--  DisabledReason: greyed, un-tickable, the reason instead of "why it's safe", and no safety badge  -->
                <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                    <Setter TargetName="RowGrid" Property="Opacity" Value="0.6" />
                    <Setter TargetName="ItemPill" Property="Badge" Value="{x:Null}" />
                    <Setter TargetName="ItemPill" Property="Text" Value="Not offered" />
                    <Setter TargetName="ItemPill" Property="Tone" Value="Neutral" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <!--  ===== 3.2 Workbench layout (GroupsAndDetails = true): groups on the left, the picked group's rows on the right =====  -->
        <DataTemplate x:Key="WbGroup" DataType="{x:Type flow:GroupRow}">
            <Grid x:Name="Row" MinHeight="44" Margin="4,0,6,0" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox
                    x:Name="GroupCheck"
                    MinWidth="0"
                    Margin="6,0,4,0"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{Binding Title, StringFormat='Tick all in {0}'}"
                    Focusable="False"
                    IsChecked="{Binding IsChecked, Mode=TwoWay}"
                    IsEnabled="{Binding HasSelectable}" />
                <!--  The risk dot; "Can't be undone" groups also say it in words (column 3)  -->
                <Ellipse x:Name="Dot" Grid.Column="1" Width="8" Height="8" Margin="4,0,10,0" VerticalAlignment="Center" Fill="{DynamicResource TidyAccentBrush}" ToolTip="Safe: rebuilt automatically or clearly safe" />
                <StackPanel Grid.Column="2" Margin="0,6,8,6" VerticalAlignment="Center">
                    <TextBlock MaxHeight="38" FontSize="13.5" Text="{Binding Title}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" ToolTip="{Binding Title}" />
                    <TextBlock Style="{StaticResource Caption}" Text="{Binding CountText}" />
                </StackPanel>
                <TextBlock
                    x:Name="PermanentText"
                    Grid.Column="3"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                    Text="Can't be undone"
                    Visibility="Collapsed" />
                <c:SizeText Grid.Column="4" MinWidth="64" Bytes="{Binding TotalBytes}" ZeroText="" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Badge}" Value="Check">
                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
                    <Setter TargetName="Dot" Property="ToolTip" Value="Check first: your call, not ticked by default" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Badge}" Value="Permanent">
                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                    <Setter TargetName="Dot" Property="ToolTip" Value="Can't be undone: asks again with its own tick" />
                    <Setter TargetName="PermanentText" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <!--  Details open (narrow groups column): the words give way to the name; the dot, its tooltip and the
                     right pane's "Can't be undone" pill still say it  -->
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="narrow">
                    <Setter TargetName="PermanentText" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsInfoOnly}" Value="True">
                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                    <Setter TargetName="Dot" Property="ToolTip" Value="Information only: nothing here changes" />
                    <Setter TargetName="GroupCheck" Property="Visibility" Value="Hidden" />
                    <Setter TargetName="PermanentText" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="WbItem" DataType="{x:Type flow:ItemRow}">
            <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                <Grid x:Name="RowGrid" Margin="8,7,8,7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="76" />
                    </Grid.ColumnDefinitions>
                    <CheckBox
                        MinWidth="0"
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{Binding Item.Title}"
                        Focusable="False"
                        IsChecked="{Binding IsChecked, Mode=TwoWay}"
                        IsEnabled="{Binding IsSelectable}" />
                    <StackPanel Grid.Column="1" Margin="4,0,12,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="13.5" Text="{Binding Item.Title}" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="NoteText" Margin="10,1,0,0" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Note}" />
                        </StackPanel>
                        <TextBlock x:Name="Why" Style="{StaticResource SecondaryTrim}" Text="{Binding SecondLine}" ToolTip="{Binding SecondLine}" />
                    </StackPanel>
                    <c:BadgePill x:Name="ItemPill" Grid.Column="2" Badge="{Binding Item.Badge}" />
                    <ui:SymbolIcon
                        Grid.Column="3"
                        AutomationProperties.Name="Needs admin: Windows asks once for the whole run"
                        FontSize="16"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Symbol="Shield24"
                        ToolTip="Needs admin. Windows asks once for the whole run."
                        Visibility="{Binding Item.NeedsAdmin, Converter={StaticResource BoolVis}}" />
                    <c:SizeText Grid.Column="4" FontWeight="Normal" Bytes="{Binding Item.SizeBytes}" ZeroText="" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding NoteIsBlocker}" Value="True">
                    <Setter TargetName="NoteText" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                    <Setter TargetName="RowGrid" Property="Opacity" Value="0.6" />
                    <Setter TargetName="ItemPill" Property="Badge" Value="{x:Null}" />
                    <Setter TargetName="ItemPill" Property="Text" Value="Not offered" />
                    <Setter TargetName="ItemPill" Property="Tone" Value="Neutral" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="WbSection" DataType="{x:Type flow:SectionRow}">
            <StackPanel Margin="10,12,8,4" Orientation="Vertical">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Margin="0,0,8,0" FontSize="16" Foreground="{DynamicResource TidyAccentBrush}" Symbol="{Binding Icon}" />
                    <TextBlock FontSize="14" FontWeight="SemiBold" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Margin="24,2,0,0" Style="{StaticResource Caption}" Text="{Binding Summary}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Summary}" />
            </StackPanel>
        </DataTemplate>

        <!--  Workbench rows: the selection fill sits BEHIND the row (the old list's cards paint their own background, so it
             draws on top there), so a selected row reads brighter, not dimmer  -->
        <Style x:Key="WbRowContainer" BasedOn="{StaticResource TidyRowContainer}" TargetType="ListBoxItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="Sel" Background="Transparent" CornerRadius="6" />
                            <Border x:Name="Bar" Width="3" Height="18" Margin="0,0,0,0" HorizontalAlignment="Left" Background="{DynamicResource TidyAccentBrush}" CornerRadius="1.5" Visibility="Hidden" />
                            <ContentPresenter />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Sel" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Sel" Property="Background" Value="{DynamicResource TidyNavSelectedBrush}" />
                                <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <flow:WorkbenchRowTemplates x:Key="WbTemplates" Group="{StaticResource WbGroup}" Item="{StaticResource WbItem}" Section="{StaticResource WbSection}" />
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Row checkboxes aren't Tab stops (one Tab into the list, then arrows): say how to tick from the keyboard  -->
        <TextBlock
            x:Name="KeyboardHint"
            Grid.Row="1"
            Margin="2,6,0,0"
            Style="{StaticResource Caption}"
            Text="Keyboard: arrows move · Space ticks or unticks · Enter opens a group · Left closes it" />

        <ListBox
            x:Name="List"
            Padding="0,0,6,0"
            AutomationProperties.HelpText="Arrow keys move between rows. Space ticks or unticks. Enter opens or closes a group."
            AutomationProperties.Name="Scan results"
            PreviewKeyDown="OnListKeyDown"
            SelectionChanged="OnSelectionChanged"
            SelectionMode="Single"
            Style="{StaticResource TidyFlatList}" />

        <!--  ===== 3.2 Workbench: groups | the picked group's rows (DetailsPanel joins as a third column) =====  -->
        <Grid x:Name="WbGrid" Grid.RowSpan="2" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <!--  First-run hint (once; the page remembers "Got it")  -->
            <Border
                x:Name="WbHint"
                Grid.ColumnSpan="2"
                Margin="0,0,0,10"
                Padding="14,8,10,8"
                Background="{DynamicResource TidyAccentSoftBrush}"
                BorderBrush="{DynamicResource TidyAccentStrokeBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="Collapsed">
                <DockPanel>
                    <ui:Button x:Name="WbHintOk" Margin="12,0,0,0" Click="OnHintOk" Content="Got it" DockPanel.Dock="Right" />
                    <ui:SymbolIcon Margin="0,0,10,0" FontSize="18" Foreground="{DynamicResource TidyAccentBrush}" Symbol="Lightbulb24" />
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource Body}" TextWrapping="Wrap"
                               Text="Tick groups on the left. The rows in the picked group are on the right; pick a row to see its details. Nothing changes until you confirm, and the dots mean Safe, Check first and Can't be undone." />
                </DockPanel>
            </Border>
            <Border Grid.Row="1" Padding="0,6,0,6" Style="{StaticResource TidyCard}">
                <DockPanel>
                    <!--  What the dots mean (also in each dot's tooltip)  -->
                    <WrapPanel x:Name="Legend" Margin="12,8,8,4" AutomationProperties.Name="Dots: green is Safe, amber is Check first, red is Can't be undone" DockPanel.Dock="Bottom">
                        <StackPanel Margin="0,0,14,0" Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Margin="0,0,6,0" Fill="{DynamicResource TidyAccentBrush}" />
                            <TextBlock Style="{StaticResource Caption}" Text="Safe" />
                        </StackPanel>
                        <StackPanel Margin="0,0,14,0" Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Margin="0,0,6,0" Fill="{DynamicResource SystemFillColorCautionBrush}" />
                            <TextBlock Style="{StaticResource Caption}" Text="Check first" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Margin="0,0,6,0" Fill="{DynamicResource SystemFillColorCriticalBrush}" />
                            <TextBlock Style="{StaticResource Caption}" Text="Can't be undone" />
                        </StackPanel>
                    </WrapPanel>
                    <ListBox
                        x:Name="GroupsList"
                        AutomationProperties.HelpText="Arrow keys move between groups. Space ticks or unticks a group. Right arrow or Enter goes to its rows."
                        AutomationProperties.Name="Groups"
                        ItemContainerStyle="{StaticResource WbRowContainer}"
                        ItemTemplateSelector="{StaticResource WbTemplates}"
                        PreviewKeyDown="OnGroupsKeyDown"
                        SelectionChanged="OnGroupPicked"
                        SelectionMode="Single"
                        Style="{StaticResource TidyFlatList}" />
                </DockPanel>
            </Border>
            <Border Grid.Row="1" Grid.Column="1" Margin="12,0,0,0" Padding="16,12,10,8" Style="{StaticResource TidyCard}">
                <Grid>
                    <DockPanel x:Name="GroupPane">
                        <StackPanel Margin="0,0,0,8" DockPanel.Dock="Top">
                            <DockPanel>
                                <c:SizeText x:Name="GroupSize" DockPanel.Dock="Right" FontWeight="SemiBold" ZeroText="" />
                                <c:BadgePill x:Name="GroupPill" Margin="10,0,10,0" DockPanel.Dock="Right" />
                                <TextBlock x:Name="GroupTitle" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                            <TextBlock x:Name="GroupWhy" Margin="0,4,0,0" Style="{StaticResource Secondary}" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock x:Name="GroupEmpty" Margin="0,24,0,0" HorizontalAlignment="Center" DockPanel.Dock="Top" Style="{StaticResource Secondary}" Text="Nothing to do here right now." Visibility="Collapsed" />
                        <ListBox
                            x:Name="ItemsList"
                            AutomationProperties.HelpText="Arrow keys move. Space ticks or unticks. Left arrow goes back to the groups."
                            AutomationProperties.Name="Rows in this group"
                            ItemContainerStyle="{StaticResource WbRowContainer}"
                            ItemTemplateSelector="{StaticResource WbTemplates}"
                            PreviewKeyDown="OnItemsKeyDown"
                            SelectionChanged="OnItemPicked"
                            SelectionMode="Single"
                            Style="{StaticResource TidyFlatList}" />
                    </DockPanel>
                    <!--  Empty state before a group is picked  -->
                    <StackPanel x:Name="PickHint" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                        <ui:SymbolIcon HorizontalAlignment="Center" FontSize="28" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Symbol="ArrowLeft24" />
                        <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" Style="{StaticResource Secondary}" Text="Pick a group on the left to see what's in it." />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!--  Details for the selected row  -->
        <Border
            x:Name="DetailsPanel"
            Grid.RowSpan="2"
            Grid.Column="1"
            Width="310"
            Margin="12,0,0,0"
            Padding="18,14,14,14"
            VerticalAlignment="Stretch"
            Style="{StaticResource TidyCard}"
            Visibility="Collapsed">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top">
                    <ui:Button
                        Width="28"
                        Height="28"
                        Padding="0"
                        Appearance="Transparent"
                        AutomationProperties.Name="Close details"
                        Click="OnCloseDetails"
                        DockPanel.Dock="Right">
                        <ui:SymbolIcon FontSize="14" Symbol="Dismiss24" />
                    </ui:Button>
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource CaptionStrong}" Text="DETAILS" />
                </DockPanel>
                <StackPanel Margin="0,10,0,0" DockPanel.Dock="Bottom">
                    <ui:Button
                        x:Name="OpenButton"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.Name="Open in Explorer"
                        Click="OnOpenInExplorer"
                        Content="Open in Explorer"
                        Icon="{ui:SymbolIcon FolderOpen24}" />
                </StackPanel>
                <ScrollViewer Margin="0,6,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="DetailsStack" Margin="0,0,6,0" />
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
