<UserControl
    x:Class="PcTidy.UI.Flow.ResultsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:PcTidy.UI.Controls"
    xmlns:flow="clr-namespace:PcTidy.UI.Flow"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis" />

        <DataTemplate DataType="{x:Type flow:SectionRow}">
            <DockPanel Margin="2,14,6,8">
                <Border Width="30" Height="30" Margin="0,0,10,0" CornerRadius="7" Background="{DynamicResource TidyAccentSoftBrush}">
                    <ui:SymbolIcon FontSize="16" Foreground="{DynamicResource TidyAccentBrush}" Symbol="{Binding Icon}" />
                </Border>
                <TextBlock VerticalAlignment="Center" DockPanel.Dock="Right" Style="{StaticResource Caption}" Text="{Binding Summary}" />
                <TextBlock VerticalAlignment="Center" FontSize="16" Style="{StaticResource SectionTitle}" Text="{Binding Title}" />
            </DockPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type flow:GroupRow}">
            <Border
                Margin="{Binding BottomMargin}"
                Padding="16,10,8,10"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="{Binding CardBorder}"
                CornerRadius="{Binding CardRadius}"
                MouseLeftButtonUp="OnGroupHeaderClick">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="104" />
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="84" />
                        <ColumnDefinition Width="36" />
                    </Grid.ColumnDefinitions>
                    <CheckBox
                        x:Name="GroupCheck"
                        MinWidth="0"
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{Binding Title, StringFormat='Tick all in {0}'}"
                        Focusable="False"
                        IsChecked="{Binding IsChecked, Mode=TwoWay}"
                        IsEnabled="{Binding HasSelectable}" />
                    <Border Grid.Column="1" Width="34" Height="34" VerticalAlignment="Center" Style="{StaticResource IconTile}">
                        <ui:SymbolIcon FontSize="18" Foreground="{DynamicResource TidyAccentBrush}" Symbol="{Binding Icon}" />
                    </Border>
                    <StackPanel Grid.Column="2" Margin="12,0,12,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource CardTitle}" Text="{Binding Title}" />
                            <TextBlock Margin="8,1,0,0" VerticalAlignment="Center" Style="{StaticResource Caption}" Text="{Binding CountText}" />
                        </StackPanel>
                        <TextBlock Margin="0,1,0,0" Style="{StaticResource SecondaryTrim}" Text="{Binding Description}" />
                    </StackPanel>
                    <c:BadgePill x:Name="GroupPill" Grid.Column="3" Badge="{Binding Badge}" />
                    <ui:SymbolIcon
                        Grid.Column="4"
                        AutomationProperties.Name="Needs admin: Windows asks once for the whole run"
                        FontSize="16"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Symbol="Shield24"
                        ToolTip="Needs admin. Windows asks once for the whole run."
                        Visibility="{Binding NeedsAdmin, Converter={StaticResource BoolVis}}" />
                    <c:SizeText Grid.Column="5" Bytes="{Binding TotalBytes}" ZeroText="" />
                    <ui:Button
                        Grid.Column="6"
                        Width="30"
                        Height="30"
                        Padding="0"
                        HorizontalAlignment="Right"
                        Appearance="Transparent"
                        AutomationProperties.Name="Show or hide items"
                        Click="OnToggleGroup"
                        Focusable="False">
                        <ui:SymbolIcon x:Name="Chevron" FontSize="14" Symbol="ChevronDown24" />
                    </ui:Button>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                    <Setter TargetName="Chevron" Property="Symbol" Value="ChevronUp24" />
                </DataTrigger>
                <!--  Nothing pickable: a safety badge would contradict the greyed rows inside  -->
                <DataTrigger Binding="{Binding IsInfoOnly}" Value="True">
                    <Setter TargetName="GroupPill" Property="Badge" Value="{x:Null}" />
                    <Setter TargetName="GroupPill" Property="Text" Value="Info only" />
                    <Setter TargetName="GroupPill" Property="Tone" Value="Neutral" />
                    <!--  …and no tick box that looks like it could be ticked  -->
                    <Setter TargetName="GroupCheck" Property="Visibility" Value="Hidden" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate DataType="{x:Type flow:ItemRow}">
            <Border
                Margin="{Binding BottomMargin}"
                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="{Binding CardBorder}"
                CornerRadius="{Binding CardRadius}">
                <Grid x:Name="RowGrid" Margin="16,9,8,9">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="104" />
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="84" />
                        <ColumnDefinition Width="36" />
                    </Grid.ColumnDefinitions>
                    <CheckBox
                        MinWidth="0"
                        Margin="44,0,6,0"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{Binding Item.Title}"
                        Focusable="False"
                        IsChecked="{Binding IsChecked, Mode=TwoWay}"
                        IsEnabled="{Binding IsSelectable}" />
                    <StackPanel Grid.Column="1" Margin="4,0,12,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontWeight="Normal" Style="{StaticResource CardTitle}" Text="{Binding Item.Title}" />
                            <!--  A plain fact ("Never played") is secondary text; only "Close X first" is amber (trigger below)  -->
                            <TextBlock
                                x:Name="NoteText"
                                Margin="10,1,0,0"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{Binding Note}" />
                        </StackPanel>
                        <!--  Up to two lines (v3 reasons are longer and the second half matters); the whole text is in the tooltip.  -->
                        <TextBlock
                            x:Name="Why"
                            MaxHeight="36"
                            Margin="0,1,0,0"
                            AutomationProperties.HelpText="{Binding SecondLine}"
                            Style="{StaticResource SecondaryTrim}"
                            Text="{Binding SecondLine}"
                            TextWrapping="Wrap"
                            ToolTip="{Binding SecondLine}" />
                    </StackPanel>
                    <c:BadgePill x:Name="ItemPill" Grid.Column="2" Badge="{Binding Item.Badge}" />
                    <ui:SymbolIcon
                        Grid.Column="3"
                        AutomationProperties.Name="Needs admin: Windows asks once for the whole run"
                        FontSize="16"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Symbol="Shield24"
                        ToolTip="Needs admin. Windows asks once for the whole run."
                        Visibility="{Binding Item.NeedsAdmin, Converter={StaticResource BoolVis}}" />
                    <c:SizeText Grid.Column="4" FontWeight="Normal" Bytes="{Binding Item.SizeBytes}" ZeroText="" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding NoteIsBlocker}" Value="True">
                    <Setter TargetName="NoteText" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
                <!--  DisabledReason: greyed, un-tickable, the reason instead of "why it's safe", and no safety badge  -->
                <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                    <Setter TargetName="RowGrid" Property="Opacity" Value="0.6" />
                    <Setter TargetName="ItemPill" Property="Badge" Value="{x:Null}" />
                    <Setter TargetName="ItemPill" Property="Text" Value="Not offered" />
                    <Setter TargetName="ItemPill" Property="Tone" Value="Neutral" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Row checkboxes aren't Tab stops (one Tab into the list, then arrows): say how to tick from the keyboard  -->
        <TextBlock
            x:Name="KeyboardHint"
            Grid.Row="1"
            Margin="2,6,0,0"
            Style="{StaticResource Caption}"
            Text="Keyboard: arrows move · Space ticks or unticks · Enter opens a group · Left closes it" />

        <ListBox
            x:Name="List"
            Padding="0,0,6,0"
            AutomationProperties.HelpText="Arrow keys move between rows. Space ticks or unticks. Enter opens or closes a group."
            AutomationProperties.Name="Scan results"
            PreviewKeyDown="OnListKeyDown"
            SelectionChanged="OnSelectionChanged"
            SelectionMode="Single"
            Style="{StaticResource TidyFlatList}" />

        <!--  Details for the selected row  -->
        <Border
            x:Name="DetailsPanel"
            Grid.RowSpan="2"
            Grid.Column="1"
            Width="310"
            Margin="12,0,0,0"
            Padding="18,14,14,14"
            VerticalAlignment="Stretch"
            Style="{StaticResource TidyCard}"
            Visibility="Collapsed">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top">
                    <ui:Button
                        Width="28"
                        Height="28"
                        Padding="0"
                        Appearance="Transparent"
                        AutomationProperties.Name="Close details"
                        Click="OnCloseDetails"
                        DockPanel.Dock="Right">
                        <ui:SymbolIcon FontSize="14" Symbol="Dismiss24" />
                    </ui:Button>
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource CaptionStrong}" Text="DETAILS" />
                </DockPanel>
                <StackPanel Margin="0,10,0,0" DockPanel.Dock="Bottom">
                    <ui:Button
                        x:Name="OpenButton"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.Name="Open in Explorer"
                        Click="OnOpenInExplorer"
                        Content="Open in Explorer"
                        Icon="{ui:SymbolIcon FolderOpen24}" />
                </StackPanel>
                <ScrollViewer Margin="0,6,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="DetailsStack" Margin="0,0,6,0" />
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
