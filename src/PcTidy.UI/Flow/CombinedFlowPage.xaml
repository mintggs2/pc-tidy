<UserControl
    x:Class="PcTidy.UI.Flow.CombinedFlowPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:PcTidy.UI.Controls"
    xmlns:flow="clr-namespace:PcTidy.UI.Flow"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    AutomationProperties.Name="Optimize and Organize everything"
    FontFamily="{StaticResource TidyText}">

    <Grid Margin="{StaticResource TidyPageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Header: pickers sit beside the title on wide windows and move under it on narrow ones (code-behind)  -->
        <Grid x:Name="Header" SizeChanged="OnHeaderSizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitle}" Text="Optimize &amp; Organize everything" />
                <TextBlock x:Name="Subtitle" Style="{StaticResource PageSubtitle}" Text="One list for every section · you confirm once" />
            </StackPanel>
            <StackPanel x:Name="Pickers" Grid.Column="1" Margin="16,8,0,0" VerticalAlignment="Top" Orientation="Horizontal">
                <TextBlock Margin="0,0,10,0" VerticalAlignment="Center" Style="{StaticResource Caption}" Text="Preset" />
                <c:Segmented x:Name="PresetPicker" Items="Safe|Recommended|Gamer|Privacy" Label="Preset" SelectedIndex="1" />
                <c:Segmented x:Name="DepthPicker" Margin="10,0,0,0" Items="Quick|Deep" Label="Scan depth" />
            </StackPanel>
        </Grid>

        <c:StepBar x:Name="Steps" Grid.Row="1" Margin="0,16,0,12" />

        <!--  Ready  -->
        <Border x:Name="ReadyState" Grid.Row="2" VerticalAlignment="Top" Style="{StaticResource HeroCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="56" Height="56" VerticalAlignment="Top" Background="{DynamicResource AccentFillColorDefaultBrush}" CornerRadius="12">
                    <ui:SymbolIcon FontSize="30" Filled="True" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" Symbol="Sparkle24" />
                </Border>
                <StackPanel Grid.Column="1" Margin="18,0,16,0">
                    <TextBlock x:Name="PresetTitle" FontFamily="{StaticResource TidyDisplay}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock x:Name="PresetDescription" Margin="0,3,0,10" Style="{StaticResource Secondary}" />
                    <TextBlock Style="{StaticResource CaptionStrong}" Text="SECTIONS THAT WILL BE SCANNED" />
                    <TextBlock x:Name="SectionList" Margin="0,2,0,0" Style="{StaticResource Secondary}" />
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <ui:Button
                        x:Name="ScanButton"
                        Height="48"
                        MinWidth="210"
                        Padding="20,0"
                        Appearance="Primary"
                        AutomationProperties.Name="Scan everything"
                        Click="OnScan"
                        Content="Scan everything"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Icon="{ui:SymbolIcon ArrowRight24}" />
                    <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" Style="{StaticResource Caption}" Text="Only looks · you confirm once" />
                </StackPanel>
            </Grid>
        </Border>

        <!--  Scanning: one line per section  -->
        <Border x:Name="ScanningState" Grid.Row="2" Padding="24,20" VerticalAlignment="Top" Style="{StaticResource TidyCard}" Visibility="Collapsed">
            <StackPanel>
                <DockPanel>
                    <ui:Button
                        Appearance="Secondary"
                        AutomationProperties.Name="Stop scanning"
                        Click="OnCancel"
                        Content="Stop"
                        DockPanel.Dock="Right"
                        Icon="{ui:SymbolIcon Dismiss24}" />
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource SectionTitle}" Text="Scanning every section…" />
                </DockPanel>
                <ProgressBar x:Name="ScanBar" Height="4" Margin="0,14,0,10" />
                <StackPanel x:Name="ScanLines" />
                <TextBlock Margin="0,10,0,0" Style="{StaticResource Caption}" Text="Scanning only looks. Nothing is changed until you confirm." />
            </StackPanel>
        </Border>

        <!--  Preview  -->
        <Grid x:Name="PreviewState" Grid.Row="2" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <UniformGrid x:Name="Totals" Margin="0,0,0,12" Rows="1" />
            <StackPanel x:Name="NotesPanel" Grid.Row="1" />
            <flow:ResultsPanel x:Name="Results" Grid.Row="2" />
            <Border Grid.Row="3" Style="{StaticResource StickyBar}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <ui:Button
                            x:Name="SimulateButton"
                            Height="40"
                            Margin="0,0,8,0"
                            Appearance="Secondary"
                            AutomationProperties.Name="Simulate everything: change nothing"
                            Click="OnSimulate"
                            Content="Simulate"
                            Icon="{ui:SymbolIcon Beaker24}" />
                        <ui:Button
                            x:Name="ConfirmButton"
                            Height="40"
                            MinWidth="200"
                            Appearance="Primary"
                            Click="OnConfirm"
                            FontWeight="SemiBold"
                            Icon="{ui:SymbolIcon Sparkle24}" />
                    </StackPanel>
                    <c:SelectionGlyph x:Name="SelectionIcon" Margin="0,0,14,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TotalsLine" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="TotalsCaption" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>

        <flow:SimulationReportView x:Name="SimulationState" Grid.Row="2" Visibility="Collapsed" />

        <ContentControl x:Name="DoneState" Grid.Row="2" MaxWidth="900" HorizontalAlignment="Left" Focusable="False" Visibility="Collapsed" />
    </Grid>
</UserControl>
