<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--  PC Tidy theme-specific brushes: DARK. Swapped by TidyTheme.Apply.  -->
    <SolidColorBrush x:Key="TidyAccentBrush" Color="#3CCB86" />
    <SolidColorBrush x:Key="TidyAccentSoftBrush" Color="#1F2BB673" />
    <SolidColorBrush x:Key="TidyAccentStrokeBrush" Color="#662BB673" />
    <SolidColorBrush x:Key="TidyRingTrackBrush" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="TidySecondDriveBrush" Color="#5AA9E6" />
    <SolidColorBrush x:Key="TidyDriveLowBrush" Color="#FCE100" />
    <LinearGradientBrush x:Key="TidyHeroBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#33208F5D" />
        <GradientStop Offset="1" Color="#0D2BB673" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="TidyStickyBarBrush" Color="#F2272727" />
    <SolidColorBrush x:Key="TidyOverlayBrush" Color="#202020" />
    <SolidColorBrush x:Key="TidyScrimBrush" Color="#99000000" />
    <SolidColorBrush x:Key="TidyDisabledRowBrush" Color="#0AFFFFFF" />
    <SolidColorBrush x:Key="TidyItemRowBrush" Color="#08FFFFFF" />
    <SolidColorBrush x:Key="TidyRowSelectedBrush" Color="#142BB673" />
    <SolidColorBrush x:Key="TidyBreakdown1Brush" Color="#33A0D9" />
    <SolidColorBrush x:Key="TidyBreakdown2Brush" Color="#3CCB86" />
    <SolidColorBrush x:Key="TidyBreakdown3Brush" Color="#C29A1E" />
    <SolidColorBrush x:Key="TidyBreakdown4Brush" Color="#866BD6" />
    <!--  Space map (treemap)  -->
    <SolidColorBrush x:Key="TidyProtectedFillBrush" Color="#3A3F45" />
    <SolidColorBrush x:Key="TidyHatchLineBrush" Color="#38FFFFFF" />
    <SolidColorBrush x:Key="TidyTreemapTextBrush" Color="#F2FFFFFF" />
    <SolidColorBrush x:Key="TidyTreemapGapBrush" Color="#202020" />
</ResourceDictionary>
