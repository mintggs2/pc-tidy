<UserControl
    x:Class="PcTidy.Features.Search.UI.StructureTabView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:PcTidy.UI.Controls;assembly=PcTidy.UI"
    xmlns:flow="clr-namespace:PcTidy.UI.Flow;assembly=PcTidy.UI"
    xmlns:local="clr-namespace:PcTidy.Features.Search.UI"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    AutomationProperties.Name="Suggest a folder structure">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Preset picker and scan  -->
        <DockPanel Margin="0,0,0,8">
            <ui:Button
                x:Name="ScanButton"
                Margin="12,0,0,0"
                Appearance="Secondary"
                AutomationProperties.Name="Suggest a structure"
                Click="OnScanClick"
                Content="Suggest again"
                DockPanel.Dock="Right"
                Icon="{ui:SymbolIcon ArrowClockwise24}"
                Visibility="Collapsed" />
            <c:Segmented x:Name="Presets" Items="Simple|By date|Projects &amp; Areas|Numbered" Label="Folder structure preset" />
        </DockPanel>
        <TextBlock x:Name="PresetSummary" Grid.Row="1" Margin="0,0,0,10" Style="{StaticResource Secondary}" TextWrapping="Wrap" />

        <StackPanel x:Name="NotesPanel" Grid.Row="2" />

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  Proposed tree  -->
            <Border Padding="14" Style="{StaticResource TidyCard}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}" Text="Proposed tree" />
                    <TextBlock Margin="0,2,0,8" DockPanel.Dock="Top" Style="{StaticResource Caption}" Text="Folders that would exist, and which of yours would land in each." TextWrapping="Wrap" />
                    <TreeView
                        x:Name="Tree"
                        AutomationProperties.Name="Proposed folder tree"
                        Background="Transparent"
                        BorderThickness="0"
                        VirtualizingPanel.IsVirtualizing="True">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="True" />
                                <Setter Property="AutomationProperties.Name" Value="{Binding Text}" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate DataType="{x:Type local:TreeNode}" ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Margin="0,0,6,0" FontSize="14" Symbol="{Binding Icon}" />
                                    <TextBlock Text="{Binding Text}" />
                                    <TextBlock Margin="6,0,0,0" Style="{StaticResource Caption}" Text="{Binding Note}" />
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </DockPanel>
            </Border>

            <!--  Ready  -->
            <Border x:Name="ReadyState" Grid.Column="2" VerticalAlignment="Top" Style="{StaticResource TidyCard}">
                <c:EmptyState
                    x:Name="ReadyEmpty"
                    Title="See a tidy structure for your drives"
                    ActionClick="OnScanClick"
                    ActionIcon="ScanDash24"
                    ActionText="Suggest now"
                    Icon="FolderArrowRight24"
                    Message="PC Tidy looks at your top-level folders (names and sizes only) and suggests where each fits. Nothing moves until you tick folders and confirm." />
            </Border>

            <!--  Scanning  -->
            <Border x:Name="ScanningState" Grid.Column="2" Padding="28,24" VerticalAlignment="Top" Style="{StaticResource TidyCard}" Visibility="Collapsed">
                <StackPanel>
                    <DockPanel>
                        <ui:ProgressRing Width="40" Height="40" Margin="0,0,16,0" IsIndeterminate="True" />
                        <ui:Button
                            VerticalAlignment="Center"
                            Appearance="Secondary"
                            AutomationProperties.Name="Stop looking"
                            Click="OnCancelScan"
                            Content="Stop"
                            DockPanel.Dock="Right"
                            Icon="{ui:SymbolIcon Dismiss24}" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Looking…" />
                            <TextBlock x:Name="ScanMessage" Style="{StaticResource SecondaryTrim}" />
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Margin="0,14,0,0" Style="{StaticResource Caption}" Text="Only names and sizes are read. Nothing is moved until you confirm." />
                </StackPanel>
            </Border>

            <!--  Results  -->
            <Grid x:Name="ResultsState" Grid.Column="2" Visibility="Collapsed">
                <flow:ResultsPanel x:Name="Results" />
                <c:EmptyState x:Name="NothingFound" Title="Already tidy" Icon="CheckmarkCircle24" Visibility="Collapsed" />
            </Grid>
        </Grid>

        <!--  Sticky action bar  -->
        <Border x:Name="StickyBar" Grid.Row="4" Style="{StaticResource StickyBar}" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="SelectedText" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="SelectedCaption" Style="{StaticResource Caption}" Text="Whole folders move; nothing inside them changes. Undo from History puts them back." TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:Button
                        x:Name="SimulateButton"
                        Height="40"
                        Margin="0,0,8,0"
                        Appearance="Secondary"
                        AutomationProperties.Name="Simulate: see what would happen, change nothing"
                        Click="OnSimulate"
                        Content="Simulate"
                        Icon="{ui:SymbolIcon Beaker24}" />
                    <ui:Button
                        x:Name="PrimaryButton"
                        Height="40"
                        MinWidth="140"
                        Appearance="Primary"
                        Click="OnPrimary"
                        FontWeight="SemiBold"
                        Icon="{ui:SymbolIcon FolderArrowRight24}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
