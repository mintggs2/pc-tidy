<UserControl
    x:Class="PcTidy.Features.Insights.View.InsightsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:PcTidy.UI.Controls;assembly=PcTidy.UI"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:v="clr-namespace:PcTidy.Features.Insights.View"
    AutomationProperties.Name="Insights"
    FontFamily="{DynamicResource TidyText}">

    <UserControl.Resources>
        <!--  A tickable row inside a card (OneDrive file, old folder)  -->
        <DataTemplate x:Key="InsightRowTemplate" DataType="{x:Type v:InsightRow}">
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox
                    MinWidth="0"
                    Margin="0,0,10,0"
                    VerticalAlignment="Top"
                    AutomationProperties.Name="{Binding AutomationName}"
                    IsChecked="{Binding IsChecked, Mode=TwoWay}"
                    IsEnabled="{Binding IsSelectable}" />
                <StackPanel Grid.Column="1">
                    <TextBlock Style="{DynamicResource BodyStrong}" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Style="{DynamicResource Caption}" Text="{Binding SecondLine}" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Top" Style="{DynamicResource SizeTextStyle}" Text="{Binding Size}" />
            </Grid>
        </DataTemplate>

        <!--  One change found in a script  -->
        <DataTemplate x:Key="FindingTemplate" DataType="{x:Type v:FindingRow}">
            <Border Margin="0,0,0,8" Style="{DynamicResource InnerTile}">
                <StackPanel>
                    <DockPanel>
                        <c:BadgePill DockPanel.Dock="Left" Margin="0,0,10,0" Text="{Binding VerdictText}" Tone="{Binding Tone}" />
                        <TextBlock DockPanel.Dock="Right" Margin="10,0,0,0" Style="{DynamicResource Caption}" Text="{Binding LineText}" />
                        <TextBlock Style="{DynamicResource BodyStrong}" Text="{Binding What}" TextWrapping="Wrap" />
                    </DockPanel>
                    <TextBlock Margin="0,4,0,0" Style="{DynamicResource Secondary}" Text="{Binding Why}" TextWrapping="Wrap" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontFamily="Cascadia Mono, Consolas"
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding Evidence}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="{DynamicResource TidyPageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{DynamicResource PageTitle}" Text="Insights" />
                    <c:BadgePill Margin="12,6,0,0" Text="Read-only" Tone="Success" />
                </StackPanel>
                <TextBlock
                    Style="{DynamicResource PageSubtitle}"
                    Text="What PC Tidy sees on this PC, explained. Reading changes nothing; the few actions always ask first."
                    TextWrapping="Wrap" />
            </StackPanel>
            <!--  Shown once there are results ("Check again"): before that the big button in the card is the only one.  -->
            <ui:Button
                x:Name="ScanButton"
                Grid.Column="1"
                Margin="16,6,0,0"
                VerticalAlignment="Top"
                Appearance="Secondary"
                AutomationProperties.Name="Check this PC again"
                Click="OnScanClick"
                Content="Check again"
                Icon="{ui:SymbolIcon ArrowClockwise24}"
                Visibility="Collapsed" />
        </Grid>

        <!--  The card area is the page's one scrolling list  -->
        <ScrollViewer x:Name="Scroller" Grid.Row="1" Focusable="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,4,8">

                <!--  Scan this script  -->
                <Border
                    x:Name="ScriptCard"
                    Margin="0,0,0,16"
                    AllowDrop="True"
                    AutomationProperties.Name="Scan this script"
                    DragOver="OnScriptDragOver"
                    Drop="OnScriptDrop"
                    Style="{DynamicResource HeroCard}">
                    <StackPanel>
                        <DockPanel>
                            <Border Margin="0,0,14,0" DockPanel.Dock="Left" Style="{DynamicResource IconTile}">
                                <ui:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" Symbol="DocumentSearch24" />
                            </Border>
                            <ui:Button
                                x:Name="PickScriptButton"
                                Margin="12,0,0,0"
                                VerticalAlignment="Top"
                                Appearance="Primary"
                                AutomationProperties.Name="Pick a script to scan"
                                Click="OnPickScript"
                                Content="Pick a file…"
                                DockPanel.Dock="Right"
                                Icon="{ui:SymbolIcon DocumentAdd24}" />
                            <StackPanel>
                                <TextBlock Style="{DynamicResource CardTitle}" Text="Scan this script" />
                                <TextBlock
                                    Style="{DynamicResource Secondary}"
                                    Text="Before you run a downloaded .ps1, .bat, .cmd, .reg, .vbs or .js, PC Tidy reads it as text and lists what it would change. It never runs the file. You can also drop a file here."
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </DockPanel>

                        <StackPanel x:Name="ScriptResult" Margin="0,16,0,0" Visibility="Collapsed">
                            <DockPanel>
                                <c:BadgePill x:Name="ScriptVerdictPill" Margin="0,0,10,0" DockPanel.Dock="Left" />
                                <TextBlock x:Name="ScriptFileName" Style="{DynamicResource Caption}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock x:Name="ScriptHeadline" Margin="0,8,0,0" Style="{DynamicResource BodyStrong}" TextWrapping="Wrap" />
                            <TextBlock x:Name="ScriptAdvice" Margin="0,4,0,10" Style="{DynamicResource Body}" TextWrapping="Wrap" />
                            <ListBox
                                x:Name="FindingsList"
                                MaxHeight="420"
                                AutomationProperties.Name="Changes found in the script"
                                Background="Transparent"
                                BorderThickness="0"
                                ItemTemplate="{StaticResource FindingTemplate}"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                VirtualizingPanel.IsVirtualizing="True"
                                VirtualizingPanel.ScrollUnit="Pixel"
                                VirtualizingPanel.VirtualizationMode="Recycling">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                            </ListBox>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!--  Not checked yet  -->
                <Border x:Name="ReadyState" Style="{DynamicResource TidyCard}">
                    <c:EmptyState
                        ActionClick="OnScanClick"
                        ActionIcon="ScanDash24"
                        ActionText="Check this PC"
                        Icon="DataUsage24"
                        Message="PC Tidy reads Windows' own information: stability, backups, the hosts file, memory, displays and more. Nothing changes."
                        Title="See what PC Tidy notices" />
                </Border>

                <!--  Checking  -->
                <Border x:Name="ScanningState" Padding="28,24" Style="{DynamicResource TidyCard}" Visibility="Collapsed">
                    <DockPanel>
                        <ui:ProgressRing Width="40" Height="40" Margin="0,0,16,0" IsIndeterminate="True" />
                        <ui:Button
                            VerticalAlignment="Center"
                            Appearance="Secondary"
                            AutomationProperties.Name="Stop checking"
                            Click="OnCancelScan"
                            Content="Stop"
                            DockPanel.Dock="Right"
                            Icon="{ui:SymbolIcon Dismiss24}" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{DynamicResource SectionTitle}" Text="Reading this PC…" />
                            <TextBlock x:Name="ScanMessage" Style="{DynamicResource SecondaryTrim}" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!--  Card sections (built from the report)  -->
                <StackPanel x:Name="Sections" Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
