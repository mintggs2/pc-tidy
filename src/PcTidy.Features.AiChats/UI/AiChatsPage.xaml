<UserControl
    x:Class="PcTidy.Features.AiChats.UI.AiChatsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:PcTidy.UI.Controls;assembly=PcTidy.UI"
    xmlns:local="clr-namespace:PcTidy.Features.AiChats.UI"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    AutomationProperties.Name="AI chats"
    FontFamily="{StaticResource TidyText}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="Mono" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="{StaticResource TidyPageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource PageTitle}" Text="AI chats" />
                <c:BadgePill x:Name="PrivacyPill" Margin="12,6,0,0" />
            </StackPanel>
            <TextBlock
                Style="{StaticResource PageSubtitle}"
                Text="Your ChatGPT, Claude, Claude Code and Codex chats in one private library on this PC. Keys and passwords are masked, nothing is uploaded, and PC Tidy never signs in anywhere." />
        </StackPanel>

        <c:Segmented
            x:Name="Tabs"
            Grid.Row="1"
            Margin="0,14,0,14"
            Items="Library|Agent chats on this PC|Exposed secrets|How to export your chats"
            Label="AI chats sections" />

        <!--  ============================== Library ==============================  -->
        <Grid x:Name="LibraryPanel" Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="200" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBox
                    x:Name="SearchBox"
                    AutomationProperties.Name="Search your chats"
                    Icon="{ui:SymbolIcon Search24}"
                    PlaceholderText="Search all chats (titles and messages)"
                    TextChanged="OnSearchChanged" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:Button
                        Margin="8,0,0,0"
                        Appearance="Secondary"
                        AutomationProperties.Name="Import a ChatGPT or Claude export zip"
                        Click="OnImportZip"
                        Content="Import export zip…"
                        Icon="{ui:SymbolIcon ArrowImport24}" />
                    <ui:Button
                        Margin="8,0,0,0"
                        Appearance="Secondary"
                        AutomationProperties.Name="Import an extracted export folder"
                        Click="OnImportFolder"
                        Content="Import folder…"
                        Icon="{ui:SymbolIcon FolderOpen24}" />
                    <ui:Button
                        x:Name="ExportButton"
                        Margin="8,0,0,0"
                        Appearance="Secondary"
                        AutomationProperties.Name="Export chats to Obsidian"
                        Click="OnExport"
                        Content="Export to Obsidian…"
                        Icon="{ui:SymbolIcon DocumentArrowRight24}" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ExportFolderText" VerticalAlignment="Center" Style="{StaticResource SecondaryTrim}" />
                <ui:Button
                    Grid.Column="1"
                    Margin="8,0,0,0"
                    Appearance="Transparent"
                    AutomationProperties.Name="Choose the Obsidian folder for exports"
                    Click="OnChooseExportFolder"
                    Content="Change folder…" />
                <CheckBox
                    x:Name="KeepSecretsBox"
                    Grid.Column="2"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Keep keys and passwords in exported notes"
                    Click="OnKeepSecretsChanged"
                    Content="Keep keys in exports" />
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="*" MinWidth="240" />
                    <ColumnDefinition Width="1.15*" MinWidth="260" />
                </Grid.ColumnDefinitions>

                <!--  Filters  -->
                <Border Margin="0,0,8,0" Padding="4" Style="{StaticResource TidyCard}">
                    <ListBox
                        x:Name="FilterList"
                        AutomationProperties.Name="Show chats by source, view, topic, tag or folder"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        SelectionChanged="OnFilterChanged"
                        Style="{StaticResource TidyFlatList}"
                        VirtualizingPanel.IsVirtualizing="True"
                        VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemContainerStyle>
                            <Style BasedOn="{StaticResource {x:Type ListBoxItem}}" TargetType="ListBoxItem">
                                <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                                <!--  Room on the right so the scroll bar never sits on the counts.  -->
                                <Setter Property="Padding" Value="8,5,18,5" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                        <Setter Property="IsEnabled" Value="False" />
                                        <Setter Property="Focusable" Value="False" />
                                        <Setter Property="Margin" Value="0,10,0,0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:FilterRow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="Label" Text="{Binding Label}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Grid.Column="1" Margin="6,0,0,0" Style="{StaticResource Caption}" Text="{Binding CountText}" />
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                        <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                                        <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <Setter TargetName="Label" Property="FontSize" Value="12" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <!--  Chat list  -->
                <Border Grid.Column="1" Margin="0,0,8,0" Padding="4" Style="{StaticResource TidyCard}">
                    <Grid>
                        <ListBox
                            x:Name="ChatList"
                            AutomationProperties.Name="Chats"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            SelectionChanged="OnChatSelected"
                            SelectionMode="Extended"
                            Style="{StaticResource TidyFlatList}"
                            VirtualizingPanel.IsVirtualizing="True"
                            VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemContainerStyle>
                                <Style BasedOn="{StaticResource {x:Type ListBoxItem}}" TargetType="ListBoxItem">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                                    <Setter Property="Padding" Value="10,7" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:ChatRow}">
                                    <StackPanel>
                                        <DockPanel>
                                            <ui:SymbolIcon Margin="0,0,6,0" DockPanel.Dock="Left" FontSize="14" Symbol="Pin24" Visibility="{Binding Pinned, Converter={StaticResource BoolToVis}}" />
                                            <ui:SymbolIcon Margin="6,0,0,0" DockPanel.Dock="Right" FontSize="14" Foreground="{DynamicResource SystemFillColorCautionBrush}" Symbol="Key24" ToolTip="Contains masked keys or passwords" Visibility="{Binding HasSecrets, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                        <TextBlock Style="{StaticResource Caption}" Text="{Binding Meta}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <c:EmptyState
                            x:Name="LibraryEmpty"
                            ActionClick="OnImportZip"
                            ActionIcon="ArrowImport24"
                            ActionText="Import export zip…"
                            Icon="Chat24"
                            Title="No chats yet"
                            Visibility="Collapsed" />
                    </Grid>
                </Border>

                <!--  Preview  -->
                <Border Grid.Column="2" Padding="14,12" Style="{StaticResource TidyCard}">
                    <Grid>
                        <Grid x:Name="PreviewPanel" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="PreviewTitle" Style="{StaticResource CardTitle}" TextWrapping="Wrap" />
                                <TextBlock x:Name="PreviewMeta" Margin="0,2,0,0" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                            </StackPanel>

                            <WrapPanel Grid.Row="1" Margin="0,8,0,0">
                                <ToggleButton
                                    x:Name="PinButton"
                                    Margin="0,0,6,6"
                                    Padding="10,4"
                                    AutomationProperties.Name="Pin this chat"
                                    Click="OnPinClick"
                                    Content="Pin" />
                                <ComboBox
                                    x:Name="FolderBox"
                                    MinWidth="130"
                                    Margin="0,0,6,6"
                                    AutomationProperties.Name="Folder for this chat (type a new name to create one)"
                                    IsEditable="True"
                                    KeyDown="OnFolderKeyDown"
                                    LostKeyboardFocus="OnFolderCommit"
                                    ToolTip="Folder: type a name and press Enter" />
                                <TextBox
                                    x:Name="TopicBox"
                                    MinWidth="110"
                                    Margin="0,0,6,6"
                                    AutomationProperties.Name="Topic for this chat (press Enter to save)"
                                    KeyDown="OnTopicKeyDown"
                                    ToolTip="Topic: type your own and press Enter (empty = automatic)" />
                                <TextBox
                                    x:Name="TagBox"
                                    MinWidth="90"
                                    Margin="0,0,6,6"
                                    AutomationProperties.Name="Add a tag (press Enter)"
                                    KeyDown="OnTagKeyDown"
                                    ToolTip="Add a tag and press Enter" />
                            </WrapPanel>

                            <ItemsControl x:Name="TagList" Grid.Row="2" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button
                                            Margin="0,0,6,6"
                                            Padding="8,2"
                                            AutomationProperties.Name="{Binding StringFormat='Remove tag {0}'}"
                                            Click="OnRemoveTag"
                                            Content="{Binding}"
                                            ContentStringFormat="#{0}  ×"
                                            Tag="{Binding}"
                                            ToolTip="Remove this tag" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ListBox
                                x:Name="MessageList"
                                Grid.Row="3"
                                AutomationProperties.Name="Messages (keys and passwords are masked)"
                                ScrollViewer.CanContentScroll="True"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                Style="{StaticResource TidyFlatList}"
                                VirtualizingPanel.IsVirtualizing="True"
                                VirtualizingPanel.ScrollUnit="Pixel"
                                VirtualizingPanel.VirtualizationMode="Recycling">
                                <ListBox.ItemContainerStyle>
                                    <Style BasedOn="{StaticResource {x:Type ListBoxItem}}" TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="4,6" />
                                        <Setter Property="AutomationProperties.Name" Value="{Binding Header}" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:MessageRow}">
                                        <StackPanel>
                                            <TextBlock x:Name="Who" Style="{StaticResource CaptionStrong}" Text="{Binding Header}" />
                                            <TextBlock Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Text}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                <Setter TargetName="Who" Property="Foreground" Value="{DynamicResource TidyAccentBrush}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                        <c:EmptyState x:Name="PreviewEmpty" Icon="ChatMultiple24" Title="Pick a chat" Message="Its messages show here, with keys and passwords masked." />
                    </Grid>
                </Border>
            </Grid>

            <StackPanel Grid.Row="3">
                <ui:InfoBar
                    x:Name="DamagedInfo"
                    Title="The chat library is damaged"
                    Margin="0,8,0,0"
                    IsClosable="False"
                    IsOpen="False"
                    Message="PC Tidy can't read its chat library any more (for example after a power cut during an import). Your exports and agent chats aren't affected: starting a new library and importing them again brings the chats back. Tags, pins and folders start empty."
                    Severity="Warning">
                    <ui:Button
                        Appearance="Primary"
                        AutomationProperties.Name="Start a new chat library"
                        Click="OnRebuildLibrary"
                        Content="Start a new library" />
                </ui:InfoBar>
                <TextBlock x:Name="LibraryStatus" Margin="0,8,0,0" Style="{StaticResource SecondaryTrim}" />
            </StackPanel>
        </Grid>

        <!--  ============================== Agent chats ==============================  -->
        <Grid x:Name="AgentPanel" Grid.Row="2" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ui:InfoBar
                x:Name="CleanupInfo"
                Title="Claude Code removes old chats by itself"
                Margin="0,0,0,8"
                IsClosable="False"
                IsOpen="True"
                Severity="Informational" />

            <Grid Grid.Row="1" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ArchiveFolderText" VerticalAlignment="Center" Style="{StaticResource SecondaryTrim}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <CheckBox
                        x:Name="MarkdownCopyBox"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Also save a readable Markdown copy of each chat"
                        Content="Also save a readable copy (.md)"
                        IsChecked="True" />
                    <ui:Button
                        Appearance="Secondary"
                        AutomationProperties.Name="Choose the archive folder"
                        Click="OnChooseArchiveFolder"
                        Content="Choose archive folder…"
                        Icon="{ui:SymbolIcon FolderOpen24}" />
                    <ui:Button
                        Margin="8,0,0,0"
                        Appearance="Secondary"
                        AutomationProperties.Name="Look for agent chats again"
                        Click="OnRefreshAgents"
                        Content="Refresh"
                        Icon="{ui:SymbolIcon ArrowClockwise24}" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="2" Padding="4" Style="{StaticResource TidyCard}">
                <Grid>
                    <ListBox
                        x:Name="AgentList"
                        AutomationProperties.Name="Agent chats by project and month"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        Style="{StaticResource TidyFlatList}"
                        VirtualizingPanel.IsVirtualizing="True"
                        VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemContainerStyle>
                            <Style BasedOn="{StaticResource {x:Type ListBoxItem}}" TargetType="ListBoxItem">
                                <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                                <Setter Property="Padding" Value="10,6" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:AgentRow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="{Binding AutomationName}"
                                        Click="OnAgentRowChecked"
                                        IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                        IsEnabled="{Binding CanSelect}" />
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding Project, Mode=OneWay}" />
                                            <Run Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Month, Mode=OneWay, StringFormat=' · {0}'}" />
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding SourceText, Mode=OneWay}" />
                                            <Run Text="{Binding HintText, Mode=OneWay}" />
                                            <Run Text="{Binding CountText, Mode=OneWay, StringFormat=' · {0}'}" />
                                            <Run Text="{Binding StateText, Mode=OneWay, StringFormat=' · {0}'}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource SizeTextStyle}" Text="{Binding SizeText}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <c:EmptyState x:Name="AgentEmpty" Icon="Bot24" Title="No agent chats found" Message="Claude Code and Codex keep their chats in your user folder (.claude and .codex). None were found on this PC." Visibility="Collapsed" />
                </Grid>
            </Border>

            <Border Grid.Row="3" Style="{StaticResource StickyBar}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <!--  Row 1: the consent for "Remove originals…" (full sentence, wraps) next to the button it unlocks.
                          Row 2: what's ticked, and the two everyday actions.  -->
                    <CheckBox
                        x:Name="RemoveOkBox"
                        Margin="0,0,0,10"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="I understand: originals with a checked copy go to quarantine, and Claude Code and Codex can't resume those chats until I restore them"
                        Click="OnRemoveOkChanged">
                        <TextBlock Text="Move originals that have a checked copy to quarantine. Claude Code and Codex can't resume those chats until you restore them." TextWrapping="Wrap" />
                    </CheckBox>
                    <ui:Button
                        x:Name="RemoveOriginalsButton"
                        Grid.Column="1"
                        Height="40"
                        Margin="12,0,0,10"
                        VerticalAlignment="Center"
                        Appearance="Secondary"
                        AutomationProperties.Name="Move originals that have a checked copy to quarantine"
                        Click="OnRemoveOriginals"
                        Content="Remove originals…"
                        Icon="{ui:SymbolIcon Delete24}"
                        IsEnabled="False" />
                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                        <TextBlock x:Name="AgentSelectedText" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" />
                        <TextBlock x:Name="AgentSelectedHint" Style="{StaticResource Caption}" Text="Tick the ones to archive." />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="12,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                        <ui:Button
                            x:Name="AddToLibraryButton"
                            Height="40"
                            Margin="0,0,8,0"
                            Appearance="Secondary"
                            AutomationProperties.Name="Add the ticked agent chats to the library"
                            Click="OnAddAgentsToLibrary"
                            Content="Add to library"
                            Icon="{ui:SymbolIcon CollectionsAdd24}" />
                        <ui:Button
                            x:Name="ArchiveButton"
                            Height="40"
                            MinWidth="140"
                            Appearance="Primary"
                            AutomationProperties.Name="Archive a copy of the ticked agent chats"
                            Click="OnArchive"
                            Content="Archive a copy"
                            FontWeight="SemiBold"
                            Icon="{ui:SymbolIcon Archive24}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!--  ============================== Exposed secrets ==============================  -->
        <Grid x:Name="SecretsPanel" Grid.Row="2" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <!--  Only shown with keys in the list (RefreshSecretsAsync); with none, the empty state says "No exposed keys".  -->
            <ui:InfoBar
                x:Name="SecretsWarning"
                Title="Keys that look real"
                Margin="0,0,0,8"
                IsClosable="False"
                IsOpen="False"
                Message="These chats contain keys, tokens or passwords that look live. Anyone who reads the chat (or its export) could use them, so rotate each one. PC Tidy never shows the full key."
                Severity="Warning" />
            <Border Grid.Row="1" Padding="4" Style="{StaticResource TidyCard}">
                <Grid>
                    <ListBox
                        x:Name="SecretList"
                        AutomationProperties.Name="Exposed secrets"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        Style="{StaticResource TidyFlatList}"
                        VirtualizingPanel.IsVirtualizing="True"
                        VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemContainerStyle>
                            <Style BasedOn="{StaticResource {x:Type ListBoxItem}}" TargetType="ListBoxItem">
                                <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                                <Setter Property="Padding" Value="10,8" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:SecretRow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock>
                                            <Run FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Title, Mode=OneWay}" />
                                            <Run Text="  " />
                                            <Run FontFamily="Cascadia Mono, Consolas" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Masked, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource Caption}" Text="{Binding Where}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Margin="0,2,0,0" Style="{StaticResource Secondary}" Text="{Binding Advice}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ui:Button
                                        Grid.Column="1"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Appearance="Secondary"
                                        AutomationProperties.Name="{Binding Title, StringFormat='Open the chat with this {0}'}"
                                        Click="OnOpenSecretChat"
                                        Content="Open chat"
                                        Tag="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <c:EmptyState x:Name="SecretsEmpty" Icon="ShieldCheckmark24" Title="No exposed keys" Message="None of your imported chats contain keys or passwords that look real." Visibility="Collapsed" />
                </Grid>
            </Border>
            <CheckBox
                x:Name="AllSecretsBox"
                Grid.Row="2"
                Margin="0,8,0,0"
                AutomationProperties.Name="Also show keys that look like examples or placeholders"
                Click="OnAllSecretsChanged"
                Content="Also show keys that look like examples or placeholders" />
        </Grid>

        <!--  ============================== How to export ==============================  -->
        <Border x:Name="GuidePanel" Grid.Row="2" Padding="20,16" Style="{StaticResource TidyCard}" Visibility="Collapsed">
            <ScrollViewer AutomationProperties.Name="How to export your chats" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="GuideContent" MaxWidth="820" HorizontalAlignment="Left" />
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
