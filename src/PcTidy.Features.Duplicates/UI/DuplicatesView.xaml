<UserControl
    x:Class="PcTidy.Features.Duplicates.UI.DuplicatesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:PcTidy.UI.Controls;assembly=PcTidy.UI"
    xmlns:local="clr-namespace:PcTidy.Features.Duplicates.UI"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    AutomationProperties.Name="Duplicates"
    FontFamily="{DynamicResource TidyText}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:NullToCollapsedConverter x:Key="NullToCollapsed" />

        <!--  One copy inside a duplicate group: Keep (radio) · Remove (tick) · name and folder · tag · size · open  -->
        <DataTemplate x:Key="CopyTemplate" DataType="{x:Type local:CopyRow}">
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <RadioButton
                    MinWidth="0"
                    Margin="0,0,6,0"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{Binding Name, StringFormat='Keep {0}'}"
                    Content="Keep"
                    GroupName="{Binding GroupName}"
                    IsChecked="{Binding IsKept, Mode=TwoWay}"
                    IsEnabled="{Binding CanKeep}" />
                <CheckBox
                    Grid.Column="1"
                    MinWidth="0"
                    Margin="4,0,10,0"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{Binding Name, StringFormat='Remove {0}'}"
                    Content="Remove"
                    IsChecked="{Binding IsChecked, Mode=TwoWay}"
                    IsEnabled="{Binding CanTick}"
                    ToolTip="{Binding DisabledReason}"
                    ToolTipService.ShowOnDisabled="True" />
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Style="{DynamicResource Body}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Style="{DynamicResource Caption}" Text="{Binding Folder}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                    <TextBlock
                        Style="{DynamicResource Caption}"
                        Text="{Binding DisabledReason}"
                        TextWrapping="Wrap"
                        Visibility="{Binding DisabledReason, Converter={StaticResource NullToCollapsed}}" />
                </StackPanel>
                <c:BadgePill
                    Grid.Column="3"
                    Margin="8,0"
                    Text="{Binding Tag}"
                    Tone="Neutral"
                    Visibility="{Binding Tag, Converter={StaticResource NullToCollapsed}}" />
                <TextBlock
                    Grid.Column="4"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Style="{DynamicResource Body}"
                    Text="{Binding SizeText}" />
                <ui:Button
                    Grid.Column="5"
                    Margin="8,0,0,0"
                    Padding="6"
                    Appearance="Transparent"
                    AutomationProperties.Name="{Binding Name, StringFormat='Show {0} in Explorer'}"
                    Click="OnOpenInExplorer"
                    Icon="{ui:SymbolIcon FolderOpen24}"
                    Tag="{Binding Path}"
                    ToolTip="Show in Explorer" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="GroupTemplate" DataType="{x:Type local:GroupRow}">
            <Border Margin="0,0,0,10" Padding="16,12" Style="{DynamicResource TidyCard}">
                <StackPanel>
                    <DockPanel>
                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" DockPanel.Dock="Right" Style="{DynamicResource CaptionStrong}" Text="{Binding Frees}" />
                        <ui:Button
                            Margin="8,0,0,0"
                            Padding="8,2"
                            Appearance="Primary"
                            AutomationProperties.Name="{Binding Header, StringFormat='Check fully: {0}'}"
                            Click="OnCheckFully"
                            Content="Check fully"
                            DockPanel.Dock="Right"
                            IsEnabled="{Binding CanCheckFully}"
                            Tag="{Binding}"
                            ToolTip="Reads every copy completely to make sure they're identical. Only then can a copy be removed."
                            Visibility="{Binding Group.IsProbable, Converter={StaticResource NullToCollapsed}}" />
                        <ui:Button
                            Margin="8,0,0,0"
                            Padding="8,2"
                            Appearance="Transparent"
                            AutomationProperties.Name="{Binding Header, StringFormat='Compare side by side: {0}'}"
                            Click="OnCompareGroup"
                            Content="Compare"
                            DockPanel.Dock="Right"
                            Icon="{ui:SymbolIcon SplitVertical24}"
                            Tag="{Binding}" />
                        <TextBlock Style="{DynamicResource CardTitle}" Text="{Binding Header}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Header}" />
                    </DockPanel>
                    <TextBlock Margin="0,2,0,2" Style="{DynamicResource Secondary}" Text="{Binding KeepLine}" TextWrapping="Wrap" />
                    <ItemsControl Focusable="False" ItemTemplate="{StaticResource CopyTemplate}" ItemsSource="{Binding Copies}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ImageTemplate" DataType="{x:Type local:ImageRow}">
            <Border
                Width="232"
                Margin="0,8,10,0"
                Padding="8"
                Loaded="OnImageTileLoaded"
                Style="{DynamicResource InnerTile}">
                <StackPanel>
                    <Border Height="150" Background="{DynamicResource ControlFillColorTertiaryBrush}" CornerRadius="4">
                        <Image
                            AutomationProperties.Name="{Binding Name, StringFormat='Preview of {0}'}"
                            RenderOptions.BitmapScalingMode="HighQuality"
                            Source="{Binding Thumbnail}"
                            Stretch="Uniform" />
                    </Border>
                    <TextBlock Margin="0,6,0,0" Style="{DynamicResource Body}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                    <TextBlock Style="{DynamicResource Caption}" Text="{Binding Folder}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Style="{DynamicResource Caption}" Text="{Binding Info}" />
                    <TextBlock Style="{DynamicResource CaptionStrong}" Text="{Binding Likeness}" />
                    <DockPanel Margin="0,4,0,0">
                        <ui:Button
                            Padding="6"
                            Appearance="Transparent"
                            AutomationProperties.Name="{Binding Name, StringFormat='Show {0} in Explorer'}"
                            Click="OnOpenInExplorer"
                            DockPanel.Dock="Right"
                            Icon="{ui:SymbolIcon FolderOpen24}"
                            Tag="{Binding Path}"
                            ToolTip="Show in Explorer" />
                        <CheckBox
                            MinWidth="0"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="{Binding Name, StringFormat='Remove {0}'}"
                            Content="Remove"
                            IsChecked="{Binding IsChecked, Mode=TwoWay}"
                            IsEnabled="{Binding CanRemove}"
                            ToolTip="{Binding DisabledReason}"
                            ToolTipService.ShowOnDisabled="True" />
                    </DockPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="SimilarTemplate" DataType="{x:Type local:SimilarGroupRow}">
            <Border Margin="0,0,0,10" Padding="16,12" Style="{DynamicResource TidyCard}">
                <StackPanel>
                    <DockPanel>
                        <ui:Button
                            Padding="8,2"
                            Appearance="Transparent"
                            AutomationProperties.Name="{Binding Header, StringFormat='Compare side by side: {0}'}"
                            Click="OnCompareSimilar"
                            Content="Compare"
                            DockPanel.Dock="Right"
                            Icon="{ui:SymbolIcon SplitVertical24}"
                            Tag="{Binding}" />
                        <TextBlock Style="{DynamicResource CardTitle}" Text="{Binding Header}" />
                    </DockPanel>
                    <TextBlock Margin="0,2,0,0" Style="{DynamicResource Secondary}" Text="{Binding KeepLine}" TextWrapping="Wrap" />
                    <ItemsControl Focusable="False" ItemTemplate="{StaticResource ImageTemplate}" ItemsSource="{Binding Images}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="SimpleTemplate" DataType="{x:Type local:SimpleRow}">
            <Grid Margin="4,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox
                    MinWidth="0"
                    Margin="0,0,10,0"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{Binding Title, StringFormat='Remove {0}'}"
                    IsChecked="{Binding IsChecked, Mode=TwoWay}"
                    IsEnabled="{Binding CanRemove}"
                    ToolTip="{Binding DisabledReason}"
                    ToolTipService.ShowOnDisabled="True" />
                <StackPanel Grid.Column="1">
                    <TextBlock Style="{DynamicResource Body}" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Style="{DynamicResource Caption}" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                    <TextBlock Style="{DynamicResource Secondary}" Text="{Binding HelpText}" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{DynamicResource Body}" Text="{Binding SizeText}" />
                <ui:Button
                    Grid.Column="3"
                    Margin="8,0,0,0"
                    Padding="6"
                    VerticalAlignment="Center"
                    Appearance="Transparent"
                    AutomationProperties.Name="{Binding Title, StringFormat='Show {0} in Explorer'}"
                    Click="OnOpenInExplorer"
                    Icon="{ui:SymbolIcon FolderOpen24}"
                    Tag="{Binding Path}"
                    ToolTip="Show in Explorer" />
            </Grid>
        </DataTemplate>

        <!--  A file whose content isn't what its name says: rename (harmless ones only) or "shown so you know".  -->
        <DataTemplate x:Key="ExtensionTemplate" DataType="{x:Type local:ExtensionRow}">
            <Grid Margin="4,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox
                    MinWidth="0"
                    Margin="0,0,10,0"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{Binding Title, StringFormat='Rename {0}'}"
                    IsChecked="{Binding IsChecked, Mode=TwoWay}"
                    IsEnabled="{Binding CanRemove}"
                    ToolTip="{Binding DisabledReason}"
                    ToolTipService.ShowOnDisabled="True" />
                <StackPanel Grid.Column="1">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Margin="0,0,6,0" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Symbol="ShieldError24" Visibility="{Binding IsSecurityWarning, Converter={StaticResource NullToCollapsed}}" />
                        <TextBlock Style="{DynamicResource Body}" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Style="{DynamicResource Caption}" Text="{Binding Folder}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                    <TextBlock Style="{DynamicResource Secondary}" Text="{Binding Reason}" TextWrapping="Wrap" />
                    <TextBlock Style="{DynamicResource CaptionStrong}" Text="{Binding NewName}" Visibility="{Binding NewName, Converter={StaticResource NullToCollapsed}}" />
                </StackPanel>
                <c:BadgePill
                    Grid.Column="2"
                    Margin="8,0"
                    VerticalAlignment="Center"
                    Text="{Binding Tag}"
                    Tone="Caution"
                    Visibility="{Binding Tag, Converter={StaticResource NullToCollapsed}}" />
                <ui:Button
                    Grid.Column="3"
                    Margin="8,0,0,0"
                    Padding="6"
                    VerticalAlignment="Center"
                    Appearance="Transparent"
                    AutomationProperties.Name="{Binding Title, StringFormat='Show {0} in Explorer'}"
                    Click="OnOpenInExplorer"
                    Icon="{ui:SymbolIcon FolderOpen24}"
                    Tag="{Binding Path}"
                    ToolTip="Show in Explorer" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="{DynamicResource TidyPageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{DynamicResource PageTitle}" Text="Duplicates" />
                    <c:BadgePill Margin="12,6,0,0" Text="Check each item" Tone="Caution" />
                </StackPanel>
                <TextBlock Style="{DynamicResource PageSubtitle}" Text="Copies of the same file, look-alike pictures, empty folders and broken shortcuts. One copy of every file is always kept." />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="16,6,0,0" VerticalAlignment="Top" Orientation="Horizontal">
                <c:Segmented x:Name="DepthPicker" Margin="0,0,10,0" Items="Quick|Deep" Label="Scan depth" />
                <ui:Button
                    x:Name="ScanButton"
                    Appearance="Secondary"
                    AutomationProperties.Name="Scan"
                    Click="OnScan"
                    Content="Scan"
                    Icon="{ui:SymbolIcon ArrowClockwise24}" />
            </StackPanel>
        </Grid>

        <c:StepBar x:Name="Steps" Grid.Row="1" Margin="0,16,0,12" />

        <!--  Ready  -->
        <Border x:Name="ReadyState" Grid.Row="2" VerticalAlignment="Top" Padding="0" Style="{DynamicResource TidyCard}">
            <c:EmptyState
                x:Name="ReadyEmpty"
                ActionClick="OnScan"
                ActionIcon="ScanDash24"
                ActionText="Scan now"
                Icon="DocumentCopy24"
                Message="Scanning only looks. PC Tidy compares files by their exact content, never touches Windows, apps, games or code projects, and never downloads online-only files."
                Title="Find duplicates and junk" />
        </Border>

        <!--  Scanning  -->
        <Border x:Name="ScanningState" Grid.Row="2" Padding="28,24" VerticalAlignment="Top" Style="{DynamicResource TidyCard}" Visibility="Collapsed">
            <StackPanel>
                <DockPanel>
                    <ui:ProgressRing Width="40" Height="40" Margin="0,0,16,0" IsIndeterminate="True" />
                    <ui:Button
                        VerticalAlignment="Center"
                        Appearance="Secondary"
                        AutomationProperties.Name="Stop scanning"
                        Click="OnCancel"
                        Content="Stop"
                        DockPanel.Dock="Right"
                        Icon="{ui:SymbolIcon Dismiss24}" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{DynamicResource SectionTitle}" Text="Looking for duplicates…" />
                        <TextBlock x:Name="ScanMessage" Style="{DynamicResource SecondaryTrim}" />
                    </StackPanel>
                </DockPanel>
                <ProgressBar x:Name="ScanBar" Height="4" Margin="0,18,0,0" IsIndeterminate="True" />
                <TextBlock Margin="0,14,0,0" Style="{DynamicResource Caption}" Text="Scanning only looks. Nothing is changed until you confirm." />
            </StackPanel>
        </Border>

        <!--  Results  -->
        <Grid x:Name="ResultsState" Grid.Row="2" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel>
                <ui:InfoBar
                    x:Name="SummaryBar"
                    Title="Nothing is changed yet."
                    Margin="0,0,0,6"
                    IsClosable="False"
                    IsOpen="True"
                    Severity="Informational" />
                <ItemsControl x:Name="NotesList" Margin="2,0,0,6" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Margin="0,1" Style="{DynamicResource Caption}" Text="{Binding}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!--  The sections as segmented tabs (like the other sections). Wraps to a second line on narrow windows.  -->
            <Border
                x:Name="TabStrip"
                Grid.Row="1"
                Margin="0,4,0,0"
                Padding="2"
                HorizontalAlignment="Left"
                AutomationProperties.Name="Duplicates sections"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <WrapPanel x:Name="TabButtons" KeyboardNavigation.DirectionalNavigation="Cycle" />
            </Border>

            <TabControl x:Name="Tabs" Grid.Row="2" AutomationProperties.Name="Duplicates results">
                <!--  Headers are drawn by the strip above; the control only swaps the content.  -->
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <!--  The tab items still need a host (selection and content depend on it), just not a visible one.  -->
                            <TabPanel IsItemsHost="True" Visibility="Collapsed" />
                            <ContentPresenter ContentSource="SelectedContent" />
                        </Grid>
                    </ControlTemplate>
                </TabControl.Template>
                <TabItem x:Name="ExactTab" AutomationProperties.Name="Duplicate files">
                    <Grid>
                        <ListBox
                            x:Name="ExactList"
                            Margin="0,10,0,0"
                            AutomationProperties.Name="Duplicate groups"
                            ItemTemplate="{StaticResource GroupTemplate}"
                            Style="{DynamicResource TidyFlatList}" />
                        <c:EmptyState Title="No duplicate files" Icon="DocumentCopy24" Message="No two files in the scanned folders have the same content." Visibility="{Binding HasItems, ElementName=ExactList, Converter={StaticResource NullToCollapsed}, ConverterParameter=invert}" />
                    </Grid>
                </TabItem>
                <TabItem x:Name="FolderTab" AutomationProperties.Name="Duplicate folders">
                    <Grid>
                        <ListBox
                            x:Name="FolderList"
                            Margin="0,10,0,0"
                            AutomationProperties.Name="Duplicate folder groups"
                            ItemTemplate="{StaticResource GroupTemplate}"
                            Style="{DynamicResource TidyFlatList}" />
                        <c:EmptyState Title="No duplicate folders" Icon="FolderOpen24" Message="No two folders hold exactly the same files." Visibility="{Binding HasItems, ElementName=FolderList, Converter={StaticResource NullToCollapsed}, ConverterParameter=invert}" />
                    </Grid>
                </TabItem>
                <TabItem x:Name="ProbableTab" AutomationProperties.Name="Huge files that are probably the same">
                    <Grid Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{DynamicResource Secondary}" Text="Files over 2 GB are first compared by samples (start, middle and end). Those are only probably the same: choose Check fully (or tick a copy) and PC Tidy reads them completely before anything can be removed." TextWrapping="Wrap" />
                        <ListBox
                            x:Name="ProbableList"
                            Grid.Row="1"
                            Margin="0,8,0,0"
                            AutomationProperties.Name="Huge file groups"
                            ItemTemplate="{StaticResource GroupTemplate}"
                            Style="{DynamicResource TidyFlatList}" />
                        <c:EmptyState Grid.Row="1" Title="No huge twins" Icon="HardDrive20" Message="No files over 2 GB have a twin." Visibility="{Binding HasItems, ElementName=ProbableList, Converter={StaticResource NullToCollapsed}, ConverterParameter=invert}" />
                    </Grid>
                </TabItem>
                <TabItem x:Name="SimilarTab" AutomationProperties.Name="Look-alike pictures">
                    <Grid>
                        <ListBox
                            x:Name="SimilarList"
                            Margin="0,10,0,0"
                            AutomationProperties.Name="Look-alike picture groups"
                            ItemTemplate="{StaticResource SimilarTemplate}"
                            Style="{DynamicResource TidyFlatList}" />
                        <c:EmptyState Title="No look-alike pictures" Icon="ImageMultiple24" Message="No pictures look like near-copies of each other." Visibility="{Binding HasItems, ElementName=SimilarList, Converter={StaticResource NullToCollapsed}, ConverterParameter=invert}" />
                    </Grid>
                </TabItem>
                <TabItem x:Name="JunkTab" AutomationProperties.Name="Empty folders, empty files and broken shortcuts">
                    <Grid Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel>
                            <ui:Button
                                Appearance="Transparent"
                                AutomationProperties.Name="Tick everything in this list"
                                Click="OnTickAllJunk"
                                Content="Tick all"
                                DockPanel.Dock="Right" />
                            <c:Segmented x:Name="JunkPicker" Items="Empty folders|Empty files|Broken shortcuts" Label="Kind of junk" />
                        </DockPanel>
                        <ListBox
                            x:Name="JunkList"
                            Grid.Row="1"
                            Margin="0,8,0,0"
                            AutomationProperties.Name="Junk items"
                            ItemTemplate="{StaticResource SimpleTemplate}"
                            Style="{DynamicResource TidyFlatList}" />
                        <c:EmptyState Grid.Row="1" Title="Nothing of this kind" Icon="CheckmarkCircle24" Message="None were found in the scanned folders. The other kinds are one click away above." Visibility="{Binding HasItems, ElementName=JunkList, Converter={StaticResource NullToCollapsed}, ConverterParameter=invert}" />
                    </Grid>
                </TabItem>
                <TabItem x:Name="ExtensionTab" AutomationProperties.Name="Files whose name says the wrong type">
                    <Grid Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{DynamicResource Secondary}" Text="PC Tidy looked at the first bytes of each file. A program named like a document is a security warning and is never renamed; other mismatches can be renamed, if you tick them." TextWrapping="Wrap" />
                        <ListBox
                            x:Name="ExtensionList"
                            Grid.Row="1"
                            Margin="0,8,0,0"
                            AutomationProperties.Name="Files with the wrong type in their name"
                            ItemTemplate="{StaticResource ExtensionTemplate}"
                            Style="{DynamicResource TidyFlatList}" />
                        <c:EmptyState Grid.Row="1" Title="Every name matches" Icon="CheckmarkCircle24" Message="Every file's name matches what's inside it." Visibility="{Binding HasItems, ElementName=ExtensionList, Converter={StaticResource NullToCollapsed}, ConverterParameter=invert}" />
                    </Grid>
                </TabItem>
                <TabItem Header="Compare" AutomationProperties.Name="Compare to a master folder">
                    <Grid Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Padding="16,12" Style="{DynamicResource TidyCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.ColumnSpan="3" Margin="0,0,0,8" Style="{DynamicResource Secondary}" Text="Pick the folder you trust (the master) and another folder. PC Tidy lists the files in the other folder that are already in the master. The master is never changed." TextWrapping="Wrap" />
                                <TextBlock Grid.Row="1" Margin="0,0,12,0" VerticalAlignment="Center" Style="{DynamicResource BodyStrong}" Text="Master" />
                                <TextBlock x:Name="MasterText" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Style="{DynamicResource SecondaryTrim}" />
                                <ui:Button Grid.Row="1" Grid.Column="2" Margin="8,2" AutomationProperties.Name="Choose master folder" Click="OnPickMaster" Content="Choose…" />
                                <TextBlock Grid.Row="2" Margin="0,0,12,0" VerticalAlignment="Center" Style="{DynamicResource BodyStrong}" Text="Check" />
                                <TextBlock x:Name="OtherText" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" Style="{DynamicResource SecondaryTrim}" />
                                <ui:Button Grid.Row="2" Grid.Column="2" Margin="8,2" AutomationProperties.Name="Choose folder to check" Click="OnPickOther" Content="Choose…" />
                            </Grid>
                        </Border>
                        <DockPanel Grid.Row="1" Margin="0,10,0,0">
                            <ui:Button
                                Appearance="Primary"
                                AutomationProperties.Name="Compare the two folders"
                                Click="OnCompare"
                                Content="Compare"
                                DockPanel.Dock="Left"
                                Icon="{ui:SymbolIcon ArrowSync24}" />
                            <ui:Button
                                Appearance="Transparent"
                                AutomationProperties.Name="Tick every match"
                                Click="OnTickAllMatches"
                                Content="Tick all"
                                DockPanel.Dock="Right" />
                            <TextBlock x:Name="CompareText" Margin="12,0" VerticalAlignment="Center" Style="{DynamicResource Secondary}" TextWrapping="Wrap" />
                        </DockPanel>
                        <ListBox
                            x:Name="MasterList"
                            Grid.Row="2"
                            Margin="0,8,0,0"
                            AutomationProperties.Name="Files already in the master folder"
                            ItemTemplate="{StaticResource SimpleTemplate}"
                            Style="{DynamicResource TidyFlatList}" />
                        <c:EmptyState Grid.Row="1" Title="Nothing of this kind" Icon="CheckmarkCircle24" Message="None were found in the scanned folders. The other kinds are one click away above." Visibility="{Binding HasItems, ElementName=JunkList, Converter={StaticResource NullToCollapsed}, ConverterParameter=invert}" />
                    </Grid>
                </TabItem>
                <TabItem Header="Reference folders" AutomationProperties.Name="Reference folders">
                    <StackPanel Margin="0,10,0,0">
                        <TextBlock Style="{DynamicResource Secondary}" Text="Copies in a reference folder are never removed. Use it for the folders you keep tidy (your photo archive, a backup you trust). They're still compared, so copies elsewhere can be found." TextWrapping="Wrap" />
                        <ui:Button
                            Margin="0,10,0,10"
                            AutomationProperties.Name="Add a reference folder"
                            Click="OnAddReference"
                            Content="Add a folder…"
                            Icon="{ui:SymbolIcon FolderAdd24}" />
                        <ItemsControl x:Name="ReferenceList" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:ReferenceFolderRow}">
                                    <Border Margin="0,0,0,6" Padding="12,8" Style="{DynamicResource InnerTile}">
                                        <DockPanel>
                                            <ui:Button
                                                Appearance="Transparent"
                                                AutomationProperties.Name="{Binding Display, StringFormat='Stop using {0} as a reference folder'}"
                                                Click="OnRemoveReference"
                                                Content="Remove"
                                                DockPanel.Dock="Right"
                                                Tag="{Binding}" />
                                            <TextBlock VerticalAlignment="Center" Style="{DynamicResource Body}" Text="{Binding Display}" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Margin="0,6,0,0" Style="{DynamicResource Caption}" Text="Folders you protected in Settings count as reference folders too. Scan again after changing this list." TextWrapping="Wrap" />
                    </StackPanel>
                </TabItem>
            </TabControl>

            <!--  Sticky bottom bar  -->
            <Border Grid.Row="3" Style="{DynamicResource StickyBar}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <c:SelectionGlyph x:Name="SelectionIcon" Margin="0,0,14,0" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="SelectedText" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="SelectedCaption" Style="{DynamicResource Caption}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <ui:Button
                            Margin="0,0,4,0"
                            Appearance="Transparent"
                            AutomationProperties.Name="Tick only the clear cases"
                            Click="OnClearCases"
                            Content="Only clear cases"
                            ToolTip="Ticks only copies in Downloads, temp or backup folders of files you keep in a library folder." />
                        <ui:Button
                            x:Name="SimulateButton"
                            Height="40"
                            Margin="0,0,8,0"
                            Appearance="Secondary"
                            AutomationProperties.Name="Simulate: see what would happen, change nothing"
                            Click="OnSimulate"
                            Content="Simulate"
                            Icon="{ui:SymbolIcon Beaker24}" />
                        <ui:Button
                            x:Name="PrimaryButton"
                            Height="40"
                            MinWidth="150"
                            Appearance="Primary"
                            AutomationProperties.Name="Remove the ticked items to quarantine"
                            Click="OnRun"
                            Content="Remove selected"
                            FontWeight="SemiBold"
                            Icon="{ui:SymbolIcon Broom24}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
