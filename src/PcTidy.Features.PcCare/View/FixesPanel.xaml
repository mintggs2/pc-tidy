<UserControl
    x:Class="PcTidy.Features.PcCare.View.FixesPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:PcTidy.UI.Controls;assembly=PcTidy.UI"
    AutomationProperties.Name="Fixes">

    <ScrollViewer Focusable="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,6,0">
            <TextBlock
                x:Name="Intro"
                Margin="2,0,0,4"
                Style="{DynamicResource Secondary}"
                Text="Standard Windows repairs for common problems. Each one says what it changes. Run always shows the confirm first, and only one runs at a time."
                TextWrapping="Wrap" />
            <TextBlock x:Name="NetworkNote" Margin="2,0,0,12" Style="{DynamicResource Caption}" TextWrapping="Wrap" />
            <c:ResponsiveGrid x:Name="CardsGrid" Gap="12" MaxColumns="3" MinItemWidth="260" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
