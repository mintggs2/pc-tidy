<UserControl
    x:Class="PcTidy.Features.Tweaks.UI.TweaksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:PcTidy.UI.Controls;assembly=PcTidy.UI"
    xmlns:flow="clr-namespace:PcTidy.UI.Flow;assembly=PcTidy.UI"
    xmlns:local="clr-namespace:PcTidy.Features.Tweaks.UI"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    AutomationProperties.Name="Tweaks">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:InverseBoolToVisibilityConverter x:Key="NotBoolToVis" />
        <local:RowMaxWidthConverter x:Key="RowMaxWidth" />

        <!--  Row / card title: greyed rows use the secondary text colour (not opacity) so they keep 4.5:1 contrast.  -->
        <Style x:Key="TweakTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--  Category chip: a radio button (keyboard: Tab to the group, arrows between chips).  -->
        <Style x:Key="TweakChip" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border
                            x:Name="Bd"
                            Padding="12,4,12,5"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="14">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlSolidFillColorDefaultBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource TidyAccentStrokeBrush}" />
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate DataType="{x:Type local:TweakHeaderRow}">
            <StackPanel Margin="2,14,0,8" AutomationProperties.Name="{Binding AutomationName}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Title}" />
                    <TextBlock Margin="10,2,0,0" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding CountText}" />
                </StackPanel>
                <TextBlock Margin="0,2,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Description}" TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>

        <!--  Details (shared by rows and cards): what happens, exact registry paths, Windows default, measured numbers, undo, sources  -->
        <DataTemplate x:Key="TweakDetails" DataType="{x:Type local:TweakItemRow}">
            <StackPanel Margin="0,6,0,0">
                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="WHAT HAPPENS" />
                <TextBlock Margin="0,2,0,8" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding WhatHappens}" TextWrapping="Wrap" />
                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="DETAILS" />
                <TextBlock
                    Margin="0,2,0,8"
                    FontFamily="Cascadia Mono, Consolas"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Text="{Binding DetailsText}"
                    TextWrapping="Wrap" />
                <Button
                    Margin="0,0,0,6"
                    AutomationProperties.Name="{Binding SettingsLink.AutomationName}"
                    Command="{Binding OpenLinkCommand}"
                    CommandParameter="{Binding SettingsLink}"
                    Content="{Binding SettingsLink.Label}"
                    Style="{DynamicResource LinkButton}"
                    Visibility="{Binding HasSettingsLink, Converter={StaticResource BoolToVis}}" />
                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="SOURCES" />
                <ItemsControl Focusable="False" ItemsSource="{Binding Sources}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button
                                Margin="0,2,14,0"
                                AutomationProperties.Name="{Binding AutomationName}"
                                Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}"
                                Content="{Binding Label}"
                                Style="{DynamicResource LinkButton}"
                                ToolTip="{Binding Target}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="TagList">
            <ItemsControl Focusable="False" ItemsSource="{Binding}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <c:BadgePill Margin="0,0,6,4" ShowDot="False" Text="{Binding Text}" Tone="{Binding Tone}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>

        <!--  List view: one row per tweak (also the Find bad tweaks tab)  -->
        <DataTemplate DataType="{x:Type local:TweakItemRow}">
            <Border
                Margin="0,0,0,6"
                Padding="14,10,10,10"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <CheckBox
                        Margin="0,1,6,0"
                        VerticalAlignment="Top"
                        AutomationProperties.Name="{Binding AutomationName}"
                        IsChecked="{Binding IsChecked}"
                        IsEnabled="{Binding IsSelectable}"
                        Visibility="{Binding CheckBoxVisibility}" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Style="{StaticResource TweakTitle}" Text="{Binding Title}" />
                        <TextBlock Margin="0,2,0,0" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding SecondLine}" TextWrapping="Wrap" />
                        <TextBlock
                            Margin="0,4,0,0"
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="{Binding MeasuredSummary}"
                            TextWrapping="Wrap"
                            Visibility="{Binding HasMeasured, Converter={StaticResource BoolToVis}}" />
                        <ContentControl Margin="0,6,0,0" Content="{Binding Tags}" ContentTemplate="{StaticResource TagList}" Focusable="False" />
                        <ContentControl
                            Content="{Binding}"
                            ContentTemplate="{StaticResource TweakDetails}"
                            Focusable="False"
                            Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Top" Orientation="Horizontal">
                        <c:BadgePill Margin="0,0,6,0" Text="{Binding Status.Text}" Tone="{Binding Status.Tone}" />
                        <c:BadgePill Margin="0,0,4,0" Text="{Binding Verdict.Text}" Tone="{Binding Verdict.Tone}" />
                        <ui:Button
                            Padding="6"
                            Appearance="Transparent"
                            AutomationProperties.Name="{Binding DetailsButtonName}"
                            Command="{Binding ToggleDetailsCommand}"
                            Icon="{ui:SymbolIcon ChevronDown24}"
                            ToolTip="Details, exact registry paths and sources" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!--  Cards view: the state-aware card (checkbox = "change this", never applied on click)  -->
        <DataTemplate x:Key="TweakCard" DataType="{x:Type local:TweakItemRow}">
            <Border
                Padding="14,12"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel>
                    <DockPanel>
                        <CheckBox
                            Margin="0,1,6,0"
                            VerticalAlignment="Top"
                            AutomationProperties.Name="{Binding CardAutomationName}"
                            DockPanel.Dock="Left"
                            IsChecked="{Binding IsChecked}"
                            IsEnabled="{Binding IsSelectable}"
                            ToolTip="Tick to include this change in the preview. Nothing changes until you confirm."
                            Visibility="{Binding CheckBoxVisibility}" />
                        <TextBlock Style="{StaticResource TweakTitle}" Text="{Binding Title}" />
                    </DockPanel>
                    <WrapPanel Margin="0,6,0,0">
                        <c:BadgePill Margin="0,0,6,4" Text="{Binding Evidence.Text}" Tone="{Binding Evidence.Tone}" />
                        <c:BadgePill Margin="0,0,6,4" ShowDot="False" Text="{Binding Safety.Text}" Tone="{Binding Safety.Tone}" />
                    </WrapPanel>
                    <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding SecondLine}" TextWrapping="Wrap" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontFamily="Cascadia Mono, Consolas"
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="{Binding WhatChanges}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="{Binding MeasuredSummary}"
                        TextWrapping="Wrap"
                        Visibility="{Binding HasMeasured, Converter={StaticResource BoolToVis}}" />
                    <ContentControl Margin="0,6,0,0" Content="{Binding Tags}" ContentTemplate="{StaticResource TagList}" Focusable="False" />
                    <DockPanel Margin="0,4,0,0">
                        <ui:Button
                            Padding="8,4"
                            Appearance="Transparent"
                            AutomationProperties.Name="{Binding DetailsButtonName}"
                            Command="{Binding ToggleDetailsCommand}"
                            Content="Details"
                            DockPanel.Dock="Right"
                            Icon="{ui:SymbolIcon ChevronDown24}" />
                        <c:BadgePill
                            HorizontalAlignment="Left"
                            AutomationProperties.Name="{Binding NowText}"
                            Text="{Binding NowText}"
                            Tone="{Binding NowTone}"
                            ToolTip="Read from this PC just now"
                            Visibility="{Binding HasNow, Converter={StaticResource BoolToVis}}" />
                    </DockPanel>
                    <ContentControl
                        Content="{Binding}"
                        ContentTemplate="{StaticResource TweakDetails}"
                        Focusable="False"
                        Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="32,16,32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Header: title, applied counter, tabs, Scan  -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <WrapPanel>
                    <TextBlock Margin="0,0,14,0" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="Tweaks" />
                    <TextBlock
                        Margin="0,0,0,5"
                        VerticalAlignment="Bottom"
                        AutomationProperties.Name="{Binding CounterAutomationName}"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding CounterText}"
                        ToolTip="Settings PC Tidy can apply that are already on, read from this PC"
                        Visibility="{Binding HasCounter, Converter={StaticResource BoolToVis}}" />
                </WrapPanel>
                <TextBlock Margin="0,4,0,0" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Subtitle}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="16,6,0,0" VerticalAlignment="Top" Orientation="Horizontal">
                <c:Segmented Margin="0,0,10,0" Items="Tweaks|Find bad tweaks" Label="Show" SelectedIndex="{Binding Tab, Mode=TwoWay}" />
                <ui:Button
                    Appearance="Secondary"
                    AutomationProperties.Name="Scan"
                    Command="{Binding ScanCommand}"
                    Content="Scan"
                    Icon="{ui:SymbolIcon ArrowClockwise24}" />
            </StackPanel>
        </Grid>

        <c:StepBar Grid.Row="1" Margin="0,16,0,10" Captions="{Binding StepCaptions}" Current="{Binding Step}" />

        <!--  Tweaks tab tools: search, sort, List | Cards, chips, presets, Expert switch  -->
        <StackPanel Grid.Row="2" Visibility="{Binding IsTweaksTab, Converter={StaticResource BoolToVis}}">
            <Grid Margin="0,0,0,8" Visibility="{Binding HasScanned, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="180" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBox
                    MinWidth="240"
                    MaxWidth="420"
                    HorizontalAlignment="Left"
                    AutomationProperties.Name="Search tweaks"
                    Icon="{ui:SymbolIcon Search24}"
                    PlaceholderText="Search tweaks…"
                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Sort:" />
                    <ComboBox
                        MinWidth="150"
                        AutomationProperties.Name="Sort tweaks by"
                        ItemsSource="{Binding SortOptions}"
                        SelectedIndex="{Binding SortIndex, Mode=TwoWay}" />
                </StackPanel>
                <c:Segmented Grid.Column="2" Margin="12,0,0,0" Items="List|Cards" Label="View as" SelectedIndex="{Binding ViewChoice, Mode=TwoWay}" />
            </Grid>

            <ItemsControl
                Margin="0,0,0,4"
                AutomationProperties.Name="Categories"
                Focusable="False"
                ItemsSource="{Binding Chips}"
                KeyboardNavigation.DirectionalNavigation="Cycle"
                KeyboardNavigation.TabNavigation="Once"
                Visibility="{Binding HasScanned, Converter={StaticResource BoolToVis}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:ChipItem}">
                        <RadioButton
                            AutomationProperties.Name="{Binding AutomationName}"
                            Content="{Binding Label}"
                            GroupName="TweakChips"
                            IsChecked="{Binding IsSelected, Mode=TwoWay}"
                            Style="{StaticResource TweakChip}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <WrapPanel VerticalAlignment="Center">
                    <TextBlock Margin="0,0,10,0" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Presets:" />
                    <ItemsControl Focusable="False" ItemsSource="{Binding Presets}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ui:Button
                                    Margin="0,0,8,4"
                                    Appearance="Secondary"
                                    AutomationProperties.HelpText="{Binding Description}"
                                    AutomationProperties.Name="{Binding Title, StringFormat='{}{0} preset: see what it would tick'}"
                                    Click="OnPresetClick"
                                    Content="{Binding Title}"
                                    ToolTip="{Binding Description}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ui:Button
                        Margin="0,0,8,4"
                        Appearance="Transparent"
                        AutomationProperties.Name="Untick everything"
                        Command="{Binding ClearSelectionCommand}"
                        Content="Clear" />
                </WrapPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="Expert mode" />
                    <ui:ToggleSwitch AutomationProperties.Name="Expert mode: show risky tweaks" IsChecked="{Binding ExpertMode, Mode=TwoWay}" />
                </StackPanel>
            </Grid>

            <!--  Preset "what will change" popover: nothing is ticked until "Tick these"  -->
            <Popup
                x:Name="PresetPopup"
                AllowsTransparency="True"
                Closed="OnPresetPopupClosed"
                IsOpen="{Binding IsPresetPopoverOpen, Mode=TwoWay}"
                Opened="OnPresetPopupOpened"
                Placement="Bottom"
                PopupAnimation="Fade"
                StaysOpen="False">
                <Border
                    MaxWidth="440"
                    Margin="0,4,8,8"
                    Padding="16,14"
                    Background="{DynamicResource ApplicationBackgroundBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    KeyDown="OnPresetPopupKeyDown">
                    <StackPanel AutomationProperties.Name="{Binding PresetPreview.AutomationName}">
                        <TextBlock
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="{Binding PresetPreview.Title, StringFormat='What {0} will change'}"
                            TextWrapping="Wrap" />
                        <TextBlock Margin="0,2,0,8" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding PresetPreview.CountText}" TextWrapping="Wrap" />
                        <ItemsControl Focusable="False" ItemsSource="{Binding PresetPreview.Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:PresetPreviewItem}">
                                    <DockPanel Margin="0,0,0,4" AutomationProperties.Name="{Binding AutomationName}">
                                        <c:BadgePill Margin="8,0,0,0" DockPanel.Dock="Right" ShowDot="False" Text="{Binding Badge.Text}" Tone="{Binding Badge.Tone}" />
                                        <TextBlock VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Title}" TextWrapping="Wrap" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding PresetPreview.MoreText}" Visibility="{Binding PresetPreview.HasMore, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Margin="0,8,0,10" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding PresetPreview.Notes}" TextWrapping="Wrap" />
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <ui:Button
                                Margin="0,0,8,0"
                                Appearance="Secondary"
                                AutomationProperties.Name="Cancel: tick nothing"
                                Command="{Binding CancelPresetCommand}"
                                Content="Cancel" />
                            <ui:Button
                                x:Name="PresetConfirmButton"
                                Appearance="Primary"
                                AutomationProperties.Name="Tick these changes. Nothing changes until you preview and confirm."
                                Command="{Binding ConfirmPresetCommand}"
                                Content="Tick these"
                                IsEnabled="{Binding PresetPreview.CanFill}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Popup>
        </StackPanel>

        <!--  Expert warning and scan notes  -->
        <StackPanel Grid.Row="3">
            <ui:InfoBar
                Title="Expert mode is on"
                Margin="0,0,0,8"
                IsClosable="False"
                IsOpen="True"
                Message="Risky tweaks can now be picked (IPv6, the telemetry service, provisioned apps). Each still shows its warning and can be undone. They're never in presets or Optimize everything, and nothing that turns off security, updates or anti-cheat is ever offered."
                Severity="Warning"
                Visibility="{Binding ShowExpertWarning, Converter={StaticResource BoolToVis}}" />
            <ItemsControl Focusable="False" ItemsSource="{Binding Notes}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="2,0,0,6">
                            <ui:SymbolIcon Margin="0,1,8,0" VerticalAlignment="Top" DockPanel.Dock="Left" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Symbol="Info16" />
                            <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding}" TextWrapping="Wrap" />
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!--  Ready / scanning  -->
        <Border
            Grid.Row="4"
            Padding="0"
            VerticalAlignment="Top"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Visibility="{Binding HasScanned, Converter={StaticResource NotBoolToVis}}">
            <StackPanel>
                <c:EmptyState
                    ActionIcon="ScanDash24"
                    ActionText="Scan now"
                    Icon="Wrench24"
                    Message="PC Tidy reads each setting's current value (nothing changes), shows what really helps and why, and finds harmful leftovers from old optimizers."
                    Title="Scan to see your tweaks"
                    ActionClick="OnScanClick"
                    Visibility="{Binding IsScanning, Converter={StaticResource NotBoolToVis}}" />
                <StackPanel Margin="28,24" Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <ui:Button
                            VerticalAlignment="Center"
                            Appearance="Secondary"
                            AutomationProperties.Name="Stop scanning"
                            Command="{Binding CancelScanCommand}"
                            Content="Stop"
                            DockPanel.Dock="Right" />
                        <ui:ProgressRing Width="36" Height="36" Margin="0,0,16,0" IsIndeterminate="True" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="Reading your settings…" />
                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding ScanMessage}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <!--  List view (and the Find bad tweaks tab)  -->
        <ListBox
            x:Name="RowsList"
            Grid.Row="4"
            AutomationProperties.Name="Tweaks and findings"
            Background="Transparent"
            BorderThickness="0"
            HorizontalContentAlignment="Stretch"
            ItemsSource="{Binding Rows}"
            KeyboardNavigation.TabNavigation="Continue"
            ScrollViewer.CanContentScroll="True"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            VirtualizingPanel.IsVirtualizing="True"
            VirtualizingPanel.ScrollUnit="Pixel"
            VirtualizingPanel.VirtualizationMode="Recycling"
            Visibility="{Binding ShowList, Converter={StaticResource BoolToVis}}">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="MaxWidth" Value="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}, Converter={StaticResource RowMaxWidth}}" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>

        <!--  Cards view: 2 or 3 columns on wide windows (ResponsiveGrid), one per section  -->
        <ScrollViewer
            x:Name="CardsScroller"
            Grid.Row="4"
            AutomationProperties.Name="Tweaks as cards"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto"
            Visibility="{Binding ShowCards, Converter={StaticResource BoolToVis}}">
            <ItemsControl Margin="0,0,6,0" Focusable="False" ItemsSource="{Binding Sections}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:TweakSection}">
                        <StackPanel>
                            <ContentControl Content="{Binding Header}" Focusable="False" />
                            <ListBox
                                AutomationProperties.Name="{Binding Header.Title}"
                                Background="Transparent"
                                BorderThickness="0"
                                Focusable="False"
                                ItemTemplate="{StaticResource TweakCard}"
                                ItemsSource="{Binding Rows}"
                                KeyboardNavigation.TabNavigation="Continue">
                                <ListBox.Template>
                                    <ControlTemplate TargetType="ListBox">
                                        <ItemsPresenter />
                                    </ControlTemplate>
                                </ListBox.Template>
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <c:ResponsiveGrid Gap="12" MaxColumns="3" MinItemWidth="300" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Focusable" Value="False" />
                                        <Setter Property="AutomationProperties.Name" Value="{Binding CardAutomationName}" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <ContentPresenter />
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <c:EmptyState
            Grid.Row="4"
            Icon="CheckmarkCircle24"
            Message="{Binding EmptyText}"
            Title="All tidy"
            Visibility="{Binding ShowEmpty, Converter={StaticResource BoolToVis}}" />

        <!--  Sticky bottom bar  -->
        <Border
            Grid.Row="5"
            Margin="0,10,0,0"
            Padding="20,12"
            Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Visibility="{Binding HasScanned, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding SelectionText}" TextTrimming="CharacterEllipsis" />
                    <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding SelectionCaption}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:Button
                        Height="40"
                        Margin="0,0,8,0"
                        Appearance="Secondary"
                        AutomationProperties.Name="Simulate: see what would happen, change nothing"
                        flow:RunGate.DisableWhileBusy="True"
                        Command="{Binding SimulateCommand}"
                        Content="Simulate"
                        Icon="{ui:SymbolIcon Beaker24}" />
                    <ui:Button
                        Height="40"
                        MinWidth="150"
                        Appearance="Primary"
                        AutomationProperties.Name="Preview and apply the ticked changes"
                        flow:RunGate.DisableWhileBusy="True"
                        Command="{Binding PreviewCommand}"
                        Content="Preview changes"
                        FontWeight="SemiBold"
                        Icon="{ui:SymbolIcon Checkmark24}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
