<UserControl
    x:Class="PcTidy.Features.Tweaks.UI.TweaksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:PcTidy.UI.Controls;assembly=PcTidy.UI"
    xmlns:local="clr-namespace:PcTidy.Features.Tweaks.UI"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    AutomationProperties.Name="Tweaks">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:InverseBoolToVisibilityConverter x:Key="NotBoolToVis" />
        <local:RowMaxWidthConverter x:Key="RowMaxWidth" />

        <DataTemplate DataType="{x:Type local:TweakHeaderRow}">
            <StackPanel Margin="2,14,0,8" AutomationProperties.Name="{Binding AutomationName}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Title}" />
                    <TextBlock Margin="10,2,0,0" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding CountText}" />
                </StackPanel>
                <TextBlock Margin="0,2,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Description}" TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:TweakItemRow}">
            <Border
                Margin="0,0,0,6"
                Padding="14,10,10,10"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <CheckBox
                        Margin="0,1,6,0"
                        VerticalAlignment="Top"
                        AutomationProperties.Name="{Binding AutomationName}"
                        IsChecked="{Binding IsChecked}"
                        IsEnabled="{Binding IsSelectable}"
                        Visibility="{Binding CheckBoxVisibility}" />
                    <StackPanel Grid.Column="1" Opacity="{Binding TextOpacity}">
                        <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Title}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,2,0,0" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding SecondLine}" TextWrapping="Wrap" />
                        <ItemsControl Margin="0,6,0,0" Focusable="False" ItemsSource="{Binding Tags}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <c:BadgePill Margin="0,0,6,4" ShowDot="False" Text="{Binding Text}" Tone="{Binding Tone}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!--  Details: exact registry paths, Windows default, undo, sources  -->
                        <StackPanel Margin="0,6,0,0" Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="WHAT HAPPENS" />
                            <TextBlock Margin="0,2,0,8" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding WhatHappens}" TextWrapping="Wrap" />
                            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="DETAILS" />
                            <TextBlock
                                Margin="0,2,0,8"
                                FontFamily="Cascadia Mono, Consolas"
                                FontSize="12"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="{Binding DetailsText}"
                                TextWrapping="Wrap" />
                            <Button
                                Margin="0,0,0,6"
                                AutomationProperties.Name="{Binding SettingsLink.AutomationName}"
                                Command="{Binding OpenLinkCommand}"
                                CommandParameter="{Binding SettingsLink}"
                                Content="{Binding SettingsLink.Label}"
                                Style="{DynamicResource LinkButton}"
                                Visibility="{Binding HasSettingsLink, Converter={StaticResource BoolToVis}}" />
                            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="SOURCES" />
                            <ItemsControl Focusable="False" ItemsSource="{Binding Sources}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button
                                            Margin="0,2,14,0"
                                            AutomationProperties.Name="{Binding AutomationName}"
                                            Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Content="{Binding Label}"
                                            Style="{DynamicResource LinkButton}"
                                            ToolTip="{Binding Target}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Top" Orientation="Horizontal">
                        <c:BadgePill Margin="0,0,6,0" Text="{Binding Status.Text}" Tone="{Binding Status.Tone}" />
                        <c:BadgePill Margin="0,0,4,0" Text="{Binding Verdict.Text}" Tone="{Binding Verdict.Tone}" />
                        <ui:Button
                            Padding="6"
                            Appearance="Transparent"
                            AutomationProperties.Name="Show or hide details"
                            Command="{Binding ToggleDetailsCommand}"
                            Icon="{ui:SymbolIcon ChevronDown24}"
                            ToolTip="Details, exact registry paths and sources" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="32,16,32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="Tweaks" />
                <TextBlock Margin="0,4,0,0" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Subtitle}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="16,6,0,0" VerticalAlignment="Top" Orientation="Horizontal">
                <c:Segmented Margin="0,0,10,0" Items="Tweaks|Find bad tweaks" Label="Show" SelectedIndex="{Binding Tab, Mode=TwoWay}" />
                <ui:Button
                    Appearance="Secondary"
                    AutomationProperties.Name="Scan"
                    Command="{Binding ScanCommand}"
                    Content="Scan"
                    Icon="{ui:SymbolIcon ArrowClockwise24}" />
            </StackPanel>
        </Grid>

        <c:StepBar Grid.Row="1" Margin="0,16,0,10" Captions="{Binding StepCaptions}" Current="{Binding Step}" />

        <!--  Presets row + Expert switch (Tweaks tab only)  -->
        <Grid Grid.Row="2" Margin="0,0,0,8" Visibility="{Binding IsTweaksTab, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Margin="0,0,10,0" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Presets:" />
                <ItemsControl Focusable="False" ItemsSource="{Binding Presets}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ui:Button
                                Margin="0,0,8,4"
                                Appearance="Secondary"
                                AutomationProperties.HelpText="{Binding Description}"
                                AutomationProperties.Name="{Binding Title, StringFormat='Tick the {0} preset'}"
                                Command="{Binding DataContext.ApplyPresetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Content="{Binding Title}"
                                ToolTip="{Binding Description}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ui:Button
                    Margin="0,0,8,4"
                    Appearance="Transparent"
                    AutomationProperties.Name="Untick everything"
                    Command="{Binding ClearSelectionCommand}"
                    Content="Clear" />
            </WrapPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="Expert mode" />
                <ui:ToggleSwitch AutomationProperties.Name="Expert mode: show risky tweaks" IsChecked="{Binding ExpertMode, Mode=TwoWay}" />
            </StackPanel>
        </Grid>

        <!--  Expert warning and scan notes  -->
        <StackPanel Grid.Row="3">
            <ui:InfoBar
                Title="Expert mode is on"
                Margin="0,0,0,8"
                IsClosable="False"
                IsOpen="True"
                Message="Risky tweaks can now be picked (search indexing, IPv6, fullscreen optimizations, the telemetry service). Each still shows its warning and can be undone. They're never in presets or Optimize everything, and nothing that turns off security, updates or anti-cheat is ever offered."
                Severity="Warning"
                Visibility="{Binding ShowExpertWarning, Converter={StaticResource BoolToVis}}" />
            <ItemsControl Focusable="False" ItemsSource="{Binding Notes}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2,0,0,6" Orientation="Horizontal">
                            <ui:SymbolIcon Margin="0,1,8,0" VerticalAlignment="Top" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Symbol="Info16" />
                            <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!--  Ready / scanning / list  -->
        <Border
            Grid.Row="4"
            Padding="0"
            VerticalAlignment="Top"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Visibility="{Binding HasScanned, Converter={StaticResource NotBoolToVis}}">
            <StackPanel>
                <c:EmptyState
                    ActionIcon="ScanDash24"
                    ActionText="Scan now"
                    Icon="Wrench24"
                    Message="PC Tidy reads each setting's current value (nothing changes), shows what really helps and why, and finds harmful leftovers from old optimizers."
                    Title="Scan to see your tweaks"
                    ActionClick="OnScanClick"
                    Visibility="{Binding IsScanning, Converter={StaticResource NotBoolToVis}}" />
                <StackPanel Margin="28,24" Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <ui:Button
                            VerticalAlignment="Center"
                            Appearance="Secondary"
                            AutomationProperties.Name="Stop scanning"
                            Command="{Binding CancelScanCommand}"
                            Content="Stop"
                            DockPanel.Dock="Right" />
                        <ui:ProgressRing Width="36" Height="36" Margin="0,0,16,0" IsIndeterminate="True" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="Reading your settings…" />
                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding ScanMessage}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <ListBox
            x:Name="RowsList"
            Grid.Row="4"
            AutomationProperties.Name="Tweaks and findings"
            Background="Transparent"
            BorderThickness="0"
            HorizontalContentAlignment="Stretch"
            ItemsSource="{Binding Rows}"
            ScrollViewer.CanContentScroll="True"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            VirtualizingPanel.IsVirtualizing="True"
            VirtualizingPanel.ScrollUnit="Pixel"
            VirtualizingPanel.VirtualizationMode="Recycling"
            Visibility="{Binding HasScanned, Converter={StaticResource BoolToVis}}">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="MaxWidth" Value="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}, Converter={StaticResource RowMaxWidth}}" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>
        <c:EmptyState
            Grid.Row="4"
            Icon="CheckmarkCircle24"
            Message="{Binding EmptyText}"
            Title="All tidy"
            Visibility="{Binding ShowEmpty, Converter={StaticResource BoolToVis}}" />

        <!--  Sticky bottom bar  -->
        <Border
            Grid.Row="5"
            Margin="0,10,0,0"
            Padding="20,12"
            Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Visibility="{Binding HasScanned, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding SelectionText}" TextTrimming="CharacterEllipsis" />
                    <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding SelectionCaption}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:Button
                        Height="40"
                        Margin="0,0,8,0"
                        Appearance="Secondary"
                        AutomationProperties.Name="Simulate: see what would happen, change nothing"
                        Command="{Binding SimulateCommand}"
                        Content="Simulate"
                        Icon="{ui:SymbolIcon Beaker24}" />
                    <ui:Button
                        Height="40"
                        MinWidth="150"
                        Appearance="Primary"
                        AutomationProperties.Name="Preview and apply the ticked changes"
                        Command="{Binding PreviewCommand}"
                        Content="Preview changes"
                        FontWeight="SemiBold"
                        Icon="{ui:SymbolIcon Checkmark24}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
