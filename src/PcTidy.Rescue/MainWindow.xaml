<Window
    x:Class="PcTidy.Rescue.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PcTidy.Rescue"
    Title="PC Tidy Rescue"
    Width="1080"
    Height="680"
    MinWidth="820"
    MinHeight="480"
    Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
    FontFamily="Segoe UI"
    FontSize="13"
    Icon="Assets/PcTidy.ico"
    WindowStartupLocation="CenterScreen">
    <!--  Deliberately plain WPF (system colours, no theme library): Rescue must start even when everything else is broken.  -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="MinWidth" Value="90" />
        </Style>
        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock FontSize="22" FontWeight="SemiBold" Text="PC Tidy Rescue" />
            <TextBlock Style="{StaticResource Muted}" Text="Undo what PC Tidy changed, even if PC Tidy itself won't start. Nothing is changed until you pick a run and confirm." />
        </StackPanel>

        <!--  Data folder  -->
        <Border
            Grid.Row="1"
            Margin="0,0,0,12"
            Padding="10"
            BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
            BorderThickness="1"
            CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Margin="0,0,10,0"
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Text="Data folder" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBox
                        AutomationProperties.Name="Data folder"
                        BorderThickness="0"
                        IsReadOnly="True"
                        Text="{Binding DataRoot, Mode=OneWay}" />
                    <TextBlock Style="{StaticResource Muted}" Text="{Binding HowFound}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button
                        AutomationProperties.Name="Browse for a data folder"
                        Command="{Binding BrowseCommand}"
                        Content="Browse…" />
                    <Button
                        Margin="0"
                        AutomationProperties.Name="Refresh the list of runs"
                        Command="{Binding RefreshCommand}"
                        Content="Refresh" />
                </StackPanel>
            </Grid>
        </Border>

        <!--  Runs | details  -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" MinWidth="360" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="6*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <Grid>
                <ListView
                    x:Name="RunList"
                    AutomationProperties.Name="Runs, newest first"
                    ItemsSource="{Binding Runs}"
                    SelectedItem="{Binding Selected}"
                    SelectionMode="Single"
                    VirtualizingPanel.IsVirtualizing="True"
                    VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn
                                Width="130"
                                DisplayMemberBinding="{Binding When}"
                                Header="Date" />
                            <GridViewColumn
                                Width="190"
                                DisplayMemberBinding="{Binding Title}"
                                Header="Run" />
                            <GridViewColumn
                                Width="140"
                                DisplayMemberBinding="{Binding StatusText}"
                                Header="Status" />
                            <GridViewColumn
                                Width="55"
                                DisplayMemberBinding="{Binding ItemCount}"
                                Header="Items" />
                        </GridView>
                    </ListView.View>
                </ListView>
                <TextBlock
                    Margin="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False"
                    Text="No runs found in this data folder.">
                    <TextBlock.Style>
                        <Style BasedOn="{StaticResource Muted}" TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasRuns}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <Grid Grid.Column="2" Visibility="{Binding HasSelection, Converter={StaticResource Visible}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock
                        FontSize="17"
                        FontWeight="SemiBold"
                        Text="{Binding Selected.Title}"
                        TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource Muted}">
                        <Run Text="{Binding Selected.When, Mode=OneWay}" />
                        <Run Text=" · " />
                        <Run Text="{Binding Selected.StatusText, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock
                        Margin="0,8,0,0"
                        Text="{Binding Selected.Summary}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Margin="0,4,0,0"
                        Text="{Binding Selected.QuarantineText}"
                        TextWrapping="Wrap" />
                    <TextBox
                        Margin="0,4,0,0"
                        AutomationProperties.Name="Run id"
                        BorderThickness="0"
                        Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                        IsReadOnly="True"
                        Text="{Binding Selected.RunId, Mode=OneWay, StringFormat='Run id: {0}'}" />
                </StackPanel>

                <WrapPanel Grid.Row="1" Margin="0,10,0,10">
                    <Button
                        AutomationProperties.Name="Undo the selected run"
                        Command="{Binding UndoCommand}"
                        Content="Undo"
                        FontWeight="SemiBold" />
                    <Button
                        AutomationProperties.Name="Resume the interrupted run"
                        Command="{Binding ResumeCommand}"
                        Content="Resume"
                        Visibility="{Binding Selected.IsInterrupted, Converter={StaticResource Visible}}" />
                    <Button
                        AutomationProperties.Name="Roll back the interrupted run"
                        Command="{Binding RollbackCommand}"
                        Content="Roll back"
                        Visibility="{Binding Selected.IsInterrupted, Converter={StaticResource Visible}}" />
                    <Button
                        AutomationProperties.Name="Restore everything in quarantine for this run"
                        Command="{Binding RestoreQuarantineCommand}"
                        Content="Restore everything in quarantine for this run" />
                </WrapPanel>

                <ListView
                    Grid.Row="2"
                    AutomationProperties.Name="Steps of the selected run"
                    ItemsSource="{Binding SelectedSteps}"
                    VirtualizingPanel.IsVirtualizing="True"
                    VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn
                                Width="40"
                                DisplayMemberBinding="{Binding Number}"
                                Header="#" />
                            <GridViewColumn
                                Width="300"
                                DisplayMemberBinding="{Binding Description}"
                                Header="Change" />
                            <GridViewColumn
                                Width="110"
                                DisplayMemberBinding="{Binding Status}"
                                Header="Status" />
                            <GridViewColumn
                                Width="220"
                                DisplayMemberBinding="{Binding Message}"
                                Header="Note" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Grid>

        <!--  Status  -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ProgressBar
                Width="120"
                Height="6"
                Margin="0,0,10,0"
                VerticalAlignment="Center"
                IsIndeterminate="True"
                Visibility="{Binding IsBusy, Converter={StaticResource Visible}}" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
                <TextBlock
                    Style="{StaticResource Muted}"
                    Text="{Binding ProgressText}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
            </StackPanel>
            <Button
                Grid.Column="2"
                Margin="0"
                AutomationProperties.Name="Open the folder with Rescue's log files"
                Command="{Binding OpenLogsCommand}"
                Content="Open log folder" />
        </Grid>
    </Grid>
</Window>
