<UserControl
    x:Class="PcTidy.Features.Measure.UI.MeasurePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:PcTidy.UI.Controls;assembly=PcTidy.UI"
    xmlns:local="clr-namespace:PcTidy.Features.Measure.UI"
    xmlns:m="clr-namespace:PcTidy.Features.Measure"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    AutomationProperties.Name="Measure"
    FontFamily="{StaticResource TidyText}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <DataTemplate x:Key="BulletTemplate">
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Secondary}" Text="•" />
                <TextBlock Grid.Column="1" Style="{StaticResource Secondary}" Text="{Binding}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="StatLineTemplate">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Secondary}" Text="{Binding Label}" />
                <TextBlock Grid.Column="1" Margin="12,0,0,0" Style="{StaticResource BodyStrong}" Text="{Binding Value}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="RunTemplate">
            <Border Margin="0,0,0,8" Style="{StaticResource InnerTile}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{Binding FileName}" ToolTip="{Binding FileName}" />
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding ProcessLine}" />
                        <ComboBox
                            Margin="0,6,0,0"
                            HorizontalAlignment="Left"
                            MinWidth="200"
                            AutomationProperties.Name="{Binding ProcessPickerName}"
                            ItemsSource="{Binding ProcessChoices}"
                            SelectedIndex="{Binding SelectedProcessIndex, Mode=TwoWay}"
                            Visibility="{Binding HasProcessChoice, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Margin="0,4,0,0" Style="{StaticResource Secondary}" Text="{Binding StatsLine}" />
                        <TextBlock Margin="0,4,0,0" Style="{StaticResource Caption}" Text="{Binding NotesLine}" Visibility="{Binding HasNotes, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <ui:Button
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        VerticalAlignment="Top"
                        Appearance="Transparent"
                        AutomationProperties.Name="{Binding RemoveName}"
                        Command="{Binding RemoveCommand}"
                        Icon="{ui:SymbolIcon Dismiss24}"
                        ToolTip="Remove this run" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel Margin="{StaticResource TidyPageMargin}" MaxWidth="1200" HorizontalAlignment="Stretch">
        <!--  Title  -->
        <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource PageTitle}" Text="Measure" />
            <c:BadgePill Margin="12,6,0,0" Text="Reads files only" Tone="Neutral" />
        </StackPanel>
        <TextBlock Style="{StaticResource PageSubtitle}" Text="{x:Static m:MeasureText.Subtitle}" />

        <!--  Linked History run ("Check if this helped")  -->
        <Border Margin="0,12,0,0" Style="{StaticResource HeroCard}" Visibility="{Binding HasLinkedRun, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Style="{StaticResource Body}" Text="{Binding LinkedRunText}" />
                <ui:Button
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    Appearance="Secondary"
                    AutomationProperties.Name="Open History"
                    Command="{Binding OpenHistoryCommand}"
                    Content="Open History"
                    Icon="{ui:SymbolIcon History24}" />
            </Grid>
        </Border>

        <!--  Step 1: Record  -->
        <Border Margin="0,16,0,0" Style="{StaticResource TidyCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitle}" Text="1. Record" />
                <TextBlock Margin="0,4,0,8" Style="{StaticResource Secondary}" Text="Use a free tool to record frame times. PC Tidy doesn't record anything itself." />
                <ItemsControl Focusable="False" ItemTemplate="{StaticResource BulletTemplate}" ItemsSource="{Binding RecordSteps}" />
                <TextBlock Margin="0,12,0,6" Style="{StaticResource BodyStrong}" Text="Free tools" />
                <ItemsControl Focusable="False" ItemsSource="{Binding Tools}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <c:ResponsiveGrid Gap="12" MaxColumns="4" MinItemWidth="200" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource InnerTile}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CardTitle}" Text="{Binding Name}" />
                                    <TextBlock Margin="0,2,0,6" Style="{StaticResource Caption}" Text="{Binding What}" />
                                    <Button
                                        AutomationProperties.Name="{Binding Name, StringFormat='Open the {0} web page'}"
                                        Command="{Binding DataContext.OpenToolCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        Content="Open web page"
                                        Style="{StaticResource LinkButton}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Margin="0,8,0,0" Style="{StaticResource Caption}" Text="{x:Static m:MeasureText.LicenceNote}" />
            </StackPanel>
        </Border>

        <!--  Step 2: Import  -->
        <Border Margin="0,16,0,0" Style="{StaticResource TidyCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitle}" Text="2. Import" />
                <TextBlock Margin="0,4,0,10" Style="{StaticResource Secondary}" Text="{x:Static m:MeasureText.ImportHelp}" />
                <WrapPanel>
                    <TextBlock Margin="0,0,8,6" VerticalAlignment="Center" Style="{StaticResource Body}" Text="Add files to" />
                    <c:Segmented
                        Margin="0,0,12,6"
                        Items="Before|After|Before again"
                        Label="Add files to"
                        SelectedIndex="{Binding TargetIndex, Mode=TwoWay}" />
                    <ui:Button
                        x:Name="PickButton"
                        Margin="0,0,0,6"
                        Appearance="Primary"
                        AutomationProperties.Name="Pick recording files"
                        Click="OnPickFiles"
                        Content="Pick files"
                        Icon="{ui:SymbolIcon FolderOpen24}"
                        IsEnabled="{Binding IsImporting, Converter={x:Static local:InverseBool.Instance}}"
                        />
                </WrapPanel>
                <Border
                    x:Name="DropZone"
                    Margin="0,6,0,0"
                    Padding="16"
                    AllowDrop="True"
                    AutomationProperties.HelpText="Drag CSV or JSON recordings here"
                    AutomationProperties.Name="Drop area for recording files"
                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    DragOver="OnDragOver"
                    Drop="OnDrop">
                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                        <ui:SymbolIcon Margin="0,0,8,0" FontSize="20" Symbol="ArrowDownload24" />
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource Secondary}" Text="Drop recordings here" />
                    </StackPanel>
                </Border>
                <ui:ProgressRing
                    Width="20"
                    Height="20"
                    Margin="0,8,0,0"
                    HorizontalAlignment="Left"
                    AutomationProperties.Name="Reading files"
                    IsIndeterminate="True"
                    Visibility="{Binding IsImporting, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock
                    Margin="0,8,0,0"
                    AutomationProperties.LiveSetting="Polite"
                    Style="{StaticResource Secondary}"
                    Text="{Binding ImportStatus}"
                    Visibility="{Binding HasImportStatus, Converter={StaticResource BoolToVisibility}}" />

                <c:ResponsiveGrid Margin="0,12,0,0" Gap="16" MaxColumns="3" MinItemWidth="280">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,6" Style="{StaticResource BodyStrong}" Text="Before" />
                        <ItemsControl Focusable="False" ItemTemplate="{StaticResource RunTemplate}" ItemsSource="{Binding BeforeRuns}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Margin="0,0,0,6" Style="{StaticResource BodyStrong}" Text="After" />
                        <ItemsControl Focusable="False" ItemTemplate="{StaticResource RunTemplate}" ItemsSource="{Binding AfterRuns}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Margin="0,0,0,6" Style="{StaticResource BodyStrong}" Text="Before again (optional)" />
                        <ItemsControl Focusable="False" ItemTemplate="{StaticResource RunTemplate}" ItemsSource="{Binding AgainRuns}" />
                    </StackPanel>
                </c:ResponsiveGrid>
            </StackPanel>
        </Border>

        <!--  Step 3: Compare  -->
        <Border Margin="0,16,0,0" Style="{StaticResource TidyCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitle}" Text="3. Compare" />
                <WrapPanel Margin="0,8,0,0">
                    <c:BadgePill x:Name="VerdictChip" Margin="0,0,12,4" Text="{Binding VerdictText}" Tone="{Binding VerdictTone}" />
                </WrapPanel>
                <TextBlock Margin="0,6,0,0" AutomationProperties.LiveSetting="Polite" Style="{StaticResource Body}" Text="{Binding Headline}" />
                <TextBlock Margin="0,4,0,0" Style="{StaticResource Caption}" Text="{Binding BasisText}" />
                <TextBlock Margin="0,4,0,0" Style="{StaticResource Caption}" Text="{Binding FirstVersionNote}" />

                <c:ResponsiveGrid Margin="0,12,0,0" Gap="16" MaxColumns="3" MinItemWidth="260">
                    <Border Style="{StaticResource StatTile}">
                        <StackPanel>
                            <TextBlock Margin="0,0,0,6" Style="{StaticResource CardTitle}" Text="Before" />
                            <ItemsControl Focusable="False" ItemTemplate="{StaticResource StatLineTemplate}" ItemsSource="{Binding BeforeColumn}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatTile}">
                        <StackPanel>
                            <TextBlock Margin="0,0,0,6" Style="{StaticResource CardTitle}" Text="After" />
                            <ItemsControl Focusable="False" ItemTemplate="{StaticResource StatLineTemplate}" ItemsSource="{Binding AfterColumn}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatTile}" Visibility="{Binding HasAgain, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Margin="0,0,0,6" Style="{StaticResource CardTitle}" Text="Before again" />
                            <ItemsControl Focusable="False" ItemTemplate="{StaticResource StatLineTemplate}" ItemsSource="{Binding AgainColumn}" />
                        </StackPanel>
                    </Border>
                </c:ResponsiveGrid>

                <TextBlock Margin="0,10,0,0" Style="{StaticResource Secondary}" Text="{Binding DriftNote}" Visibility="{Binding HasDriftNote, Converter={StaticResource BoolToVisibility}}" />
                <StackPanel Margin="0,10,0,0" Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Margin="0,0,0,4" Style="{StaticResource BodyStrong}" Text="Worth knowing" />
                    <ItemsControl Focusable="False" ItemTemplate="{StaticResource BulletTemplate}" ItemsSource="{Binding Warnings}" />
                </StackPanel>

                <!--  Keep / Undo: text only, pointing to History  -->
                <Border Margin="0,12,0,0" Style="{StaticResource InnerTile}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Body}" Text="{Binding Suggestion}" />
                            <TextBlock Margin="0,2,0,0" Style="{StaticResource Caption}" Text="{x:Static m:MeasureText.KeepUndoNote}" />
                        </StackPanel>
                        <ui:Button
                            Grid.Column="1"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Appearance="Secondary"
                            AutomationProperties.Name="Open History to keep or undo"
                            Command="{Binding OpenHistoryCommand}"
                            Content="{Binding HistoryButtonText}"
                            Icon="{ui:SymbolIcon History24}" />
                    </Grid>
                </Border>

                <!--  Conditions  -->
                <TextBlock Margin="0,16,0,4" Style="{StaticResource BodyStrong}" Text="Conditions" />
                <TextBlock Margin="0,0,0,8" Style="{StaticResource Caption}" Text="Tick what stayed the same for every run, and add notes. They are saved with the comparison." />
                <ItemsControl Focusable="False" ItemsSource="{Binding Conditions}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <c:ResponsiveGrid Gap="12" MaxColumns="2" MinItemWidth="320" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <CheckBox AutomationProperties.Name="{Binding CheckName}" Content="{Binding Label}" IsChecked="{Binding Same, Mode=TwoWay}" />
                                <ui:TextBox
                                    Margin="0,4,0,0"
                                    AutomationProperties.Name="{Binding NoteName}"
                                    MaxLength="200"
                                    PlaceholderText="{Binding Hint}"
                                    Text="{Binding Note, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!--  What this does not prove; how the numbers work  -->
                <Expander Margin="0,16,0,0" AutomationProperties.Name="What this does not prove" Header="What this does not prove" IsExpanded="True">
                    <ItemsControl Margin="0,6,0,0" Focusable="False" ItemTemplate="{StaticResource BulletTemplate}" ItemsSource="{Binding DoesNotProve}" />
                </Expander>
                <Expander Margin="0,8,0,0" AutomationProperties.Name="How the numbers are worked out" Header="How the numbers are worked out">
                    <ItemsControl Margin="0,6,0,0" Focusable="False" ItemTemplate="{StaticResource BulletTemplate}" ItemsSource="{Binding Definitions}" />
                </Expander>

                <!--  Save  -->
                <WrapPanel Margin="0,16,0,0">
                    <ui:TextBox
                        Width="280"
                        Margin="0,0,8,6"
                        AutomationProperties.Name="What did you test"
                        MaxLength="120"
                        PlaceholderText="What did you test? (e.g. Game Mode on)"
                        Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <ui:Button
                        Margin="0,0,8,6"
                        Appearance="Primary"
                        AutomationProperties.Name="Save comparison"
                        Command="{Binding SaveCommand}"
                        Content="Save comparison"
                        Icon="{ui:SymbolIcon Save24}" />
                    <ui:Button
                        Margin="0,0,8,6"
                        Appearance="Secondary"
                        AutomationProperties.Name="Start a new comparison"
                        Command="{Binding NewComparisonCommand}"
                        Content="New comparison"
                        Icon="{ui:SymbolIcon Add24}" />
                    <TextBlock Margin="0,0,0,6" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" Style="{StaticResource Secondary}" Text="{Binding SaveStatus}" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <!--  Saved comparisons  -->
        <Border Margin="0,16,0,0" Style="{StaticResource TidyCard}" Visibility="{Binding HasSaved, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitle}" Text="Saved comparisons" />
                <ItemsControl Margin="0,8,0,0" Focusable="False" ItemsSource="{Binding Saved}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CardTitle}" Text="{Binding Title}" />
                                    <TextBlock Style="{StaticResource Caption}" Text="{Binding Line}" />
                                </StackPanel>
                                <ui:Button
                                    Grid.Column="1"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center"
                                    Appearance="Secondary"
                                    AutomationProperties.Name="{Binding OpenName}"
                                    Command="{Binding DataContext.OpenSavedCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"
                                    Content="Open" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
