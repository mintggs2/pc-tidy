<ui:FluentWindow
    x:Class="PcTidy.Setup.SetupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="PC Tidy Setup"
    Width="640"
    Height="560"
    ExtendsContentIntoTitleBar="True"
    ResizeMode="CanMinimize"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            x:Name="Bar"
            Title="PC Tidy Setup"
            ShowMaximize="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="Assets/PcTidy.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1" Margin="36,8,36,0">

            <!--  1. Welcome  -->
            <StackPanel x:Name="WelcomePanel">
                <Image
                    Width="56"
                    Height="56"
                    HorizontalAlignment="Left"
                    Source="Assets/PcTidy.ico" />
                <ui:TextBlock
                    Margin="0,14,0,0"
                    FontTypography="Title"
                    Text="Welcome to PC Tidy" />
                <ui:TextBlock
                    x:Name="VersionText"
                    Margin="0,2,0,0"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ui:TextBlock
                    Margin="0,14,0,0"
                    Text="PC Tidy cleans up, speeds up and organizes your PC, safely. It always shows you what it will do first, and almost every change can be undone with one click."
                    TextWrapping="Wrap" />
                <ui:Card Margin="0,16,0,0" Padding="16,12">
                    <StackPanel>
                        <StackPanel Margin="0,2" Orientation="Horizontal">
                            <ui:SymbolIcon Margin="0,0,10,0" Foreground="{DynamicResource AccentFillColorDefaultBrush}" Symbol="Person24" />
                            <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="Installs in Program Files for everyone on this PC." />
                        </StackPanel>
                        <StackPanel Margin="0,6" Orientation="Horizontal">
                            <ui:SymbolIcon Margin="0,0,10,0" Foreground="{DynamicResource AccentFillColorDefaultBrush}" Symbol="ShieldCheckmark24" />
                            <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="Nothing leaves your PC: no account, no ads, no tracking." />
                        </StackPanel>
                        <StackPanel Margin="0,2" Orientation="Horizontal">
                            <ui:SymbolIcon Margin="0,0,10,0" Foreground="{DynamicResource AccentFillColorDefaultBrush}" Symbol="ArrowUndo24" />
                            <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="Remove it any time from Settings, Apps." />
                        </StackPanel>
                    </StackPanel>
                </ui:Card>
                <ui:TextBlock
                    Margin="0,12,0,0"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="Windows asks for admin permission once, so the parts of PC Tidy that run with admin rights can't be tampered with by other programs. PC Tidy itself runs with your normal rights."
                    TextWrapping="Wrap" />
                <ui:InfoBar
                    x:Name="UpdateInfo"
                    Margin="0,14,0,0"
                    IsClosable="False"
                    Severity="Informational"
                    Title="Already installed" />
            </StackPanel>

            <!--  2. Folder and options  -->
            <StackPanel x:Name="OptionsPanel" Visibility="Collapsed">
                <ui:TextBlock FontTypography="Subtitle" Text="PC Tidy goes in Program Files" />
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox
                        x:Name="FolderBox"
                        AutomationProperties.Name="Install folder"
                        IsReadOnly="True" />
                </Grid>
                <ui:TextBlock
                    x:Name="FolderHint"
                    Margin="0,6,0,0"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />


                <ui:TextBlock
                    Margin="0,24,0,0"
                    FontTypography="BodyStrong"
                    Text="Options" />
                <CheckBox
                    x:Name="StartMenuBox"
                    Margin="0,8,0,0"
                    AutomationProperties.Name="Add PC Tidy to the Start menu"
                    Content="Add PC Tidy and PC Tidy Rescue to the Start menu"
                    IsChecked="True" />
                <CheckBox
                    x:Name="DesktopBox"
                    Margin="0,6,0,0"
                    AutomationProperties.Name="Add a desktop shortcut"
                    Content="Add a shortcut to the desktop" />
                <CheckBox
                    x:Name="LaunchBox"
                    Margin="0,6,0,0"
                    AutomationProperties.Name="Start PC Tidy when setup is done"
                    Content="Start PC Tidy when setup is done"
                    IsChecked="True" />
            </StackPanel>

            <!--  3. Progress  -->
            <StackPanel
                x:Name="ProgressPanel"
                VerticalAlignment="Center"
                Visibility="Collapsed">
                <ui:TextBlock x:Name="ProgressTitle" FontTypography="Subtitle" />
                <ProgressBar
                    x:Name="Progress"
                    Height="6"
                    Margin="0,16,0,0"
                    Maximum="1" />
                <ui:TextBlock
                    x:Name="ProgressText"
                    Margin="0,8,0,0"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <!--  4. Done (or failed)  -->
            <StackPanel x:Name="DonePanel" Visibility="Collapsed">
                <ui:SymbolIcon
                    x:Name="DoneIcon"
                    HorizontalAlignment="Left"
                    FontSize="48"
                    Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                    Symbol="CheckmarkCircle24" />
                <ui:TextBlock
                    x:Name="DoneTitle"
                    Margin="0,12,0,0"
                    FontTypography="Title"
                    TextWrapping="Wrap" />
                <ui:TextBlock
                    x:Name="DoneText"
                    Margin="0,8,0,0"
                    TextWrapping="Wrap" />
                <ui:TextBlock
                    x:Name="DoneNotes"
                    Margin="0,10,0,0"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <!--  Uninstall  -->
            <StackPanel x:Name="UninstallPanel" Visibility="Collapsed">
                <Image
                    Width="56"
                    Height="56"
                    HorizontalAlignment="Left"
                    Source="Assets/PcTidy.ico" />
                <ui:TextBlock
                    Margin="0,14,0,0"
                    FontTypography="Title"
                    Text="Remove PC Tidy" />
                <ui:TextBlock
                    Margin="0,10,0,0"
                    Text="This removes PC Tidy, its shortcuts, and anything it added to Windows (right-click menu entries, start-with-Windows, scheduled checkups)."
                    TextWrapping="Wrap" />
                <ui:Card Margin="0,16,0,0" Padding="16,12">
                    <StackPanel>
                        <CheckBox
                            x:Name="RemoveDataBox"
                            AutomationProperties.Name="Also delete my PC Tidy data"
                            Checked="RemoveDataBox_Changed"
                            Content="Also delete my PC Tidy data"
                            Unchecked="RemoveDataBox_Changed" />
                        <ui:TextBlock
                            x:Name="DataText"
                            Margin="28,4,0,0"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                        <ui:TextBlock
                            x:Name="DataWarning"
                            Margin="28,6,0,0"
                            Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                            Text="Files in quarantine will be gone for good, and PC Tidy Rescue won't be able to put them back."
                            TextWrapping="Wrap"
                            Visibility="Collapsed" />
                    </StackPanel>
                </ui:Card>
            </StackPanel>
        </Grid>

        <!--  Footer  -->
        <Border
            Grid.Row="2"
            Padding="36,14"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <ui:Button
                    x:Name="BackButton"
                    MinWidth="96"
                    Margin="0,0,8,0"
                    AutomationProperties.Name="Back"
                    Click="Back_Click"
                    Content="Back"
                    Visibility="Collapsed" />
                <ui:Button
                    x:Name="NextButton"
                    MinWidth="96"
                    Margin="0,0,8,0"
                    Appearance="Primary"
                    AutomationProperties.Name="Next"
                    Click="Next_Click"
                    Content="Next"
                    IsDefault="True" />
                <ui:Button
                    x:Name="CancelButton"
                    MinWidth="96"
                    AutomationProperties.Name="Cancel"
                    Click="Cancel_Click"
                    Content="Cancel"
                    IsCancel="True" />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
