<UserControl
    x:Class="PcTidy.Features.Learning.UI.LearnedView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:PcTidy.UI.Controls;assembly=PcTidy.UI"
    xmlns:local="clr-namespace:PcTidy.Features.Learning.UI"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    AutomationProperties.Name="What PC Tidy has learned"
    FontFamily="{DynamicResource TidyText}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:InverseBoolToVisibility x:Key="NotBoolToVis" />
        <local:TextToVisibility x:Key="TextToVis" />

        <DataTemplate DataType="{x:Type local:SectionRow}">
            <StackPanel Margin="2,18,0,8">
                <TextBlock Style="{DynamicResource SectionTitle}" Text="{Binding Title}" />
                <TextBlock Style="{DynamicResource Caption}" Text="{Binding Subtitle}" TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:LearnedCardModel}">
            <Border Margin="0,0,0,10" Padding="18,14" AutomationProperties.Name="{Binding AutomationName}" Style="{DynamicResource TidyCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="40" Height="40" Margin="0,2,14,0" VerticalAlignment="Top" CornerRadius="10" Background="{DynamicResource TidyAccentSoftBrush}">
                        <ui:SymbolIcon FontSize="20" Foreground="{DynamicResource TidyAccentBrush}" Symbol="{Binding Icon}" />
                    </Border>
                    <StackPanel Grid.Column="1">
                        <DockPanel>
                            <c:BadgePill Margin="10,0,0,0" DockPanel.Dock="Right" Text="Off" Tone="Neutral" Visibility="{Binding IsOff, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Style="{DynamicResource CardTitle}" Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                        </DockPanel>
                        <TextBlock Margin="0,2,0,0" Style="{DynamicResource Secondary}" Text="{Binding Reason}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,6,0,0" Style="{DynamicResource Caption}" TextWrapping="Wrap">
                            <Run Text="{Binding Counts, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding SinceText, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Style="{DynamicResource Caption}" Text="{Binding ExamplesText}" TextTrimming="CharacterEllipsis" Visibility="{Binding HasExamples, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Margin="0,4,0,0" Style="{DynamicResource Caption}" Text="{Binding Effect}" TextWrapping="Wrap" />
                        <WrapPanel Margin="0,10,0,0">
                            <ui:Button
                                Margin="0,0,8,0"
                                Appearance="Primary"
                                AutomationProperties.Name="Make it a rule"
                                Command="{Binding MakeRuleCommand}"
                                Content="Make it a rule"
                                Icon="{ui:SymbolIcon Add24}"
                                ToolTip="Adds this rule to Organize. It only runs when you preview and confirm."
                                Visibility="{Binding CanMakeRule, Converter={StaticResource BoolToVis}}" />
                            <ui:Button
                                Margin="0,0,8,0"
                                Appearance="Secondary"
                                AutomationProperties.Name="Edit"
                                Command="{Binding EditCommand}"
                                Content="Edit"
                                Icon="{ui:SymbolIcon Edit24}"
                                Visibility="{Binding CanEdit, Converter={StaticResource BoolToVis}}" />
                            <ui:Button
                                Margin="0,0,8,0"
                                Appearance="Secondary"
                                AutomationProperties.Name="{Binding OffText}"
                                Command="{Binding ToggleOffCommand}"
                                Content="{Binding OffText}"
                                ToolTip="Keeps it, but it changes nothing and suggests nothing." />
                            <ui:Button
                                Appearance="Secondary"
                                AutomationProperties.Name="Delete"
                                Command="{Binding DeleteCommand}"
                                Content="Delete"
                                Icon="{ui:SymbolIcon Delete24}"
                                ToolTip="Forgets what this was learned from. Your files aren't touched." />
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="{DynamicResource TidyPageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <!--  Wraps: on a narrow window the pill drops under the title instead of being cut.  -->
                <WrapPanel>
                    <TextBlock Margin="0,0,12,0" Style="{DynamicResource PageTitle}" Text="What PC Tidy has learned" />
                    <c:BadgePill Margin="0,6,0,0" VerticalAlignment="Top" Text="Stays on this PC" Tone="Success" />
                </WrapPanel>
                <TextBlock Style="{DynamicResource PageSubtitle}" Text="{Binding Subtitle}" TextWrapping="Wrap" />
            </StackPanel>
            <WrapPanel Grid.Column="1" Margin="16,6,0,0" VerticalAlignment="Top">
                <ui:Button
                    Margin="0,0,8,0"
                    Appearance="Secondary"
                    AutomationProperties.Name="{Binding PauseText}"
                    Command="{Binding TogglePauseCommand}"
                    Content="{Binding PauseText}"
                    Icon="{Binding PauseIcon, Converter={x:Static local:SymbolToIcon.Instance}}"
                    IsEnabled="{Binding IsOffInSettings, Converter={x:Static local:InverseBool.Instance}}" />
                <!--  Secondary with red text, not a solid red button: it always asks first, and it's off while nothing is learned.  -->
                <!--  The red text is set in code only while it can be pressed (LearnedView.UpdateForgetColor).  -->
                <ui:Button
                    x:Name="ForgetButton"
                    Appearance="Secondary"
                    AutomationProperties.Name="Forget everything"
                    Command="{Binding ForgetEverythingCommand}"
                    Content="Forget everything"
                    Icon="{ui:SymbolIcon DeleteDismiss24}"
                    ToolTip="Deletes everything PC Tidy learned (it asks first). Your files and settings aren't touched." />
            </WrapPanel>
        </Grid>

        <!--  Notes  -->
        <StackPanel Grid.Row="1" Margin="0,12,0,0">
            <ui:InfoBar
                Margin="0,0,0,8"
                IsClosable="False"
                IsOpen="{Binding IsPaused}"
                Message="{Binding PausedNote}"
                Severity="Informational"
                Title="Paused" />
            <ui:InfoBar
                Margin="0,0,0,8"
                IsClosable="False"
                IsOpen="{Binding Problem, Converter={x:Static local:NotNull.Instance}}"
                Message="{Binding Problem}"
                Severity="Warning"
                Title="Couldn't read what was learned" />
            <TextBlock
                Margin="2,0,0,8"
                Style="{DynamicResource Caption}"
                Text="{Binding WatchingNote}"
                TextWrapping="Wrap"
                Visibility="{Binding WatchingNote, Converter={StaticResource TextToVis}}" />
            <ui:ToggleSwitch
                Margin="2,0,0,4"
                AutomationProperties.Name="Also learn folders from Windows' Recent items list"
                Content="Also learn folders from Windows' Recent items list (read only, off by default)"
                IsChecked="{Binding ReadWindowsRecent}" />
        </StackPanel>

        <!--  Cards (the only part that scrolls)  -->
        <ItemsControl
            x:Name="CardList"
            Grid.Row="2"
            Margin="0,4,0,0"
            AutomationProperties.Name="Learned items"
            Focusable="False"
            ItemsSource="{Binding Rows}"
            ScrollViewer.CanContentScroll="True"
            VirtualizingPanel.IsVirtualizing="True"
            VirtualizingPanel.ScrollUnit="Pixel"
            VirtualizingPanel.VirtualizationMode="Recycling"
            Visibility="{Binding IsEmpty, Converter={StaticResource NotBoolToVis}}">
            <ItemsControl.Template>
                <ControlTemplate TargetType="ItemsControl">
                    <ScrollViewer CanContentScroll="True" Focusable="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </ItemsControl.Template>
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>

        <Border Grid.Row="2" Margin="0,4,0,0" VerticalAlignment="Top" Style="{DynamicResource TidyCard}" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
            <c:EmptyState
                Icon="Lightbulb24"
                Message="As you use PC Tidy it notices things you always skip, folders you use, and where you put your files. Everything it learns shows up here, and nothing learned ever changes anything by itself."
                Title="Nothing learned yet" />
        </Border>

        <ui:ProgressRing
            Grid.Row="2"
            Width="36"
            Height="36"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="0,40,0,0"
            IsIndeterminate="True"
            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
    </Grid>
</UserControl>
