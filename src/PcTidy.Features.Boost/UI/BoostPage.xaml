<UserControl
    x:Class="PcTidy.Features.Boost.UI.BoostPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:PcTidy.UI.Controls;assembly=PcTidy.UI"
    xmlns:local="clr-namespace:PcTidy.Features.Boost.UI"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    AutomationProperties.Name="Game boost"
    FontFamily="{StaticResource TidyText}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
    </UserControl.Resources>

    <Grid Margin="{StaticResource TidyPageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Title, what it does, master switch  -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,16,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource PageTitle}" Text="Game boost" />
                    <c:BadgePill
                        Margin="12,6,0,0"
                        Text="Optional"
                        Tone="Neutral" />
                </StackPanel>
                <TextBlock
                    Style="{StaticResource PageSubtitle}"
                    Text="When a game you pick starts, PC Tidy pauses OneDrive and asks the apps you chose to close. When the game closes, everything comes back. No FPS miracles: it mostly frees up what background apps were using." />
            </StackPanel>
            <!--  Label on the left, like Services' Expert mode and the switches in Settings  -->
            <StackPanel Grid.Column="1" Margin="0,8,0,0" VerticalAlignment="Top" Orientation="Horizontal">
                <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Style="{StaticResource Body}" Text="Game boost" />
                <ui:ToggleSwitch VerticalAlignment="Center" AutomationProperties.Name="Turn Game boost on or off" IsChecked="{Binding IsEnabled}" />
            </StackPanel>
        </Grid>

        <!--  Live status, "put back now", reopen buttons  -->
        <StackPanel Grid.Row="1" Margin="0,12,0,12">
            <ui:InfoBar
                Title="Status"
                AutomationProperties.Name="Game boost status"
                IsClosable="False"
                IsOpen="True"
                Message="{Binding StatusText}"
                Severity="{Binding StatusSeverity}" />
            <WrapPanel Margin="0,6,0,0">
                <ui:Button
                    Margin="0,0,8,6"
                    Appearance="Secondary"
                    AutomationProperties.Name="Put everything back now"
                    Command="{Binding PutBackNowCommand}"
                    Content="Put everything back now"
                    Icon="{ui:SymbolIcon ArrowUndo24}"
                    Visibility="{Binding IsBoostActive, Converter={StaticResource BoolToVisibility}}" />
                <ItemsControl ItemsSource="{Binding Offers}" Visibility="{Binding HasOffers, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ui:Button
                                Margin="0,0,8,6"
                                Appearance="Secondary"
                                AutomationProperties.Name="{Binding Label}"
                                Command="{Binding DataContext.ReopenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}"
                                Content="{Binding Label}"
                                Icon="{ui:SymbolIcon Open24}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </WrapPanel>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="300" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <!--  Games to boost (the list scrolls). Cards are as tall as their content.  -->
            <Border VerticalAlignment="Top" Style="{StaticResource TidyCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Games to boost" />
                    <TextBlock
                        Grid.Row="1"
                        Margin="0,4,0,10"
                        Style="{StaticResource Secondary}"
                        Text="{Binding GamesNote}"
                        TextWrapping="Wrap" />
                    <ListBox
                        Grid.Row="2"
                        AutomationProperties.Name="Games to boost"
                        ItemContainerStyle="{StaticResource TidyRowContainer}"
                        ItemsSource="{Binding Games}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        Style="{StaticResource TidyFlatList}"
                        VirtualizingPanel.IsVirtualizing="True"
                        VirtualizingPanel.VirtualizationMode="Recycling"
                        Visibility="{Binding HasGames, Converter={StaticResource BoolToVisibility}}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:GameRow}">
                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock
                                            Style="{StaticResource Body}"
                                            Text="{Binding Name}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock Style="{StaticResource Caption}" Text="{Binding Launcher}" />
                                    </StackPanel>
                                    <ui:ToggleSwitch
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="{Binding AutomationName}"
                                        IsChecked="{Binding IsEnabled}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  Apps to close (the list scrolls)  -->
                <Border Style="{StaticResource TidyCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Apps to close while you play" />
                        <TextBlock
                            Grid.Row="1"
                            Margin="0,4,0,8"
                            Style="{StaticResource Secondary}"
                            Text="Asked to close like clicking their X, never forced. Windows, security software, anti-cheat, game launchers and the game itself are never closed."
                            TextWrapping="Wrap" />
                        <TextBlock
                            Grid.Row="2"
                            Style="{StaticResource Caption}"
                            Text="No apps picked yet. Pick a running app below (for example a chat or music app)."
                            TextWrapping="Wrap"
                            Visibility="{Binding HasApps, Converter={StaticResource InverseBoolToVisibility}}" />
                        <ListBox
                            Grid.Row="2"
                            MaxHeight="240"
                            AutomationProperties.Name="Apps to close while you play"
                            ItemContainerStyle="{StaticResource TidyRowContainer}"
                            ItemsSource="{Binding Apps}"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            Style="{StaticResource TidyFlatList}"
                            VirtualizingPanel.IsVirtualizing="True"
                            VirtualizingPanel.VirtualizationMode="Recycling"
                            Visibility="{Binding HasApps, Converter={StaticResource BoolToVisibility}}">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:AppRow}">
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Style="{StaticResource Body}"
                                            Text="{Binding DisplayName}"
                                            TextTrimming="CharacterEllipsis" />
                                        <ui:Button
                                            Grid.Column="1"
                                            Appearance="Transparent"
                                            AutomationProperties.Name="{Binding RemoveName}"
                                            Command="{Binding DataContext.RemoveAppCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}"
                                            Icon="{ui:SymbolIcon Dismiss24}"
                                            ToolTip="{Binding RemoveName}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Grid Grid.Row="3" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox
                                AutomationProperties.Name="Running apps you can add"
                                ItemsSource="{Binding RunningApps}"
                                SelectedItem="{Binding SelectedRunningApp}" />
                            <!--  Placeholder: the picker never looks like an empty box  -->
                            <TextBlock
                                Margin="12,0,36,0"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False"
                                Style="{StaticResource Secondary}"
                                Text="{Binding RunningAppHint}"
                                TextTrimming="CharacterEllipsis" />
                            <ui:Button
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                Appearance="Primary"
                                AutomationProperties.Name="Add the selected app"
                                Command="{Binding AddAppCommand}"
                                Content="Add"
                                Icon="{ui:SymbolIcon Add24}" />
                            <ui:Button
                                Grid.Column="2"
                                Margin="8,0,0,0"
                                Appearance="Secondary"
                                AutomationProperties.Name="Refresh the list of running apps"
                                Command="{Binding RefreshRunningAppsCommand}"
                                Icon="{ui:SymbolIcon ArrowClockwise24}"
                                ToolTip="Refresh the list of running apps" />
                        </Grid>
                    </Grid>
                </Border>

                <!--  While you play: OneDrive, reopening, Windows Update  -->
                <Border Grid.Row="2" Style="{StaticResource TidyCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="While you play" />
                        <ui:ToggleSwitch
                            Margin="0,10,0,0"
                            AutomationProperties.Name="Pause OneDrive while a game runs"
                            Content="Pause OneDrive (starts again afterwards)"
                            IsChecked="{Binding PauseOneDrive}"
                            Visibility="{Binding OneDriveAvailable, Converter={StaticResource BoolToVisibility}}" />
                        <ui:ToggleSwitch
                            Margin="0,10,0,0"
                            AutomationProperties.Name="Reopen closed apps when the game closes"
                            Content="Reopen the closed apps when the game closes"
                            IsChecked="{Binding ReopenAppsAfter}" />
                        <DockPanel Margin="0,12,0,0">
                            <ui:SymbolIcon
                                Margin="0,0,8,0"
                                VerticalAlignment="Top"
                                DockPanel.Dock="Left"
                                Symbol="Info24" />
                            <TextBlock
                                Style="{StaticResource Secondary}"
                                Text="{x:Static local:BoostViewModel.WindowsUpdateNote}"
                                TextWrapping="Wrap" />
                        </DockPanel>
                        <DockPanel Margin="0,8,0,0">
                            <ui:SymbolIcon
                                Margin="0,0,8,0"
                                VerticalAlignment="Top"
                                DockPanel.Dock="Left"
                                Symbol="Info24" />
                            <TextBlock
                                Style="{StaticResource Secondary}"
                                Text="{Binding PowerNote}"
                                TextWrapping="Wrap" />
                        </DockPanel>
                        <TextBlock
                            Margin="0,8,0,0"
                            Style="{StaticResource Caption}"
                            Text="Game boost never changes game files, never suspends or re-prioritises anything and never touches anti-cheat. Each boost and each put-back is in History."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
