<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>PcTidy.Features.Boost</RootNamespace>
    <UseWPF>true</UseWPF>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WPF-UI" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <!-- Win32_Process.CommandLine (read-only) for the apps the user picked, so they can be reopened after the game. -->
    <PackageReference Include="System.Management" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PcTidy.Core\PcTidy.Core.csproj" />
    <ProjectReference Include="..\PcTidy.UI\PcTidy.UI.csproj" />
    <ProjectReference Include="..\PcTidy.Catalog\PcTidy.Catalog.csproj" />
    <!-- Read-only launcher detection (GameLibraryInfo: Steam app manifests, Epic .item manifests). -->
    <ProjectReference Include="..\PcTidy.Safety\PcTidy.Safety.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="PcTidy.Features.Boost.Tests" />
  </ItemGroup>
</Project>
