<c:TidyWindow
    x:Class="PcTidy.Features.Organize.UI.TriageWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:PcTidy.UI.Controls;assembly=PcTidy.UI"
    xmlns:local="clr-namespace:PcTidy.Features.Organize.UI"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Sort one by one"
    Width="900"
    Height="680"
    MinWidth="720"
    MinHeight="520"
    AutomationProperties.HelpText="Numbers 1 to 9 move the file to a folder. K keeps it, Q quarantines it, R renames it. Left and right arrows go back and forward. Enter finishes and shows every decision. Escape stops (it asks first if you decided anything)."
    AutomationProperties.Name="Sort Downloads one file at a time"
    PreviewKeyDown="OnPreviewKeyDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PcTidy.Features.Organize;component/UI/OrganizeStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="Sort one by one" Height="40" ShowMaximize="False" ShowMinimize="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Width="16" Height="16" Source="{DynamicResource TidyLogo}" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1" Margin="24,4,24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Which file, and what's decided for it (announced to screen readers on every key).  -->
            <StackPanel Grid.ColumnSpan="3">
                <TextBlock Style="{StaticResource OrgCaption}" Text="{Binding Position}" />
                <TextBlock FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding FileName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}" />
                <TextBlock Style="{StaticResource OrgSecondary}" Text="{Binding FileDetail}" TextWrapping="Wrap" />
                <TextBlock x:Name="Announcer" AutomationProperties.LiveSetting="Assertive" AutomationProperties.Name="{Binding Announcement}" FontSize="1" Opacity="0" Text="{Binding Announcement}" />
            </StackPanel>

            <!--  Preview  -->
            <Border Grid.Row="1" Margin="0,12,0,0" Style="{StaticResource OrgCard}">
                <Grid>
                    <Image
                        AutomationProperties.Name="{Binding FileName, StringFormat='Preview of {0}'}"
                        RenderOptions.BitmapScalingMode="HighQuality"
                        Source="{Binding Preview}"
                        Stretch="Uniform" />
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding Preview, Converter={StaticResource OrgVisible}, ConverterParameter=invert}">
                        <ui:SymbolIcon HorizontalAlignment="Center" FontSize="56" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Symbol="{Binding PreviewIcon, Converter={StaticResource OrgSymbol}}" />
                        <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" Style="{StaticResource OrgCaption}" Text="No preview for this kind of file" />
                    </StackPanel>
                </Grid>
            </Border>

            <!--  Keys  -->
            <Border Grid.Row="1" Grid.Column="2" Margin="0,12,0,0" Padding="20,20,8,20" Style="{StaticResource OrgCard}">
                <DockPanel>
                    <StackPanel Margin="0,0,12,0" DockPanel.Dock="Top">
                        <TextBlock Style="{StaticResource OrgCardTitle}" Text="{Binding DecisionText}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,2,0,8" Foreground="{DynamicResource TidyAccentBrush}" Style="{StaticResource OrgSecondary}" Text="{Binding Suggestion}" TextWrapping="Wrap" Visibility="{Binding Suggestion, Converter={StaticResource OrgVisible}}" />
                    </StackPanel>

                    <!--  Rename box (R)  -->
                    <StackPanel Margin="0,0,12,0" DockPanel.Dock="Bottom" Visibility="{Binding IsRenaming, Converter={StaticResource OrgVisible}}">
                        <TextBlock Style="{StaticResource OrgCaption}" Text="New name (Enter to keep it, Esc to cancel)" />
                        <ui:TextBox x:Name="RenameBox" AutomationProperties.Name="New name" KeyDown="OnRenameKeyDown" Text="{Binding RenameText, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Foreground="{DynamicResource SystemFillColorCautionBrush}" Style="{StaticResource OrgCaption}" Text="{Binding RenameProblem}" Visibility="{Binding RenameProblem, Converter={StaticResource OrgVisible}}" />
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <!--  Right padding keeps the scroll bar off the folder names.  -->
                        <StackPanel Margin="0,0,12,0">
                            <ItemsControl AutomationProperties.Name="Folders" Focusable="False" ItemsSource="{Binding Targets}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:TriageTargetRow}">
                                        <ui:Button
                                            Margin="0,0,0,4"
                                            Padding="8,4"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Appearance="Secondary"
                                            AutomationProperties.Name="{Binding AutomationName}"
                                            Command="{Binding DataContext.TargetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding KeyText}"
                                            ToolTip="{Binding Folder}">
                                            <TextBlock TextTrimming="CharacterEllipsis">
                                                <Run FontWeight="SemiBold" Text="{Binding KeyText, Mode=OneWay}" />
                                                <Run Text="{Binding Label, Mode=OneWay, StringFormat='  {0}'}" />
                                            </TextBlock>
                                        </ui:Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ui:Button Margin="0,8,0,4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" AutomationProperties.Name="K: keep it where it is" Command="{Binding KeepCommand}" Content="K  Keep where it is" />
                            <ui:Button Margin="0,0,0,4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" AutomationProperties.Name="Q: quarantine it, restorable" Command="{Binding QuarantineCommand}" Content="Q  Quarantine (restorable)" />
                            <ui:Button Margin="0,0,0,4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" AutomationProperties.Name="R: rename it" Command="{Binding RenameCommand}" Content="R  Rename" />
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!--  Bottom: back / forward / done, or "Stop sorting?" after Esc  -->
            <DockPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,12,0,0" Visibility="{Binding IsAskingToStop, Converter={StaticResource OrgVisible}, ConverterParameter=invert}">
                <ui:Button Appearance="Primary" AutomationProperties.Name="Done: review every decision" Command="{Binding FinishCommand}" Content="Done (Enter)" DockPanel.Dock="Right" Icon="{ui:SymbolIcon Checkmark24}" />
                <ui:Button Margin="0,0,8,0" AutomationProperties.Name="Previous file" Command="{Binding PreviousCommand}" Content="Back (←)" Icon="{ui:SymbolIcon ArrowLeft24}" />
                <ui:Button Margin="0,0,12,0" AutomationProperties.Name="Next file" Command="{Binding NextCommand}" Content="Next (→)" Icon="{ui:SymbolIcon ArrowRight24}" />
                <TextBlock VerticalAlignment="Center" Style="{StaticResource OrgCaption}" Text="Nothing moves yet. When you're done, PC Tidy shows every decision in one list to confirm." />
            </DockPanel>
            <Border
                Grid.Row="2"
                Grid.ColumnSpan="3"
                Margin="0,12,0,0"
                Padding="16,10"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource SystemFillColorCautionBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="{Binding IsAskingToStop, Converter={StaticResource OrgVisible}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <ui:Button Margin="8,0,0,0" AutomationProperties.Name="Keep sorting" Command="{Binding KeepSortingCommand}" Content="Keep sorting (Esc)" />
                        <ui:Button Margin="8,0,0,0" AutomationProperties.Name="Discard my decisions and close" Command="{Binding DiscardDecisionsCommand}" Content="Discard them" />
                        <ui:Button x:Name="ReviewButton" Margin="8,0,0,0" Appearance="Primary" AutomationProperties.Name="Review my decisions" Command="{Binding ReviewDecisionsCommand}" Content="Review (Enter)" />
                    </StackPanel>
                    <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding StopQuestion}" TextWrapping="Wrap" />
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</c:TidyWindow>
