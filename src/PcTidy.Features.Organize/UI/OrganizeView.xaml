<UserControl
    x:Class="PcTidy.Features.Organize.UI.OrganizeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:PcTidy.UI.Controls;assembly=PcTidy.UI"
    xmlns:local="clr-namespace:PcTidy.Features.Organize.UI"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    AutomationProperties.Name="Organize files">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PcTidy.Features.Organize;component/UI/OrganizeStyles.xaml" />
                <ResourceDictionary Source="pack://application:,,,/PcTidy.UI;component/Themes/TidyGridView.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!--  Same frame as the shell's standard flow page: header, step bar, content (only the lists scroll), sticky action bar.  -->
    <Grid Margin="32,16,32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Header: title + folder picker (Sort files and Rename only); Quick/Deep + Scan belong to the Sort tab.
              Title and subtitle follow the open tab.  -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource OrgPageTitle}" Text="{Binding HeaderTitle}" TextTrimming="CharacterEllipsis" />
                <!--  One line, so the lists keep their room on short screens; the full text is in the tooltip.  -->
                <TextBlock Style="{StaticResource OrgSubtitle}" Text="{Binding HeaderSubtitle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding HeaderSubtitle}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="16,6,0,0" VerticalAlignment="Top" Orientation="Horizontal">
                <ComboBox
                    Width="220"
                    AutomationProperties.Name="Folder to organize"
                    ItemsSource="{Binding Folders}"
                    SelectedItem="{Binding SelectedFolder}"
                    Visibility="{Binding ShowFolderPicker, Converter={StaticResource OrgVisible}}" />
                <StackPanel Orientation="Horizontal" Visibility="{Binding ShowSortTools, Converter={StaticResource OrgVisible}}">
                    <c:Segmented
                        Margin="10,0,10,0"
                        Items="Quick|Deep"
                        Label="Scan depth"
                        SelectedIndex="{Binding DepthIndex}"
                        ToolTip="Deep also reads the date a photo was taken. Slower." />
                    <ui:Button
                        Appearance="Secondary"
                        AutomationProperties.Name="Scan"
                        Command="{Binding ScanCommand}"
                        Content="Scan"
                        Icon="{ui:SymbolIcon ArrowClockwise24}"
                        Visibility="{Binding IsScanning, Converter={StaticResource OrgVisible}, ConverterParameter=invert}" />
                    <ui:Button
                        Margin="0,0,8,0"
                        Appearance="Secondary"
                        AutomationProperties.Name="Sort one by one with the keyboard"
                        Command="{Binding TriageCommand}"
                        Content="One by one"
                        Icon="{ui:SymbolIcon Keyboard24}"
                        ToolTip="One file at a time: 1-9 send it to a folder, K keeps, Q quarantines, R renames. Nothing moves until you confirm." />
                    <ui:Button
                        Appearance="Secondary"
                        AutomationProperties.Name="Stop scanning"
                        Command="{Binding CancelScanCommand}"
                        Content="Stop"
                        Icon="{ui:SymbolIcon Dismiss24}"
                        Visibility="{Binding IsScanning, Converter={StaticResource OrgVisible}}" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!--  The tools as segmented tabs, like every other section. The tab control below only swaps the content.  -->
        <c:Segmented
            x:Name="TabStrip"
            Grid.Row="1"
            Margin="0,12,0,0"
            Items="Sort files|Rename|Watch folders|Google Takeout"
            Label="Organize tools"
            SelectedIndex="{Binding SelectedTab}" />

        <TabControl x:Name="Tabs" Grid.Row="2" AutomationProperties.Name="Organize tools" SelectedIndex="{Binding SelectedTab}">
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <!--  The tab items still need a host (selection and content depend on it), just not a visible one.  -->
                        <TabPanel IsItemsHost="True" Visibility="Collapsed" />
                        <ContentPresenter ContentSource="SelectedContent" />
                    </Grid>
                </ControlTemplate>
            </TabControl.Template>
            <!-- ================================================================== Sort -->
            <TabItem AutomationProperties.Name="Sort files" Header="Sort files">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <c:StepBar Margin="0,0,0,12" Captions="{Binding StepCaptions}" Current="{Binding Step}" />

                    <ui:InfoBar
                        Title="Needs your OK"
                        Grid.Row="1"
                        Margin="0,0,0,12"
                        IsClosable="False"
                        IsOpen="{Binding FolderNote, Converter={x:Static local:NotNull.Instance}}"
                        Message="{Binding FolderNote}"
                        Severity="Warning" />

                    <!--  Rules | preview side by side; stacked (rules on top) when the window is narrow, and then this part
                          may scroll so both stay usable on a short screen. The step bar and action bar never scroll.
                          See OnSortAreaSizeChanged.  -->
                    <ScrollViewer
                        x:Name="SortScroll"
                        Grid.Row="2"
                        Focusable="False"
                        HorizontalScrollBarVisibility="Disabled"
                        SizeChanged="OnSortAreaSizeChanged"
                        VerticalScrollBarVisibility="Disabled">
                    <Grid x:Name="SortBody">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="RulesColumn" Width="380" />
                            <ColumnDefinition x:Name="GapColumn" Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition x:Name="RulesRow" Height="*" />
                            <RowDefinition x:Name="GapRow" Height="0" />
                            <RowDefinition x:Name="PreviewRow" Height="0" />
                        </Grid.RowDefinitions>

                        <!--  Rules  -->
                        <Border x:Name="RulesCard" Padding="0,14,0,8" Style="{StaticResource OrgCard}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <DockPanel Margin="16,0,12,8">
                                    <ui:Button
                                        Padding="8,4"
                                        Appearance="Transparent"
                                        AutomationProperties.Name="Add rule"
                                        Command="{Binding AddRuleCommand}"
                                        Content="Add rule"
                                        DockPanel.Dock="Right"
                                        Icon="{ui:SymbolIcon Add24}" />
                                    <StackPanel>
                                        <TextBlock VerticalAlignment="Center" Style="{StaticResource OrgCardTitle}" Text="Rules" />
                                        <TextBlock Style="{StaticResource OrgCaption}" Text="Top to bottom, first match wins. Drag to reorder." />
                                    </StackPanel>
                                </DockPanel>

                                <ItemsControl
                                    x:Name="RulesList"
                                    Grid.Row="1"
                                    AllowDrop="True"
                                    AutomationProperties.Name="Rules"
                                    Drop="RulesList_Drop"
                                    ItemsSource="{Binding Rules}"
                                    PreviewMouseLeftButtonDown="RulesList_PreviewMouseLeftButtonDown"
                                    PreviewMouseMove="RulesList_PreviewMouseMove"
                                    Style="{StaticResource OrgVirtualList}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type local:RuleRowViewModel}">
                                            <Border Background="Transparent" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                                                <Grid x:Name="RuleRow" Margin="16,8,8,8" Background="Transparent">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="36" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <ui:SymbolIcon Margin="0,2,10,0" VerticalAlignment="Top" FontSize="18" Foreground="{DynamicResource TidyAccentBrush}" Symbol="{Binding Icon, Converter={StaticResource OrgSymbol}}" />
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                                        <TextBlock Style="{StaticResource OrgSecondary}" Text="{Binding MatchText}" ToolTip="{Binding MatchText}" />
                                                        <TextBlock Style="{StaticResource OrgSecondary}" Text="{Binding Target, StringFormat='→ {0}'}" ToolTip="{Binding Target}" />
                                                        <TextBlock Foreground="{DynamicResource SystemFillColorCautionBrush}" Style="{StaticResource OrgSecondary}" Text="{Binding Problem}" TextWrapping="Wrap" Visibility="{Binding Problem, Converter={StaticResource OrgVisible}}" />
                                                        <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                                            <Border Margin="0,0,6,0" Style="{StaticResource OrgPill}" Visibility="{Binding IsCustom, Converter={StaticResource OrgVisible}}">
                                                                <TextBlock FontSize="11" Foreground="{DynamicResource TidyAccentBrush}" Text="Your rule" />
                                                            </Border>
                                                            <Border Style="{StaticResource OrgPill}" Visibility="{Binding IsAutomatic, Converter={StaticResource OrgVisible}}">
                                                                <TextBlock FontSize="11" Foreground="{DynamicResource TidyAccentBrush}" Text="Automatic" />
                                                            </Border>
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <!--  Row menu (edit, move up/down, delete): shown on hover or keyboard focus so the list stays calm.  -->
                                                    <ui:Button
                                                        x:Name="RowMenu"
                                                        Grid.Column="2"
                                                        Margin="4,0,0,0"
                                                        Padding="4"
                                                        VerticalAlignment="Center"
                                                        Appearance="Transparent"
                                                        AutomationProperties.Name="{Binding Name, StringFormat='More for rule {0}'}"
                                                        Click="RuleMenu_Click"
                                                        Icon="{ui:SymbolIcon MoreHorizontal24}"
                                                        Opacity="0"
                                                        ToolTip="Edit, test, move or delete this rule" />
                                                    <TextBlock
                                                        Grid.Column="3"
                                                        Margin="0,0,8,0"
                                                        VerticalAlignment="Center"
                                                        FontSize="13"
                                                        FontWeight="SemiBold"
                                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                        Text="{Binding Count}"
                                                        TextAlignment="Right" />
                                                    <ui:ToggleSwitch Grid.Column="4" VerticalAlignment="Center" AutomationProperties.Name="{Binding Name, StringFormat='Rule {0} on or off'}" IsChecked="{Binding Enabled}" />
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                    <Setter TargetName="RuleRow" Property="Opacity" Value="0.55" />
                                                </DataTrigger>
                                                <Trigger SourceName="RuleRow" Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="RowMenu" Property="Opacity" Value="1" />
                                                </Trigger>
                                                <Trigger SourceName="RuleRow" Property="IsKeyboardFocusWithin" Value="True">
                                                    <Setter TargetName="RowMenu" Property="Opacity" Value="1" />
                                                </Trigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <WrapPanel Grid.Row="2" Margin="16,8,12,0">
                                    <CheckBox Margin="0,0,16,0" AutomationProperties.Name="Sort into year and month folders" Content="Year and month folders" IsChecked="{Binding UseDateFolders}" ToolTip="For example Pictures\2026\2026-11" />
                                    <CheckBox Margin="0,0,16,0" AutomationProperties.Name="Move whole folders" Content="Move whole folders" IsChecked="{Binding MoveWholeFolders}" ToolTip="A folder in Downloads moves as one item" />
                                    <ui:Button Margin="0,0,4,0" Padding="6,2" Appearance="Transparent" AutomationProperties.Name="Rule presets" Command="{Binding OpenPresetsCommand}" Content="Presets…" ToolTip="Simple, By date, Projects and Areas, Numbered: see what changes first" />
                                    <ui:Button Padding="6,2" Appearance="Transparent" AutomationProperties.Name="Reset rules to defaults" Command="{Binding ResetRulesCommand}" Content="Reset rules" ToolTip="Put the rules back to how PC Tidy started" />
                                </WrapPanel>
                            </Grid>
                        </Border>

                        <!--  Before → After (or every change)  -->
                        <Border x:Name="PreviewCard" Grid.Column="2" Padding="18,14" Style="{StaticResource OrgCard}">
                            <Grid>
                                <!--  Empty / scanning state  -->
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasPreview, Converter={StaticResource OrgVisible}, ConverterParameter=invert}">
                                    <ui:SymbolIcon HorizontalAlignment="Center" FontSize="40" Foreground="{DynamicResource TidyAccentBrush}" Symbol="FolderArrowRight24" />
                                    <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" Style="{StaticResource OrgCardTitle}" Text="See what would move before anything does" />
                                    <TextBlock MaxWidth="360" Margin="0,4,0,12" HorizontalAlignment="Center" Style="{StaticResource OrgCaption}" Text="Scanning only looks. Shortcuts, unfinished downloads, files in use and code projects always stay put." TextAlignment="Center" />
                                    <ui:Button
                                        HorizontalAlignment="Center"
                                        Appearance="Primary"
                                        AutomationProperties.Name="Scan now"
                                        Command="{Binding ScanCommand}"
                                        Content="Scan now"
                                        Icon="{ui:SymbolIcon ScanDash24}"
                                        Visibility="{Binding IsScanning, Converter={StaticResource OrgVisible}, ConverterParameter=invert}" />
                                    <ui:ProgressRing HorizontalAlignment="Center" IsIndeterminate="True" Visibility="{Binding IsScanning, Converter={StaticResource OrgVisible}}" />
                                    <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" Style="{StaticResource OrgCaption}" Text="{Binding ProgressText}" />
                                </StackPanel>

                                <!--  Preview  -->
                                <Grid Visibility="{Binding HasPreview, Converter={StaticResource OrgVisible}}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <c:Segmented
                                        Grid.Column="2"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Items="Summary|Every file"
                                        Label="Preview style"
                                        SelectedIndex="{Binding DetailsIndex}"
                                        ToolTip="Every file: untick anything you want to keep where it is" />
                                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Style="{StaticResource OrgCaption}" Text="BEFORE" Visibility="{Binding ShowDetails, Converter={StaticResource OrgVisible}, ConverterParameter=invert}" />
                                    <TextBlock Grid.Column="2" Margin="0,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" Style="{StaticResource OrgCaption}" Text="AFTER" Visibility="{Binding ShowDetails, Converter={StaticResource OrgVisible}, ConverterParameter=invert}" />
                                    <TextBlock Grid.ColumnSpan="3" Margin="0,0,190,0" VerticalAlignment="Center" FontWeight="SemiBold" Style="{StaticResource OrgCaption}" Text="EVERY CHANGE · untick anything to keep it where it is" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Visibility="{Binding ShowDetails, Converter={StaticResource OrgVisible}}" />

                                    <ItemsControl Grid.Row="1" Margin="0,8,0,0" AutomationProperties.Name="Before" ItemTemplate="{StaticResource OrgTreeRow}" ItemsSource="{Binding BeforeRows}" Style="{StaticResource OrgVirtualList}" Visibility="{Binding ShowDetails, Converter={StaticResource OrgVisible}, ConverterParameter=invert}" />
                                    <ui:SymbolIcon Grid.Row="1" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="22" Foreground="{DynamicResource TidyAccentBrush}" Symbol="ArrowRight24" Visibility="{Binding ShowDetails, Converter={StaticResource OrgVisible}, ConverterParameter=invert}" />
                                    <ItemsControl Grid.Row="1" Grid.Column="2" Margin="0,8,0,0" AutomationProperties.Name="After" ItemTemplate="{StaticResource OrgTreeRow}" ItemsSource="{Binding AfterRows}" Style="{StaticResource OrgVirtualList}" Visibility="{Binding ShowDetails, Converter={StaticResource OrgVisible}, ConverterParameter=invert}" />

                                    <!--  Every change with ticks: headers and rows in one flat, virtualized list.  -->
                                    <ItemsControl Grid.Row="1" Grid.ColumnSpan="3" Margin="0,8,0,0" AutomationProperties.Name="Planned moves" ItemsSource="{Binding DetailRows}" Style="{StaticResource OrgVirtualList}" Visibility="{Binding ShowDetails, Converter={StaticResource OrgVisible}}">
                                        <ItemsControl.Resources>
                                            <DataTemplate DataType="{x:Type local:ActionGroupViewModel}">
                                                <StackPanel Margin="0,10,0,4">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Style="{StaticResource OrgCardTitle}" Text="{Binding Title}" />
                                                        <TextBlock Margin="8,1,0,0" Style="{StaticResource OrgCaption}" Text="{Binding CountText}" />
                                                    </StackPanel>
                                                    <TextBlock Style="{StaticResource OrgCaption}" Text="{Binding Description}" />
                                                </StackPanel>
                                            </DataTemplate>
                                            <DataTemplate DataType="{x:Type local:ActionRowViewModel}">
                                                <Border BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                                                    <Grid Margin="0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="80" />
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox MinWidth="0" VerticalAlignment="Center" AutomationProperties.Name="{Binding Name}" IsChecked="{Binding IsChecked}" />
                                                        <ui:SymbolIcon Grid.Column="1" Margin="4,0,8,0" FontSize="16" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Symbol="{Binding Icon, Converter={StaticResource OrgSymbol}}" />
                                                        <StackPanel Grid.Column="2">
                                                            <TextBlock FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                                            <TextBlock Style="{StaticResource OrgSecondary}" Text="{Binding Detail}" ToolTip="{Binding Detail}" />
                                                            <TextBlock Style="{StaticResource OrgCaption}" Text="{Binding Reason}" />
                                                        </StackPanel>
                                                        <Border x:Name="Badge" Grid.Column="3" Margin="8,0" VerticalAlignment="Center" Style="{StaticResource OrgPill}">
                                                            <TextBlock x:Name="BadgeText" FontSize="11" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Text="{Binding BadgeText}" />
                                                        </Border>
                                                        <TextBlock Grid.Column="4" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Size}" TextAlignment="Right" />
                                                    </Grid>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsCheck}" Value="True">
                                                        <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                        <Setter TargetName="Badge" Property="BorderBrush" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.Resources>
                                    </ItemsControl>

                                    <!--  Stays put, with reasons  -->
                                    <Border x:Name="SkippedBox" Grid.Row="2" Grid.ColumnSpan="3" MaxHeight="150" Margin="0,12,0,0" Padding="14,10" Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="6" Visibility="{Binding SkippedRows.Count, Converter={StaticResource OrgVisible}}">
                                        <DockPanel>
                                            <TextBlock Margin="0,0,0,6" DockPanel.Dock="Top" Style="{StaticResource OrgCardTitle}" Text="{Binding SkippedTitle}" />
                                            <ItemsControl AutomationProperties.Name="Files that stay put" ItemsSource="{Binding SkippedRows}" Style="{StaticResource OrgVirtualList}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type local:SkipRow}">
                                                        <Grid Margin="0,3,12,3">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <ui:SymbolIcon Margin="0,0,8,0" FontSize="15" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Symbol="{Binding Icon, Converter={StaticResource OrgSymbol}}" />
                                                            <TextBlock Grid.Column="1" FontSize="12.5" TextTrimming="CharacterEllipsis" ToolTip="{Binding Reason}">
                                                                <Run Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Name, Mode=OneWay}" />
                                                                <Run Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Reason, Mode=OneWay, StringFormat=' - {0}'}" />
                                                            </TextBlock>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </DockPanel>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                    </ScrollViewer>

                    <!--  Sticky action bar: Simulate + the one primary action  -->
                    <Border Grid.Row="3" Style="{StaticResource OrgStickyBar}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Margin="0,0,14,0" VerticalAlignment="Center" FontSize="22" Filled="True" Foreground="{DynamicResource TidyAccentBrush}" Symbol="FolderArrowRight24" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Summary}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Style="{StaticResource OrgSecondary}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding SummaryDetail}" ToolTip="{Binding SummaryDetail}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="12,0,0,0" Orientation="Horizontal">
                                <ui:Button
                                    Height="40"
                                    Margin="0,0,8,0"
                                    Appearance="Secondary"
                                    AutomationProperties.Name="Simulate: see what would happen, change nothing"
                                    Command="{Binding SimulateCommand}"
                                    Content="Simulate"
                                    Icon="{ui:SymbolIcon Beaker24}"
                                    ToolTip="See exactly what would happen. Nothing changes." />
                                <ui:Button
                                    Height="40"
                                    MinWidth="150"
                                    Appearance="Primary"
                                    AutomationProperties.Name="{Binding MoveButtonText}"
                                    Command="{Binding MoveCommand}"
                                    Content="{Binding MoveButtonText}"
                                    FontWeight="SemiBold"
                                    Icon="{ui:SymbolIcon FolderArrowRight24}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ================================================================== Rename -->
            <TabItem AutomationProperties.Name="Rename files" DataContext="{Binding Rename}" Header="Rename">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource OrgCard}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Style="{StaticResource OrgCardTitle}" Text="How to rename" />
                                <TextBlock Margin="0,2,0,10" Style="{StaticResource OrgCaption}" Text="Loose files in the folder chosen at the top. Nothing changes until you confirm." />
                                <ui:Button Margin="0,0,0,12" Appearance="Secondary" AutomationProperties.Name="Load files" Command="{Binding LoadCommand}" Content="Load files" Icon="{ui:SymbolIcon FolderOpen24}" />
                                <CheckBox AutomationProperties.Name="Fix messy names" Content="Fix messy names" IsChecked="{Binding FixMessyNames}" ToolTip="Removes (1), - Copy, Copy of; turns _ and . into spaces; tidies spaces; lower-case extension" />
                                <CheckBox AutomationProperties.Name="Lower-case extensions" Content="Lower-case extensions" IsChecked="{Binding LowercaseExtension}" />
                                <TextBlock Margin="0,10,0,2" Style="{StaticResource OrgCaption}" Text="Find" />
                                <ui:TextBox AutomationProperties.Name="Find" PlaceholderText="Text to find" Text="{Binding Find, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Margin="0,6,0,2" Style="{StaticResource OrgCaption}" Text="Replace with ({date} {year} {month} {day} work here)" />
                                <ui:TextBox AutomationProperties.Name="Replace with" PlaceholderText="New text" Text="{Binding Replace, UpdateSourceTrigger=PropertyChanged}" />
                                <CheckBox AutomationProperties.Name="Use a pattern" Content="Pattern (regular expression)" IsChecked="{Binding UseRegex}" />
                                <CheckBox AutomationProperties.Name="Match case" Content="Match case" IsChecked="{Binding MatchCase}" />
                                <CheckBox AutomationProperties.Name="Include extension" Content="Also look in the extension" IsChecked="{Binding IncludeExtension}" />
                                <TextBlock Margin="0,10,0,2" Style="{StaticResource OrgCaption}" Text="Letter case" />
                                <ComboBox AutomationProperties.Name="Letter case" ItemsSource="{Binding CaseOptions}" SelectedItem="{Binding Case}" />
                                <CheckBox Margin="0,10,0,0" AutomationProperties.Name="Add a number" Content="Add a number" IsChecked="{Binding AddNumber}" />
                                <StackPanel Orientation="Horizontal" Visibility="{Binding AddNumber, Converter={StaticResource OrgVisible}}">
                                    <ui:NumberBox Width="110" AutomationProperties.Name="Start at" Maximum="999999" Minimum="0" Value="{Binding NumberStart}" />
                                    <ui:NumberBox Width="100" Margin="6,0" AutomationProperties.Name="Digits" Maximum="9" Minimum="1" Value="{Binding NumberDigits}" />
                                    <ComboBox AutomationProperties.Name="Number position" ItemsSource="{Binding NumberPositions}" SelectedItem="{Binding NumberPosition}" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource OrgCard}">
                        <DockPanel>
                            <TextBlock Margin="0,0,0,8" DockPanel.Dock="Top" Style="{StaticResource OrgCardTitle}" Text="{Binding Summary}" />
                            <ListView AutomationProperties.Name="Rename preview" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource TidyGridRow}" ItemsSource="{Binding Rows}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                <ListView.View>
                                    <GridView ColumnHeaderContainerStyle="{StaticResource TidyGridHeader}">
                                        <GridViewColumn Width="40">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox MinWidth="0" AutomationProperties.Name="{Binding OldName}" IsChecked="{Binding IsChecked}" IsEnabled="{Binding CanRename}" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Width="260" DisplayMemberBinding="{Binding OldName}" Header="Now" />
                                        <GridViewColumn Width="260" DisplayMemberBinding="{Binding NewName}" Header="After" />
                                        <GridViewColumn Width="260" DisplayMemberBinding="{Binding Note}" Header="Note" />
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource OrgStickyBar}">
                        <DockPanel>
                            <ui:Button Height="40" MinWidth="160" Appearance="Primary" AutomationProperties.Name="Rename files" Command="{Binding RenameCommand}" Content="{Binding RenameButtonText}" DockPanel.Dock="Right" FontWeight="SemiBold" Icon="{ui:SymbolIcon Rename24}" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="Renames happen in place" />
                                <TextBlock Style="{StaticResource OrgSecondary}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Swaps and case-only changes go through a temporary name · every rename can be put back from History" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ================================================================== Watch -->
            <TabItem AutomationProperties.Name="Watch folders" DataContext="{Binding Watch}" Header="Watch folders">
                <ScrollViewer Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource OrgCard}">
                            <DockPanel>
                                <ui:ToggleSwitch AutomationProperties.Name="Watch folders on or off" DockPanel.Dock="Right" IsChecked="{Binding IsEnabled}" />
                                <StackPanel>
                                    <TextBlock Style="{StaticResource OrgCardTitle}" Text="Keep folders tidy automatically" />
                                    <TextBlock Style="{StaticResource OrgCaption}" Text="New files are looked at after 10 quiet minutes. Only rules you switched to automatic run without asking (moves and renames only). Each batch shows in History with its own Undo." />
                                    <TextBlock Margin="0,6,0,0" Style="{StaticResource OrgSecondary}" Text="{Binding StatusText}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Border Margin="0,12,0,0" Style="{StaticResource OrgCard}">
                            <StackPanel>
                                <DockPanel>
                                    <ui:Button Appearance="Transparent" AutomationProperties.Name="Add a folder to watch" Command="{Binding AddFolderCommand}" Content="Add folder" DockPanel.Dock="Right" Icon="{ui:SymbolIcon FolderAdd24}" />
                                    <TextBlock VerticalAlignment="Center" Style="{StaticResource OrgCardTitle}" Text="Watched folders" />
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding Folders}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,4">
                                                <ui:Button Padding="4" Appearance="Transparent" AutomationProperties.Name="Stop watching this folder" Command="{Binding DataContext.RemoveFolderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" DockPanel.Dock="Right" Icon="{ui:SymbolIcon Dismiss24}" />
                                                <ui:SymbolIcon Margin="0,0,8,0" Filled="True" Foreground="#E8B84A" Symbol="Folder24" />
                                                <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding}" TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,12,0,0" Style="{StaticResource OrgCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource OrgCardTitle}" Text="Automatic rules" />
                                <TextBlock Style="{StaticResource OrgCaption}" Text="Switch a rule to automatic in its editor (Sort files tab, the … next to a rule, then Edit)." />
                                <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding AutomaticRules}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Margin="0,2" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding StringFormat='• {0}'}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <DockPanel Margin="0,12,0,0">
                                    <ui:Button Appearance="Primary" AutomationProperties.Name="Review waiting files" Command="{Binding ReviewPendingCommand}" Content="Review" DockPanel.Dock="Right" Icon="{ui:SymbolIcon Eye24}" />
                                    <TextBlock VerticalAlignment="Center" Style="{StaticResource OrgSecondary}" Text="{Binding PendingText}" />
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <!-- ================================================================== Google Takeout -->
            <TabItem AutomationProperties.Name="Sort a Google Takeout export" DataContext="{Binding Takeout}" Header="Google Takeout">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <c:StepBar Margin="0,0,0,12" Captions="{Binding StepCaptions}" Current="{Binding Step}" />

                    <!--  Folders and preview. On a short window this part scrolls (the preview keeps a usable height) while the step bar and the action bar stay put. See OnTakeoutAreaSizeChanged.  -->
                    <ScrollViewer x:Name="TakeoutScroll" Grid.Row="1" Focusable="False" SizeChanged="OnTakeoutAreaSizeChanged" VerticalScrollBarVisibility="Disabled">
                    <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <!--  Where from, where to, how  -->
                    <Border Padding="16,12" Style="{StaticResource OrgCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.ColumnSpan="3" Margin="0,0,0,8" Style="{StaticResource OrgCaption}" Visibility="{Binding HasPreview, Converter={StaticResource OrgVisible}, ConverterParameter=invert}" Text="Unpack your Google Takeout download, then pick that folder. Photos are sorted by the date Google says they were taken; each photo's info file (.json) moves along with it." />
                            <TextBlock Grid.Row="1" Margin="0,0,12,0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="Takeout folder" />
                            <TextBlock Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource OrgSecondary}" Text="{Binding SourceText}" ToolTip="{Binding SourceText}" />
                            <ui:Button Grid.Row="1" Grid.Column="2" Margin="8,2" AutomationProperties.Name="Choose the Takeout folder" Command="{Binding PickSourceCommand}" Content="Choose…" />
                            <TextBlock Grid.Row="2" Margin="0,0,12,0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="Sort into" />
                            <TextBlock Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource OrgSecondary}" Text="{Binding DestinationText}" ToolTip="{Binding DestinationText}" />
                            <ui:Button Grid.Row="2" Grid.Column="2" Margin="8,2" AutomationProperties.Name="Choose where the sorted photos go" Command="{Binding PickDestinationCommand}" Content="Choose…" />
                            <DockPanel Grid.Row="3" Grid.ColumnSpan="3" Margin="0,8,0,0">
                                <ui:Button Appearance="Secondary" AutomationProperties.Name="Scan the Takeout folder" Command="{Binding ScanCommand}" Content="Scan" DockPanel.Dock="Right" Icon="{ui:SymbolIcon ArrowClockwise24}" />
                                <CheckBox AutomationProperties.Name="Keep album folders" Content="Keep album folders (Albums\name), the rest by date" IsChecked="{Binding KeepAlbums}" ToolTip="Off: every photo goes to year and month folders, like 2019\2019-09" />
                            </DockPanel>
                        </Grid>
                    </Border>

                    <!--  Preview  -->
                    <Border x:Name="TakeoutPreview" Grid.Row="1" Margin="0,12,0,0" Padding="18,14" Style="{StaticResource OrgCard}">
                        <Grid>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasPreview, Converter={StaticResource OrgVisible}, ConverterParameter=invert}">
                                <ui:SymbolIcon x:Name="TakeoutEmptyIcon" HorizontalAlignment="Center" FontSize="40" Foreground="{DynamicResource TidyAccentBrush}" Symbol="ImageMultiple24" />
                                <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" Style="{StaticResource OrgCardTitle}" Text="{Binding EmptyTitle}" />
                                <TextBlock MaxWidth="460" Margin="0,4,0,0" HorizontalAlignment="Center" Style="{StaticResource OrgCaption}" Text="{Binding EmptyMessage}" TextAlignment="Center" />
                                <!--  "Sort into" isn't usable yet (not chosen, or in OneDrive without the user's OK): the one thing to do next.  -->
                                <ui:Button Margin="0,12,0,0" HorizontalAlignment="Center" Appearance="Primary" AutomationProperties.Name="Choose a folder for the sorted photos" Command="{Binding PickDestinationCommand}" Content="Choose a folder…" Icon="{ui:SymbolIcon FolderOpen24}" Visibility="{Binding DestinationProblem, Converter={StaticResource OrgVisible}}" />
                                <ui:ProgressRing Margin="0,12,0,0" HorizontalAlignment="Center" IsIndeterminate="True" Visibility="{Binding IsScanning, Converter={StaticResource OrgVisible}}" />
                                <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" Style="{StaticResource OrgCaption}" Text="{Binding ProgressText}" />
                            </StackPanel>
                            <Grid Visibility="{Binding HasPreview, Converter={StaticResource OrgVisible}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ItemsControl AutomationProperties.Name="Notes" Focusable="False" ItemsSource="{Binding Notes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Margin="0,0,0,4" Style="{StaticResource OrgCaption}" Text="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl Grid.Row="1" AutomationProperties.Name="Photos to sort" ItemsSource="{Binding Rows}" Style="{StaticResource OrgVirtualList}">
                                    <ItemsControl.Resources>
                                        <DataTemplate DataType="{x:Type local:ActionGroupViewModel}">
                                            <StackPanel Margin="0,10,0,4">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource OrgCardTitle}" Text="{Binding Title}" />
                                                    <TextBlock Margin="8,1,0,0" Style="{StaticResource OrgCaption}" Text="{Binding CountText}" />
                                                </StackPanel>
                                                <TextBlock Style="{StaticResource OrgCaption}" Text="{Binding Description}" />
                                            </StackPanel>
                                        </DataTemplate>
                                        <DataTemplate DataType="{x:Type local:ActionRowViewModel}">
                                            <Border BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                                                <Grid Margin="0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="80" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox MinWidth="0" VerticalAlignment="Center" AutomationProperties.Name="{Binding Name}" IsChecked="{Binding IsChecked}" />
                                                    <ui:SymbolIcon Grid.Column="1" Margin="4,0,8,0" FontSize="16" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Symbol="{Binding Icon, Converter={StaticResource OrgSymbol}}" />
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                                        <TextBlock Style="{StaticResource OrgSecondary}" Text="{Binding Detail}" ToolTip="{Binding Detail}" />
                                                        <TextBlock Style="{StaticResource OrgCaption}" Text="{Binding Reason}" />
                                                    </StackPanel>
                                                    <Border Grid.Column="3" Margin="8,0" VerticalAlignment="Center" Style="{StaticResource OrgPill}">
                                                        <TextBlock FontSize="11" Foreground="{DynamicResource TidyAccentBrush}" Text="{Binding BadgeText}" />
                                                    </Border>
                                                    <TextBlock Grid.Column="4" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Size}" TextAlignment="Right" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.Resources>
                                </ItemsControl>
                                <Border Grid.Row="2" MaxHeight="120" Margin="0,12,0,0" Padding="14,10" Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="6" Visibility="{Binding SkippedRows.Count, Converter={StaticResource OrgVisible}}">
                                    <DockPanel>
                                        <TextBlock Margin="0,0,0,6" DockPanel.Dock="Top" Style="{StaticResource OrgCardTitle}" Text="{Binding SkippedTitle}" />
                                        <ItemsControl AutomationProperties.Name="Files that stay put" ItemsSource="{Binding SkippedRows}" Style="{StaticResource OrgVirtualList}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type local:SkipRow}">
                                                    <TextBlock Margin="0,2" FontSize="12.5" TextTrimming="CharacterEllipsis" ToolTip="{Binding Reason}">
                                                        <Run Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Name, Mode=OneWay}" />
                                                        <Run Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Reason, Mode=OneWay, StringFormat=' - {0}'}" />
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </DockPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                    </Grid>
                    </ScrollViewer>

                    <!--  Sticky action bar  -->
                    <Border Grid.Row="2" Style="{StaticResource OrgStickyBar}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Summary}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Style="{StaticResource OrgSecondary}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding SummaryDetail}" ToolTip="{Binding SummaryDetail}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" Orientation="Horizontal">
                                <ui:Button Height="40" Margin="0,0,8,0" Appearance="Secondary" AutomationProperties.Name="Simulate: see what would happen, change nothing" Command="{Binding SimulateCommand}" Content="Simulate" Icon="{ui:SymbolIcon Beaker24}" />
                                <ui:Button Height="40" MinWidth="150" Appearance="Primary" AutomationProperties.Name="{Binding SortButtonText}" Command="{Binding SortCommand}" Content="{Binding SortButtonText}" FontWeight="SemiBold" Icon="{ui:SymbolIcon ImageMultiple24}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>    </Grid>
</UserControl>
