<UserControl
    x:Class="PcTidy.Features.Developer.UI.DevTabView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:PcTidy.UI.Controls;assembly=PcTidy.UI"
    xmlns:flow="clr-namespace:PcTidy.UI.Flow;assembly=PcTidy.UI"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Toolbar: what this tab does, scan  -->
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="TabTitle" Style="{StaticResource SectionTitle}" />
                <TextBlock x:Name="TabBlurb" Style="{StaticResource Secondary}" TextWrapping="Wrap" />
            </StackPanel>
            <ui:Button
                x:Name="ScanButton"
                Grid.Column="1"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                Appearance="Secondary"
                AutomationProperties.Name="Scan"
                Click="OnScanClick"
                Content="Scan"
                Icon="{ui:SymbolIcon ArrowClockwise24}" />
        </Grid>

        <!--  Tab-specific options (folders to look in, archive folder...)  -->
        <ContentControl x:Name="OptionsHost" Grid.Row="1" Focusable="False" />

        <StackPanel x:Name="NotesPanel" Grid.Row="2" />

        <!--  Ready / not available  -->
        <Border x:Name="ReadyState" Grid.Row="3" VerticalAlignment="Top" Style="{StaticResource TidyCard}">
            <c:EmptyState x:Name="ReadyEmpty" ActionClick="OnScanClick" ActionIcon="ScanDash24" ActionText="Scan now" Icon="Code24" />
        </Border>

        <!--  Scanning  -->
        <Border x:Name="ScanningState" Grid.Row="3" Padding="28,24" VerticalAlignment="Top" Style="{StaticResource TidyCard}" Visibility="Collapsed">
            <StackPanel>
                <DockPanel>
                    <ui:ProgressRing Width="40" Height="40" Margin="0,0,16,0" IsIndeterminate="True" />
                    <ui:Button
                        VerticalAlignment="Center"
                        Appearance="Secondary"
                        AutomationProperties.Name="Stop scanning"
                        Click="OnCancelScan"
                        Content="Stop"
                        DockPanel.Dock="Right"
                        Icon="{ui:SymbolIcon Dismiss24}" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Looking…" />
                        <TextBlock x:Name="ScanMessage" Style="{StaticResource SecondaryTrim}" />
                    </StackPanel>
                </DockPanel>
                <ProgressBar x:Name="ScanBar" Height="4" Margin="0,18,0,0" IsIndeterminate="True" />
                <TextBlock Margin="0,14,0,0" Style="{StaticResource Caption}" Text="Scanning only looks. Nothing is changed until you confirm." />
            </StackPanel>
        </Border>

        <!--  Results  -->
        <Grid x:Name="ResultsState" Grid.Row="3" Visibility="Collapsed">
            <flow:ResultsPanel x:Name="Results" />
            <c:EmptyState x:Name="NothingFound" Icon="CheckmarkCircle24" Title="All tidy" Visibility="Collapsed" />
        </Grid>

        <!--  Sticky action bar  -->
        <Border x:Name="StickyBar" Grid.Row="4" Style="{StaticResource StickyBar}" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="SelectedText" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="SelectedCaption" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:Button
                        x:Name="SimulateButton"
                        Height="40"
                        Margin="0,0,8,0"
                        Appearance="Secondary"
                        AutomationProperties.Name="Simulate: see what would happen, change nothing"
                        Click="OnSimulate"
                        Content="Simulate"
                        Icon="{ui:SymbolIcon Beaker24}" />
                    <ui:Button
                        x:Name="PrimaryButton"
                        Height="40"
                        MinWidth="140"
                        Appearance="Primary"
                        Click="OnPrimary"
                        FontWeight="SemiBold"
                        Icon="{ui:SymbolIcon Checkmark24}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
