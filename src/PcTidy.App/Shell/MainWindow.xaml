<ui:FluentWindow
    x:Class="PcTidy.App.Shell.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="PC Tidy"
    Width="1280"
    Height="800"
    MinWidth="1000"
    MinHeight="680"
    ExtendsContentIntoTitleBar="True"
    FontFamily="{StaticResource TidyText}"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!--  3.2 Workbench (option C): tabs along the top, the tab's pages on the left, the page on the right.
             The NavigationView still hosts every page; its own left pane is hidden (IsPaneVisible=False).  -->

        <ui:TitleBar
            x:Name="AppTitleBar"
            Title="PC Tidy"
            Grid.Row="0"
            Height="48"
            CloseWindowByDoubleClickOnIcon="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Width="20" Height="20" Source="{StaticResource TidyLogo}" />
            </ui:TitleBar.Icon>
            <ui:TitleBar.TrailingContent>
                <Border
                    x:Name="DemoPill"
                    Margin="0,0,10,0"
                    Padding="8,2"
                    VerticalAlignment="Center"
                    Background="{DynamicResource TidyAccentSoftBrush}"
                    CornerRadius="10"
                    Visibility="Collapsed">
                    <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TidyAccentTextBrush}" Text="Demo · sample data" />
                </Border>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <Grid x:Name="WorkArea" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="TabBarHost" Grid.ColumnSpan="2" />
            <Border x:Name="InnerListHost" Grid.Row="1" />
        <ui:NavigationView
            x:Name="RootNavigation"
            Grid.Row="1"
            Grid.Column="1"
            IsPaneVisible="False"
            IsPaneOpen="False"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleVisible="False"
            OpenPaneLength="232"
            CompactPaneLength="0"
            PaneDisplayMode="Left"
            Transition="FadeInWithSlide">
            <ui:NavigationView.Resources>
                <!--  Compact rail: every v2 section fits the smallest window (1000x680); with more sections the rail scrolls, with a visible bar (ShowRailScrollBar)  -->
                <Style BasedOn="{StaticResource {x:Type ui:NavigationViewItem}}" TargetType="{x:Type ui:NavigationViewItem}">
                    <Setter Property="Height" Value="28" />
                    <Setter Property="MinHeight" Value="28" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="FontSize" Value="13.5" />
                </Style>
                <Style BasedOn="{StaticResource {x:Type ui:NavigationViewItemHeader}}" TargetType="{x:Type ui:NavigationViewItemHeader}">
                    <Setter Property="Margin" Value="14,6,0,1" />
                    <Setter Property="FontSize" Value="11" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                </Style>
            </ui:NavigationView.Resources>
        </ui:NavigationView>
        </Grid>

        <!--  First-run onboarding (3 screens)  -->
        <Grid x:Name="OnboardingOverlay" Grid.Row="1" Background="{DynamicResource TidyOverlayBrush}" Visibility="Collapsed" />

        <!--  Run progress (while the engine works)  -->
        <Grid x:Name="ProgressOverlay" Grid.Row="0" Grid.RowSpan="2" Background="{DynamicResource TidyScrimBrush}" Visibility="Collapsed">
            <Border Width="520" Padding="28,24" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10">
                <StackPanel>
                    <DockPanel>
                        <ui:ProgressRing Width="36" Height="36" Margin="0,0,16,0" IsIndeterminate="True" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="ProgressTitle" Style="{StaticResource SectionTitle}" Text="Working…" />
                            <TextBlock x:Name="ProgressMessage" Style="{StaticResource SecondaryTrim}" />
                        </StackPanel>
                    </DockPanel>
                    <ProgressBar x:Name="ProgressBar" Height="4" Margin="0,18,0,0" Maximum="100" />
                    <!--  Per-section states (Waiting · Running · Done · Skipped · Needs restart) when a run has several sections  -->
                    <ScrollViewer x:Name="ProgressSectionsScroll" MaxHeight="220" Margin="0,14,0,0" Focusable="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel x:Name="ProgressSectionsPanel" AutomationProperties.Name="Sections of this run" />
                    </ScrollViewer>
                    <TextBlock x:Name="ProgressSaved" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite" Style="{StaticResource Secondary}" TextWrapping="Wrap" Visibility="Collapsed" />
                    <DockPanel Margin="0,14,0,0">
                        <ui:Button
                            x:Name="ProgressStop"
                            Appearance="Secondary"
                            AutomationProperties.Name="Stop after this step"
                            Content="Stop after this step"
                            DockPanel.Dock="Right" />
                        <TextBlock x:Name="ProgressCount" VerticalAlignment="Center" Style="{StaticResource Caption}" />
                    </DockPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!--  Replayable spotlight tour (Help and Settings): dims everything but the step's target  -->
        <Grid x:Name="TourLayer" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed" />

        <ui:ContentDialogHost x:Name="RootDialogHost" Grid.Row="0" Grid.RowSpan="2" />
    </Grid>
</ui:FluentWindow>
