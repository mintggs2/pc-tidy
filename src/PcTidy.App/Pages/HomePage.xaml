<UserControl
    x:Class="PcTidy.App.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:PcTidy.UI.Controls;assembly=PcTidy.UI"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    AutomationProperties.Name="Home"
    FontFamily="{StaticResource TidyText}">

    <!--  UserControl pages get no outer ScrollViewer from the NavigationView: scroll here.  -->
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="32,16,32,24">
        <!--  Header  -->
        <TextBlock x:Name="Greeting" Style="{StaticResource PageTitle}" />
        <TextBlock x:Name="SubtitleText" Style="{StaticResource PageSubtitle}" />

        <!--  Banners (settings file problem, unfinished run): built in code, buttons under each bar  -->
        <StackPanel x:Name="Banners" Margin="0,14,0,0" Visibility="Collapsed" />

        <!--  Optimize & Organize everything  -->
        <Border Margin="0,16,0,0" Style="{StaticResource HeroCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="56" Height="56" VerticalAlignment="Center" Background="{DynamicResource AccentFillColorDefaultBrush}" CornerRadius="12">
                    <ui:SymbolIcon FontSize="30" Filled="True" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" Symbol="Sparkle24" />
                </Border>
                <StackPanel Grid.Column="1" Margin="18,0,16,0" VerticalAlignment="Center">
                    <TextBlock FontFamily="{StaticResource TidyDisplay}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="Optimize &amp; Organize everything" TextWrapping="Wrap" />
                    <TextBlock x:Name="PresetHint" Margin="0,3,0,10" Style="{StaticResource Secondary}" Text="Scans everything, shows one combined preview, nothing changes until you confirm." />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="0,0,10,0" VerticalAlignment="Center" Style="{StaticResource Caption}" Text="Preset" />
                        <c:Segmented x:Name="PresetPicker" Items="Safe|Recommended|Gamer|Privacy" Label="Preset" SelectedIndex="1" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <ui:Button
                        x:Name="OptimizeButton"
                        Height="48"
                        MinWidth="200"
                        Padding="20,0"
                        Appearance="Primary"
                        AutomationProperties.Name="Scan everything"
                        Click="OnOptimize"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Icon="{ui:SymbolIcon ArrowRight24}">
                        <TextBlock Text="Scan everything" />
                    </ui:Button>
                    <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" Style="{StaticResource Caption}" Text="Only looks · you confirm once" />
                </StackPanel>
            </Grid>
        </Border>

        <!--  Cards: 3 columns where they fit, 2 on narrower windows (never touching)  -->
        <c:ResponsiveGrid x:Name="TopCards" Margin="0,16,0,0" Gap="16" MaxColumns="3" MinItemWidth="290">

            <!--  You could clean up about…  -->
            <Border x:Name="FreeCard" Style="{StaticResource TidyCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Secondary}" Text="You could clean up about" />
                    <StackPanel x:Name="FreeNumberPanel" Orientation="Horizontal">
                        <TextBlock x:Name="FreeNumber" Style="{StaticResource BigNumber}" />
                        <TextBlock x:Name="FreeUnit" Margin="6,0,0,7" VerticalAlignment="Bottom" FontFamily="{StaticResource TidyDisplay}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </StackPanel>
                    <TextBlock x:Name="FreeNotChecked" Margin="0,6,0,0" Style="{StaticResource SectionTitle}" Text="Not checked yet" TextWrapping="Wrap" />
                    <Grid x:Name="BreakdownBar" Height="8" Margin="0,10,0,10" Visibility="Collapsed" />
                    <StackPanel x:Name="BreakdownLegend" Visibility="Collapsed" />
                    <TextBlock x:Name="FreeHint" Margin="0,4,0,0" Style="{StaticResource Secondary}" Text="A quick look at temp files and caches. It only looks; nothing changes." />
                    <WrapPanel Margin="0,14,0,0">
                        <ui:Button x:Name="FreeButton" MinWidth="96" Appearance="Secondary" AutomationProperties.Name="Check how much space you could clean up" Click="OnFreeButton" Content="Check now" Icon="{ui:SymbolIcon ScanDash24}" />
                        <ui:ProgressRing x:Name="FreeRing" Width="18" Height="18" Margin="12,0,0,0" IsIndeterminate="True" Visibility="Collapsed" />
                        <TextBlock x:Name="FreeCaption" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource Caption}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!--  Health score: never a number before a check; always its reasons; can be hidden in Settings  -->
            <Border x:Name="HealthCard" Style="{StaticResource TidyCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="PC health" />
                    <StackPanel x:Name="HealthNotChecked" Margin="0,10,0,0">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Not checked yet" TextWrapping="Wrap" />
                        <TextBlock Margin="0,4,0,0" Style="{StaticResource Secondary}" Text="A quick, read-only look at free space and leftovers. You'll see every reason behind the result." />
                        <ui:Button x:Name="HealthCheckButton" Margin="0,14,0,0" Appearance="Secondary" AutomationProperties.Name="Check PC health now" Click="OnHealthCheck" Content="Check now" Icon="{ui:SymbolIcon ScanDash24}" />
                    </StackPanel>
                    <Grid x:Name="HealthChecked" Margin="0,10,0,0" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="72" Height="72" VerticalAlignment="Top">
                            <c:RingGauge x:Name="HealthRing" Thickness="7" />
                            <TextBlock x:Name="HealthNumber" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource TidyDisplay}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Grid>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="HealthLabel" FontFamily="{StaticResource TidyDisplay}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" />
                            <TextBlock x:Name="HealthCaption" Style="{StaticResource Secondary}" />
                        </StackPanel>
                    </Grid>
                    <StackPanel x:Name="HealthReasons" Margin="0,12,0,0" />
                </StackPanel>
            </Border>

            <!--  Drives  -->
            <Border x:Name="DrivesCard" Style="{StaticResource TidyCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Drive space" />
                    <ContentControl x:Name="DrivesHost" Margin="0,12,0,0" Focusable="False" />
                </StackPanel>
            </Border>
        </c:ResponsiveGrid>

        <!--  Last run · quarantine · quick actions  -->
        <c:ResponsiveGrid Margin="0,16,0,0" Gap="16" MaxColumns="3" MinItemWidth="290">
            <Border Style="{StaticResource TidyCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border VerticalAlignment="Top" Style="{StaticResource IconTile}">
                        <ui:SymbolIcon FontSize="18" Foreground="{DynamicResource TidyAccentBrush}" Symbol="History24" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                        <TextBlock x:Name="LastRunWhen" Style="{StaticResource Caption}" Text="LAST RUN" />
                        <TextBlock x:Name="LastRunTitle" Margin="0,2,0,0" Style="{StaticResource CardTitle}" TextTrimming="None" TextWrapping="Wrap" />
                        <TextBlock x:Name="LastRunDetail" Style="{StaticResource Secondary}" />
                        <WrapPanel Margin="0,10,0,0">
                            <Button x:Name="UndoLastButton" Margin="0,0,16,0" AutomationProperties.Name="Undo the last run" Click="OnUndoLast" Style="{StaticResource LinkButton}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Margin="0,0,5,0" FontSize="14" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Symbol="ArrowUndo24" />
                                    <TextBlock FontWeight="SemiBold" Text="Undo this run" />
                                </StackPanel>
                            </Button>
                            <Button AutomationProperties.Name="View in History" Click="OnHistory" Content="View in History" Style="{StaticResource LinkButton}" />
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource TidyCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border VerticalAlignment="Top" Style="{StaticResource IconTile}">
                        <ui:SymbolIcon FontSize="18" Foreground="{DynamicResource TidyAccentBrush}" Symbol="ArchiveArrowBack24" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                        <TextBlock Style="{StaticResource Caption}" Text="QUARANTINE" />
                        <TextBlock x:Name="QuarantineTitle" Margin="0,2,0,0" Style="{StaticResource CardTitle}" />
                        <TextBlock x:Name="QuarantineDetail" Style="{StaticResource Secondary}" />
                        <Button Margin="0,10,0,0" HorizontalAlignment="Left" AutomationProperties.Name="Open quarantine" Click="OnQuarantine" Content="Open quarantine" Style="{StaticResource LinkButton}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Padding="12,14" Style="{StaticResource TidyCard}">
                <StackPanel x:Name="QuickActions">
                    <TextBlock Margin="8,0,0,6" Style="{StaticResource Caption}" Text="QUICK ACTIONS" />
                </StackPanel>
            </Border>
        </c:ResponsiveGrid>

        <!--  Trust strip  -->
        <Border Margin="0,16,0,0" Padding="16,10" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
            <DockPanel>
                <ui:SymbolIcon Margin="0,0,10,0" FontSize="18" Foreground="{DynamicResource TidyAccentBrush}" Symbol="ShieldCheckmark24" />
                <Button Margin="12,0,0,0" VerticalAlignment="Center" AutomationProperties.Name="How PC Tidy keeps you safe" Click="OnSafety" Content="How PC Tidy keeps you safe" DockPanel.Dock="Right" Style="{StaticResource LinkButton}" />
                <TextBlock VerticalAlignment="Center" Style="{StaticResource Secondary}">
                    <Run x:Name="TrustLead" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <Run x:Name="TrustText" />
                </TextBlock>
            </DockPanel>
        </Border>
    </StackPanel>
    </ScrollViewer>
</UserControl>
