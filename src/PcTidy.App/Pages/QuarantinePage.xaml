<UserControl
    x:Class="PcTidy.App.Pages.QuarantinePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:PcTidy.UI.Controls;assembly=PcTidy.UI"
    xmlns:p="clr-namespace:PcTidy.App.Pages"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    AutomationProperties.Name="Quarantine"
    FontFamily="{StaticResource TidyText}">

    <UserControl.Resources>
        <DataTemplate DataType="{x:Type p:QuarantineRunRow}">
            <Border
                Margin="0,6,0,0"
                Padding="16,10,12,10"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                MouseLeftButtonUp="OnRunHeaderClick">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="34" Height="34" VerticalAlignment="Center" Style="{StaticResource IconTile}">
                        <ui:SymbolIcon FontSize="17" Foreground="{DynamicResource TidyAccentBrush}" Symbol="ArchiveArrowBack24" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource CardTitle}" Text="{Binding Title}" />
                        <TextBlock Style="{StaticResource SecondaryTrim}" Text="{Binding Detail}" />
                    </StackPanel>
                    <c:BadgePill Grid.Column="2" Margin="0,0,12,0" Text="{Binding AgeText}" Tone="{Binding AgeTone}" />
                    <c:SizeText Grid.Column="3" Bytes="{Binding Bytes}" />
                    <StackPanel Grid.Column="4" Margin="12,0,0,0" Orientation="Horizontal">
                        <ui:Button Margin="0,0,6,0" AutomationProperties.Name="{Binding RestoreName}" Click="OnRestoreRun" Content="Restore all" Icon="{ui:SymbolIcon ArrowUndo24}" />
                        <ui:Button Appearance="Transparent" AutomationProperties.Name="{Binding DeleteName}" Click="OnDeleteRun" Content="Delete for good…" />
                    </StackPanel>
                    <!--  Opens the run to tick single items for "Restore selected"  -->
                    <ui:Button
                        Grid.Column="5"
                        Width="32"
                        Height="32"
                        Margin="6,0,0,0"
                        Padding="0"
                        Appearance="Transparent"
                        AutomationProperties.Name="{Binding ExpandName}"
                        Click="OnToggleRun"
                        ToolTip="Show the items, to restore only some of them">
                        <ui:SymbolIcon FontSize="14" Symbol="{Binding ChevronSymbol}" />
                    </ui:Button>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type p:QuarantineItemRow}">
            <Border Margin="12,0,12,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="10,7,8,7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="90" />
                    </Grid.ColumnDefinitions>
                    <CheckBox MinWidth="0" Margin="34,0,6,0" VerticalAlignment="Center" AutomationProperties.Name="{Binding Name}" Focusable="False" IsChecked="{Binding IsChecked, Mode=TwoWay}" />
                    <StackPanel Grid.Column="1" Margin="4,0,12,0" VerticalAlignment="Center">
                        <TextBlock FontSize="13.5" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Style="{StaticResource SecondaryTrim}" FontSize="12" Text="{Binding Folder}" />
                    </StackPanel>
                    <c:SizeText Grid.Column="2" FontWeight="Normal" FontSize="13" Bytes="{Binding Entry.SizeBytes}" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="32,16,32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitle}" Text="Quarantine" />
                <TextBlock x:Name="Subtitle" Style="{StaticResource PageSubtitle}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="16,6,0,0" VerticalAlignment="Top" Orientation="Horizontal">
                <ui:Button x:Name="PurgeOldButton" Margin="0,0,8,0" Appearance="Secondary" Click="OnPurgeOld" Icon="{ui:SymbolIcon CalendarClock24}" />
                <ui:Button x:Name="TrimButton" Appearance="Secondary" Click="OnTrim" Icon="{ui:SymbolIcon Storage24}" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,14,0,0">
            <StackPanel x:Name="Reminders" />
            <!--  Items the admin helper quarantined (Windows temp, error reports…): their own section, read on request  -->
            <ContentControl x:Name="AdminHost" Focusable="False" />
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,6,0,0">
            <ListBox x:Name="List" AutomationProperties.Name="Quarantined items" PreviewKeyDown="OnListKey" Style="{StaticResource TidyFlatList}" />
            <Border x:Name="EmptyCard" VerticalAlignment="Top" Margin="0,8,0,0" Padding="0" Style="{StaticResource TidyCard}" Visibility="Collapsed">
                <c:EmptyState Icon="ArchiveArrowBack24" Title="Quarantine is empty" Message="When PC Tidy cleans something, it waits here first. You can put it back with one click until it's emptied." />
            </Border>
        </Grid>

        <Border x:Name="Bar" Grid.Row="3" Style="{StaticResource StickyBar}">
            <DockPanel>
                <ui:Button x:Name="RestoreSelected" Height="40" MinWidth="170" Appearance="Primary" AutomationProperties.Name="Restore selected items" Click="OnRestoreSelected" Content="Restore selected" DockPanel.Dock="Right" Icon="{ui:SymbolIcon ArrowUndo24}" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="SelectedText" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Style="{StaticResource Caption}" Text="Restoring never overwrites: if something new is in the way, the old copy comes back as &quot;name (restored)&quot;." />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
