<UserControl
    x:Class="PcTidy.Features.SpaceMap.View.SpaceMapView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tm="clr-namespace:PcTidy.Features.SpaceMap.Treemap"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:v="clr-namespace:PcTidy.Features.SpaceMap.View"
    AutomationProperties.Name="Space map">

    <UserControl.Resources>
        <FontFamily x:Key="SmText">Segoe UI Variable Text, Segoe UI</FontFamily>
        <FontFamily x:Key="SmDisplay">Segoe UI Variable Display, Segoe UI</FontFamily>

        <Style x:Key="SmTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource SmDisplay}" />
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="SmSubtitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource SmText}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="SmCardTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource SmText}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="SmBody" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource SmText}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="SmSecondary" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource SmText}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="SmCaption" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource SmText}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </Style>
        <Style x:Key="SmSize" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource SmText}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="SmCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style x:Key="SmSwatch" TargetType="Border">
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!--  Pivot header (Folders · File types · Top files · Big and old)  -->
        <Style x:Key="SmPivotItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,28,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <StackPanel Background="Transparent">
                            <TextBlock
                                x:Name="Label"
                                Margin="0,0,0,6"
                                FontFamily="{StaticResource SmText}"
                                FontSize="14"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{TemplateBinding Content}" />
                            <Border
                                x:Name="Line"
                                Width="20"
                                Height="3"
                                HorizontalAlignment="Center"
                                Background="{DynamicResource AccentFillColorDefaultBrush}"
                                CornerRadius="1.5"
                                Visibility="Hidden" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                <Setter TargetName="Line" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Label" Property="TextDecorations" Value="Underline" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  List row: Fluent-style subtle fill + accent pill (readable in light and dark)  -->
        <Style x:Key="SmRowItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="4,1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border
                                x:Name="Bg"
                                Padding="{TemplateBinding Padding}"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                            </Border>
                            <Border
                                x:Name="Pill"
                                Width="3"
                                Height="16"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Background="{DynamicResource AccentFillColorDefaultBrush}"
                                CornerRadius="1.5"
                                Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource FocusStrokeColorOuterBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SmLock" TargetType="ui:SymbolIcon">
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Symbol" Value="LockClosed24" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsProtected}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate DataType="{x:Type v:FolderRow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Margin="0,0,10,0" Background="{Binding Swatch}" Style="{StaticResource SmSwatch}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Style="{StaticResource SmBody}" Text="{Binding Name}" />
                    <ui:SymbolIcon Style="{StaticResource SmLock}" />
                </StackPanel>
                <TextBlock Grid.Column="2" Margin="10,0,0,0" Style="{StaticResource SmSize}" Text="{Binding SizeText}" />
                <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource SmCaption}" Text="{Binding Detail}" />
                <ProgressBar
                    Grid.Row="2"
                    Grid.Column="1"
                    Grid.ColumnSpan="2"
                    Height="3"
                    MinHeight="3"
                    Margin="0,4,0,0"
                    IsHitTestVisible="False"
                    Maximum="1"
                    Value="{Binding Fraction, Mode=OneWay}" />
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type v:MoreRow}">
            <TextBlock Margin="20,0,0,0" Style="{StaticResource SmCaption}" Text="{Binding Text}" />
        </DataTemplate>

        <DataTemplate DataType="{x:Type v:TypeRow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Margin="0,0,10,0" Background="{Binding Swatch}" Style="{StaticResource SmSwatch}" />
                <TextBlock Grid.Column="1" Style="{StaticResource SmBody}" Text="{Binding Name}" />
                <TextBlock Grid.Column="2" Margin="10,0,0,0" Style="{StaticResource SmSize}" Text="{Binding SizeText}" />
                <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource SmCaption}" Text="{Binding Detail}" />
                <ProgressBar
                    Grid.Row="2"
                    Grid.Column="1"
                    Grid.ColumnSpan="2"
                    Height="3"
                    MinHeight="3"
                    Margin="0,4,0,0"
                    IsHitTestVisible="False"
                    Maximum="1"
                    Value="{Binding Fraction, Mode=OneWay}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="32,16,32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource SmTitle}" Text="Space map" />
                <TextBlock x:Name="SubtitleText" Style="{StaticResource SmSubtitle}" Text="See what fills each drive. PC Tidy only reads sizes and dates, it never opens your files to measure them." />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="16,6,0,0" VerticalAlignment="Top" Orientation="Horizontal">
                <ComboBox
                    x:Name="DrivePicker"
                    Width="260"
                    Margin="0,0,8,0"
                    AutomationProperties.Name="Drive or folder to map"
                    DisplayMemberPath="Label"
                    SelectionChanged="OnDrivePicked" />
                <ui:Button
                    x:Name="ScanButton"
                    Appearance="Primary"
                    AutomationProperties.Name="Scan"
                    Click="OnScan"
                    Content="Scan"
                    Icon="{ui:SymbolIcon ArrowClockwise24}" />
                <ui:Button
                    x:Name="CancelButton"
                    Appearance="Secondary"
                    AutomationProperties.Name="Stop scanning"
                    Click="OnCancelScan"
                    Content="Stop"
                    Icon="{ui:SymbolIcon Dismiss24}"
                    Visibility="Collapsed" />
            </StackPanel>
        </Grid>

        <!--  Pivot  -->
        <ListBox
            x:Name="Pivot"
            Grid.Row="1"
            Margin="0,16,0,12"
            HorizontalAlignment="Left"
            AutomationProperties.Name="Views"
            Background="Transparent"
            BorderThickness="0"
            IsEnabled="False"
            ItemContainerStyle="{StaticResource SmPivotItem}"
            SelectedIndex="0"
            SelectionChanged="OnPivotChanged">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBoxItem AutomationProperties.Name="Folders" Content="Folders" />
            <ListBoxItem AutomationProperties.Name="File types" Content="File types" />
            <ListBoxItem AutomationProperties.Name="Top files" Content="Top files" />
            <ListBoxItem AutomationProperties.Name="Big and old" Content="Big and old" />
        </ListBox>

        <ui:InfoBar
            x:Name="Notice"
            Grid.Row="2"
            Margin="0,0,0,12"
            IsClosable="True"
            IsOpen="False" />

        <Grid Grid.Row="3">
            <!--  Before the first scan  -->
            <Border x:Name="EmptyState" Padding="32" Style="{StaticResource SmCard}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ui:SymbolIcon HorizontalAlignment="Center" FontSize="48" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Symbol="DataTreemap24" />
                    <TextBlock Margin="0,12,0,4" HorizontalAlignment="Center" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="What's taking up space?" />
                    <TextBlock MaxWidth="460" HorizontalAlignment="Center" Style="{StaticResource SmSecondary}" TextAlignment="Center" Text="Pick a drive or folder and press Scan. You'll get a map of every folder, the biggest files, and big files you haven't touched in months." />
                </StackPanel>
            </Border>

            <!--  Scanning  -->
            <Border x:Name="ScanningState" Padding="32" Style="{StaticResource SmCard}" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ui:ProgressRing HorizontalAlignment="Center" IsIndeterminate="True" />
                    <TextBlock x:Name="ScanHeadline" Margin="0,16,0,4" HorizontalAlignment="Center" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="Measuring…" />
                    <TextBlock x:Name="ScanCounts" HorizontalAlignment="Center" Style="{StaticResource SmSecondary}" />
                    <TextBlock x:Name="ScanFolder" MaxWidth="560" Margin="0,4,0,0" HorizontalAlignment="Center" Style="{StaticResource SmCaption}" />
                </StackPanel>
            </Border>

            <!--  Map + linked list (Folders, File types)  -->
            <Grid x:Name="MapView" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" MinWidth="250" MaxWidth="340" />
                </Grid.ColumnDefinitions>
                <Border Padding="12" Style="{StaticResource SmCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,8" LastChildFill="True">
                            <ui:Button
                                x:Name="UpButton"
                                Margin="0,0,6,0"
                                Padding="6,4"
                                Appearance="Transparent"
                                AutomationProperties.Name="Up one level"
                                Click="OnZoomOut"
                                DockPanel.Dock="Left"
                                Icon="{ui:SymbolIcon ArrowUp24}"
                                ToolTip="Up one level (Backspace)" />
                            <TextBlock
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                DockPanel.Dock="Right"
                                Style="{StaticResource SmCaption}"
                                Text="Double-click to zoom in · hatched = protected"
                                ToolTip="Click a block to select it, double-click to zoom in, right-click for actions. Hatched blocks are protected: PC Tidy never cleans them." />
                            <ItemsControl x:Name="Breadcrumb" VerticalAlignment="Center" AutomationProperties.Name="Location">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="Sep" Margin="2,0" VerticalAlignment="Center" Style="{StaticResource SmCaption}" Text="›" />
                                            <ui:Button
                                                Padding="6,3"
                                                Appearance="Transparent"
                                                AutomationProperties.Name="{Binding Name}"
                                                Click="OnBreadcrumb"
                                                Content="{Binding Name}"
                                                FontSize="13"
                                                Tag="{Binding Node}" />
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsFirst}" Value="True">
                                                <Setter TargetName="Sep" Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>

                        <Grid Grid.Row="1">
                            <tm:TreemapControl
                                x:Name="Map"
                                AutomationProperties.HelpText="Each block is a file or folder, sized by how much space it takes. Use the list on the right with the keyboard."
                                AutomationProperties.Name="Space map treemap"
                                HoverChanged="OnMapHover"
                                KeyDown="OnMapKeyDown"
                                TileClicked="OnMapClick"
                                TileContextRequested="OnMapContext" />
                            <Canvas x:Name="TipLayer" IsHitTestVisible="False">
                                <Border
                                    x:Name="Tip"
                                    MaxWidth="360"
                                    Padding="10,8"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock x:Name="TipTitle" FontWeight="SemiBold" Style="{StaticResource SmBody}" />
                                        <TextBlock x:Name="TipSize" Style="{StaticResource SmSecondary}" />
                                        <TextBlock x:Name="TipPath" Style="{StaticResource SmCaption}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </Canvas>
                        </Grid>

                        <WrapPanel Grid.Row="2" Margin="4,10,0,0">
                            <WrapPanel.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="12" />
                                    <Setter Property="Margin" Value="5,0,14,0" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Style>
                                <Style BasedOn="{StaticResource SmSwatch}" TargetType="Border" />
                            </WrapPanel.Resources>
                            <Border Background="#866BD6" /><TextBlock Text="Videos" />
                            <Border Background="#339CD6" /><TextBlock Text="Pictures" />
                            <Border Background="#CF5E96" /><TextBlock Text="Music" />
                            <Border Background="#C29A1E" /><TextBlock Text="Documents" />
                            <Border Background="#24A08C" /><TextBlock Text="Apps" />
                            <Border Background="#D97A3E" /><TextBlock Text="Games" />
                            <Border Background="#5F7FC9" /><TextBlock Text="Archives &amp; installers" />
                            <Border Background="#7A8794" /><TextBlock Text="System" />
                            <Border Background="#848E99" /><TextBlock Text="Other" />
                            <Grid Width="10" Height="10" VerticalAlignment="Center">
                                <Border Background="{DynamicResource TidyProtectedFillBrush}" CornerRadius="2" />
                                <!--  Same diagonal hatching as protected blocks in the map.  -->
                                <Border CornerRadius="2">
                                    <Border.Background>
                                        <DrawingBrush Stretch="None" TileMode="Tile" Viewport="0,0,4,4" ViewportUnits="Absolute">
                                            <DrawingBrush.Drawing>
                                                <GeometryDrawing Brush="{DynamicResource TextFillColorTertiaryBrush}" Geometry="M0,4 L4,0 L4,1.5 L1.5,4 Z M0,1.5 L1.5,0 L0,0 Z" />
                                            </DrawingBrush.Drawing>
                                        </DrawingBrush>
                                    </Border.Background>
                                </Border>
                            </Grid>
                            <TextBlock Text="Protected" />
                        </WrapPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Padding="0,14,0,8" Style="{StaticResource SmCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel Margin="16,0,16,8">
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource SmCaption}" Text="Size ↓" />
                            <TextBlock x:Name="ListTitle" Style="{StaticResource SmCardTitle}" Text="Biggest in here" />
                        </DockPanel>
                        <ListBox
                            x:Name="FolderList"
                            Grid.Row="1"
                            AutomationProperties.Name="Biggest items in this folder"
                            Background="Transparent"
                            BorderThickness="0"
                            ItemContainerStyle="{StaticResource SmRowItem}"
                            KeyDown="OnFolderListKeyDown"
                            MouseDoubleClick="OnFolderListDoubleClick"
                            ScrollViewer.CanContentScroll="True"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            SelectionChanged="OnFolderListSelection"
                            VirtualizingPanel.IsVirtualizing="True"
                            VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.ContextMenu>
                                <ContextMenu Opened="OnListContextOpened" />
                            </ListBox.ContextMenu>
                        </ListBox>
                        <ListBox
                            x:Name="TypeList"
                            Grid.Row="1"
                            AutomationProperties.Name="File types in this folder"
                            Background="Transparent"
                            BorderThickness="0"
                            ItemContainerStyle="{StaticResource SmRowItem}"
                            ScrollViewer.CanContentScroll="True"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            SelectionChanged="OnTypeSelection"
                            VirtualizingPanel.IsVirtualizing="True"
                            VirtualizingPanel.VirtualizationMode="Recycling"
                            Visibility="Collapsed" />
                    </Grid>
                </Border>
            </Grid>

            <!--  Top files / Big and old (full width)  -->
            <Border x:Name="FilesView" Padding="0,12,0,8" Style="{StaticResource SmCard}" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="FilesIntro" Margin="20,4,20,10" Style="{StaticResource SmSecondary}" />
                    <ListBox
                        x:Name="FileList"
                        Grid.Row="1"
                        AutomationProperties.Name="Files"
                        Background="Transparent"
                        BorderThickness="0"
                        ItemContainerStyle="{StaticResource SmRowItem}"
                        ScrollViewer.CanContentScroll="True"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        SelectionChanged="OnFileListSelection"
                        SelectionMode="Extended"
                        VirtualizingPanel.IsVirtualizing="True"
                        VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ContextMenu>
                            <ContextMenu Opened="OnListContextOpened" />
                        </ListBox.ContextMenu>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type v:FileRow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Margin="0,0,12,0" Background="{Binding Swatch}" Style="{StaticResource SmSwatch}" />
                                    <StackPanel Grid.Column="1">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource SmCardTitle}" Text="{Binding Name}" />
                                            <ui:SymbolIcon Style="{StaticResource SmLock}" />
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource SmCaption}" Text="{Binding Folder}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource SmSecondary}" Text="{Binding Changed}" />
                                    <TextBlock Grid.Column="3" Style="{StaticResource SmSize}" Text="{Binding SizeText}" />
                                    <StackPanel Grid.Column="4" Margin="16,0,0,0" Orientation="Horizontal">
                                        <ui:Button
                                            Margin="0,0,8,0"
                                            AutomationProperties.Name="{Binding MoveLabel}"
                                            Click="OnRowMove"
                                            Content="{Binding MoveLabel}"
                                            Icon="{ui:SymbolIcon Storage24}"
                                            Visibility="{Binding MoveVisibility}" />
                                        <ui:Button
                                            Appearance="Secondary"
                                            AutomationProperties.Name="Quarantine"
                                            Click="OnRowQuarantine"
                                            Content="Quarantine"
                                            Visibility="{Binding QuarantineVisibility}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <!--  Selection bar  -->
        <Border
            x:Name="SelectionBar"
            Grid.Row="4"
            Margin="0,12,0,0"
            Padding="16,10"
            Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Visibility="Collapsed">
            <DockPanel>
                <StackPanel VerticalAlignment="Center" DockPanel.Dock="Right" Orientation="Horizontal">
                    <ui:Button
                        x:Name="ExplainButton"
                        Margin="0,0,8,0"
                        Appearance="Secondary"
                        AutomationProperties.Name="Explain missing space"
                        Click="OnExplainMissingSpace"
                        Content="Explain missing space"
                        Icon="{ui:SymbolIcon Info24}"
                        Visibility="Collapsed" />
                    <ui:Button
                        x:Name="OpenButton"
                        Margin="0,0,8,0"
                        Appearance="Transparent"
                        AutomationProperties.Name="Show in Explorer"
                        Click="OnOpenInExplorer"
                        Content="Show in Explorer"
                        Icon="{ui:SymbolIcon Open24}" />
                    <ui:Button
                        x:Name="QuarantineButton"
                        Margin="0,0,8,0"
                        Appearance="Secondary"
                        AutomationProperties.Name="Quarantine"
                        Click="OnQuarantine"
                        Content="Quarantine"
                        Icon="{ui:SymbolIcon BoxArrowLeft24}" />
                    <ui:Button
                        x:Name="MoveButton"
                        Appearance="Primary"
                        AutomationProperties.Name="Move to another drive"
                        Click="OnMoveTo"
                        Content="Move to…"
                        Icon="{ui:SymbolIcon Storage24}" />
                </StackPanel>
                <Border x:Name="SelectionSwatch" Width="12" Height="12" Margin="0,0,10,0" VerticalAlignment="Center" CornerRadius="3" />
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="SelectionTitle" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                        <ui:SymbolIcon x:Name="SelectionLock" Margin="8,0,0,0" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Symbol="LockClosed24" Visibility="Collapsed" />
                    </StackPanel>
                    <TextBlock x:Name="SelectionCaption" Style="{StaticResource SmCaption}" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
