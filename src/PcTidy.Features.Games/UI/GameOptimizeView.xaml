<UserControl
    x:Class="PcTidy.Features.Games.UI.GameOptimizeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:PcTidy.UI.Controls;assembly=PcTidy.UI"
    xmlns:flow="clr-namespace:PcTidy.UI.Flow;assembly=PcTidy.UI"
    xmlns:local="clr-namespace:PcTidy.Features.Games.UI"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    AutomationProperties.Name="Game settings">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!--  One recipe row: tick (when it can be applied), title, why, measured number, source, evidence tag  -->
        <DataTemplate x:Key="RecipeRowTemplate" DataType="{x:Type local:RecipeRow}">
            <Border
                x:Name="RowBorder"
                Margin="0,0,0,8"
                Padding="12,10"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <CheckBox
                        MinWidth="0"
                        Margin="0,0,10,0"
                        VerticalAlignment="Top"
                        AutomationProperties.Name="{Binding AutomationName}"
                        IsChecked="{Binding IsChecked, Mode=TwoWay}"
                        Visibility="{Binding IsSelectable, Converter={StaticResource BoolToVisibility}}" />
                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                        <TextBlock x:Name="RowTitle" Style="{StaticResource BodyStrong}" Text="{Binding Title}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,2,0,0" Style="{StaticResource Secondary}" Text="{Binding Reason}" TextWrapping="Wrap" />
                        <TextBlock
                            Margin="0,4,0,0"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource Caption}"
                            Text="{Binding Measured}"
                            TextWrapping="Wrap"
                            Visibility="{Binding HasMeasured, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock
                            Margin="0,4,0,0"
                            Foreground="{DynamicResource SystemFillColorCautionBrush}"
                            Style="{StaticResource Caption}"
                            Text="{Binding Note}"
                            TextWrapping="Wrap"
                            Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}" />
                        <!--  Wrapped, never cut: the source of a measured number is often the long part (UI review M5).  -->
                        <TextBlock
                            Margin="0,4,0,0"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource Caption}"
                            Text="{Binding SourceLine}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <c:BadgePill
                        Grid.Column="2"
                        VerticalAlignment="Top"
                        AutomationProperties.Name="{Binding TagAutomationName}"
                        Text="{Binding Tag}"
                        Tone="{Binding Tone}" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <!--  Greyed with a readable brush, never opacity, so the measured number and source keep their contrast (UI review M2).  -->
                <DataTrigger Binding="{Binding IsGreyed}" Value="True">
                    <Setter TargetName="RowTitle" Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                    <Setter TargetName="RowBorder" Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Toolbar  -->
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Style="{StaticResource SectionTitle}" Text="Game settings" />
                <TextBlock
                    Style="{StaticResource Secondary}"
                    Text="Pick a game to see PC Tidy's recommendations, each with its evidence and, where there is one, the measured number. Games with a strict anti-cheat get advice only."
                    TextWrapping="Wrap" />
            </StackPanel>
            <ui:Button
                x:Name="ScanButton"
                Grid.Column="1"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                Appearance="Secondary"
                AutomationProperties.Name="Scan your games"
                Click="OnScanClick"
                Content="Scan"
                Icon="{ui:SymbolIcon ArrowClockwise24}" />
        </Grid>

        <StackPanel x:Name="NotesPanel" Grid.Row="1" />

        <!--  Scanning  -->
        <Border x:Name="ScanningState" Grid.Row="2" Padding="24,20" VerticalAlignment="Top" Style="{StaticResource TidyCard}" Visibility="Collapsed">
            <DockPanel>
                <ui:ProgressRing Width="36" Height="36" Margin="0,0,16,0" IsIndeterminate="True" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Looking…" />
                    <TextBlock x:Name="ScanMessage" Style="{StaticResource SecondaryTrim}" />
                    <TextBlock Margin="0,6,0,0" Style="{StaticResource Caption}" Text="Scanning only looks. Nothing is changed until you confirm." />
                </StackPanel>
            </DockPanel>
        </Border>

        <!--  Master / detail  -->
        <Grid x:Name="MasterDetail" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="220" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <!--  Left: the game list  -->
            <Border Padding="12" Style="{StaticResource TidyCard}">
                <DockPanel>
                    <ui:TextBox
                        x:Name="SearchBox"
                        AutomationProperties.HelpText="Type part of a game's name. Press Down to move to the list."
                        AutomationProperties.Name="Search games"
                        DockPanel.Dock="Top"
                        Icon="{ui:SymbolIcon Search24}"
                        PlaceholderText="Search games"
                        PreviewKeyDown="OnSearchKeyDown"
                        TextChanged="OnSearchChanged" />
                    <c:Segmented
                        x:Name="FilterPicker"
                        Margin="0,8,0,8"
                        DockPanel.Dock="Top"
                        Items="All|Installed|Not tuned"
                        Label="Show games" />
                    <TextBlock
                        x:Name="NoMatch"
                        Margin="4,8"
                        DockPanel.Dock="Top"
                        Style="{StaticResource Caption}"
                        Text="No games match."
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />
                    <ListBox
                        x:Name="GameListBox"
                        AutomationProperties.HelpText="Arrow keys move between games. The selected game's settings show on the right."
                        AutomationProperties.Name="Games"
                        ItemContainerStyle="{StaticResource TidyRowContainer}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        SelectionChanged="OnGameSelected"
                        Style="{StaticResource TidyFlatList}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:GameListRow}">
                                <Grid Margin="4,6" AutomationProperties.Name="{Binding AutomationName}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource Body}"
                                        Text="{Binding Name}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip="{Binding Name}" />
                                    <c:BadgePill Grid.Column="1" Text="{Binding Status}" Tone="{Binding Tone}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!--  Right: the selected game's recipe  -->
            <Border Grid.Column="2" Padding="16,14" Style="{StaticResource TidyCard}">
                <Grid>
                    <c:EmptyState
                        x:Name="NoSelection"
                        Icon="Games24"
                        Message="Pick a game on the left to see its recommended settings."
                        Title="No game selected" />
                    <Grid x:Name="DetailPane" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <DockPanel>
                                <c:BadgePill x:Name="DetailStatus" Margin="10,2,0,0" DockPanel.Dock="Right" />
                                <TextBlock x:Name="DetailTitle" Style="{StaticResource CardTitle}" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                            <TextBlock x:Name="DetailSummary" Margin="0,2,0,0" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                            <TextBlock x:Name="DetailWhy" Margin="0,4,0,0" Style="{StaticResource Secondary}" TextWrapping="Wrap" />
                        </StackPanel>

                        <!--  Reset · Clear shader cache · Preview  -->
                        <StackPanel Grid.Row="1" Margin="0,10,0,10">
                            <WrapPanel>
                                <ui:Button
                                    x:Name="ResetButton"
                                    flow:RunGate.DisableWhileBusy="True"
                                    Margin="0,0,8,6"
                                    Appearance="Secondary"
                                    AutomationProperties.Name="Reset to my backup: put this game's settings back the way they were before PC Tidy changed them"
                                    Click="OnReset"
                                    Content="Reset to my backup"
                                    Icon="{ui:SymbolIcon ArrowUndo24}" />
                                <CheckBox
                                    x:Name="ShaderCacheCheck"
                                    Margin="0,0,8,6"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="Clear shader cache. Off by default. The game stutters while shaders rebuild, which can take 1 to 2 hours."
                                    Checked="OnSelectionChanged"
                                    Content="Clear shader cache"
                                    IsChecked="False"
                                    Unchecked="OnSelectionChanged" />
                                <ui:Button
                                    x:Name="PreviewButton"
                                    flow:RunGate.DisableWhileBusy="True"
                                    Margin="0,0,8,6"
                                    Appearance="Primary"
                                    AutomationProperties.Name="Preview the ticked changes"
                                    Click="OnPreview"
                                    Content="Preview"
                                    Icon="{ui:SymbolIcon Eye24}" />
                            </WrapPanel>
                            <TextBlock x:Name="ResetNote" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                            <TextBlock
                                x:Name="ShaderWarning"
                                Margin="0,2,0,0"
                                Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                Style="{StaticResource Caption}"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <ScrollViewer
                            x:Name="DetailScroll"
                            Grid.Row="2"
                            Focusable="False"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,6,0">
                                <TextBlock Margin="0,0,0,6" Style="{StaticResource CaptionStrong}" Text="RECOMMENDED SETTINGS" />
                                <TextBlock
                                    x:Name="NoSettings"
                                    Margin="0,0,0,8"
                                    Style="{StaticResource Caption}"
                                    Text="No settings to show for this game."
                                    Visibility="Collapsed" />
                                <ItemsControl
                                    x:Name="SettingsList"
                                    AutomationProperties.Name="Recommended settings"
                                    Focusable="False"
                                    ItemTemplate="{StaticResource RecipeRowTemplate}" />
                                <StackPanel x:Name="PlaceboSection">
                                    <TextBlock Margin="0,8,0,2" Style="{StaticResource CaptionStrong}" Text="DOESN'T HELP (MEASURED)" />
                                    <TextBlock
                                        Margin="0,0,0,6"
                                        Style="{StaticResource Caption}"
                                        Text="Tweaks that guides still suggest. Tests found no real gain, so PC Tidy never applies them."
                                        TextWrapping="Wrap" />
                                    <ItemsControl
                                        x:Name="PlaceboList"
                                        AutomationProperties.Name="Doesn't help (measured)"
                                        Focusable="False"
                                        ItemTemplate="{StaticResource RecipeRowTemplate}" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
